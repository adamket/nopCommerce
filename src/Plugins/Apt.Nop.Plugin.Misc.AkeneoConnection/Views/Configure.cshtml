@using Apt.Nop.Plugin.Misc.AkeneoConnection
@model AkeneoConfigurationModel
@{
    Layout = "_AdminLayout";
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddCssFileParts($"{AkeneoConstants.PathToPlugin}/Content/StyleSheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.Configuration");
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<div class="content-header clearfix">
    <h1 class="float-left">
        Configure - Akeneo Connection
      @*   <small>
            <i class="fas fa-arrow-circle-left"></i>
            <a href="/Admin/Plugin/List">back to plugin list</a>
        </small> *@
    </h1>
    <div class="float-right">
        <button type="submit" name="save" class="btn btn-primary">
            <i class="far fa-save"></i>
            @T("Admin.Common.Save")
        </button>
    </div>
</div>


<section class="content">
   
        
   


    <form asp-controller="AkeneoConnectionConfiguration" asp-action="Configure" method="post">
        <div class="cards-group">
            <div class="card card-default">
                <div class="card-header">

                    <div class="card-title float-left">
                        <i class="fas fa-plug"></i> Api Access
                    
                    </div>
                    <button type="button" id="test-connection" class="btn btn-success float-right btn-sm">
                        Test Connection
                    </button>
                </div>

                <div class="card-body">

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="AkeneoConnectionClientId_OverrideForStore" asp-input="AkeneoConnectionClientId" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="AkeneoConnectionClientId" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AkeneoConnectionClientId" />
                            <span asp-validation-for="AkeneoConnectionClientId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="AkeneoConnectionClientSecret_OverrideForStore" asp-input="AkeneoConnectionClientSecret" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="AkeneoConnectionClientSecret" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AkeneoConnectionClientSecret" />
                            <span asp-validation-for="AkeneoConnectionClientSecret"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="AkeneoConnectionBaseUrl_OverrideForStore" asp-input="AkeneoConnectionBaseUrl" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="AkeneoConnectionBaseUrl" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AkeneoConnectionBaseUrl" />
                            <span asp-validation-for="AkeneoConnectionBaseUrl"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="AkeneoConnectionUsername_OverrideForStore" asp-input="AkeneoConnectionUsername" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="AkeneoConnectionUsername" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AkeneoConnectionUsername" />
                            <span asp-validation-for="AkeneoConnectionUsername"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="AkeneoConnectionPassword_OverrideForStore" asp-input="AkeneoConnectionPassword" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="AkeneoConnectionPassword" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AkeneoConnectionPassword" />
                            <span asp-validation-for="AkeneoConnectionPassword"></span>
                        </div>
                    </div>

                </div>





            </div>

            @* Sync Context stays server-rendered so the nop tag helpers / store-scope keep working. *@

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-sliders-h"></i>
                        Sync Context
                    </div>
                </div>

                <div class="card-body">
                    <p>Set the default Akeneo channel, locale, and currency used when resolving scoped values.</p>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="DefaultChannelCode_OverrideForStore" asp-input="DefaultChannelCode" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="DefaultChannelCode" />
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="DefaultChannelCode" asp-items="Model.AvailableChannelCodes" />
                            <span asp-validation-for="DefaultChannelCode"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="DefaultLocaleCode_OverrideForStore" asp-input="DefaultLocaleCode" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="DefaultLocaleCode" />
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="DefaultLocaleCode" asp-items="Model.AvailableLocaleCodes" />
                            <span asp-validation-for="DefaultLocaleCode"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="DefaultCurrencyCode_OverrideForStore" asp-input="DefaultCurrencyCode" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="DefaultCurrencyCode" />
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="DefaultCurrencyCode" asp-items="Model.AvailableCurrencyCodes" />
                            <span asp-validation-for="DefaultCurrencyCode"></span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </form>






    <div class="modal fade" id="test-connection-modal" tabindex="-1" role="dialog"
         aria-labelledby="test-connection-modal-title" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="test-connection-modal-title">
                        <i class="modal-icon mr-2"></i>
                        <span class="modal-title-text"></span>
                    </h4>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <span class="modal-message"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>



</section>
<script>
    $(function () {
        var $modal = $('#test-connection-modal');

        $('#test-connection').on('click', function () {
            var button = this;

            if (button.loading()) {
                return;
            }

            button.loading(true);

            $.ajax({
                type: 'POST',
                url: '@Url.Action("TestConnection", "AkeneoApi")',
                data: addAntiForgeryToken({
                    apiCredentials: {
                        username: $('#@(Html.IdFor(q => q.AkeneoConnectionUsername))').val(),
                        password: $('#@(Html.IdFor(q => q.AkeneoConnectionPassword))').val(),
                        baseUrl: $('#@(Html.IdFor(q => q.AkeneoConnectionBaseUrl))').val(),
                        clientId: $('#@(Html.IdFor(q => q.AkeneoConnectionClientId))').val(),
                        clientSecret: $('#@(Html.IdFor(q => q.AkeneoConnectionClientSecret))').val()
                    }
                })
            }).done(function (response) {
                if (response && response.success) {
                    showResult(true, response.message || 'Akeneo connection successful with entered credentials.');
                } else {
                    showResult(false, response && response.message
                        ? response.message
                        : 'Akeneo connection failed.');
                }
            }).fail(function (xhr) {
                var message = 'Akeneo connection request failed.';

                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    message = xhr.responseText;
                }

                showResult(false, message);
            }).always(function () {
                button.loading(false);
            });
        });

        function showResult(isSuccess, message) {
            $modal.find('.modal-header')
                .removeClass('bg-success bg-danger')
                .addClass(isSuccess ? 'bg-success' : 'bg-danger')
                .addClass('text-white');

            $modal.find('.modal-icon')
                .attr('class', 'modal-icon mr-2 fas ' + (isSuccess ? 'fa-check-circle' : 'fa-times-circle'));

            $modal.find('.modal-title-text')
                .text(isSuccess ? 'Connection Successful' : 'Connection Failed');

            $modal.find('.modal-message').text(message);

            $modal.modal('show');
        }
    });
</script>
