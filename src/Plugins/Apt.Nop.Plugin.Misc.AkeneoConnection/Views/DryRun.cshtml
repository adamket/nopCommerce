@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoProductMappingPreviewModel
@using Apt.Nop.Plugin.Misc.AkeneoConnection

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Akeneo product dry run";
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.DryRun");
}

<div class="akeneo-connection">
    <form id="akeneo-dry-run-form" asp-controller="AkeneoSync" asp-action="DryRun" method="post">
        @Html.AntiForgeryToken()

        <div class="content-header clearfix">
            <div class="float-left">
                <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
                <h1 class="m-0">Product dry run</h1>
                <div class="akeneo-dim mt-1">Preview how saved Akeneo mappings will apply to an Akeneo product or product model without creating or updating nopCommerce product data.</div>
            </div>
            <div class="float-right">
                <button type="submit" id="akeneo-preview-button" class="btn btn-primary">
                    <i class="fas fa-search"></i>
                    Preview
                </button>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">

                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title">
                            <i class="fas fa-barcode"></i>
                            Product / Product Model Lookup
                        </div>
                    </div>

                    <div class="card-body">
                      @*   <p>
                            Enter an Akeneo identifier/SKU to preview how the saved attribute mappings would apply.
                            No nopCommerce product data will be created or updated.
                        </p> *@

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="AkeneoIdentifier">Akeneo Identifier/SKU or Product Model Code</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="AkeneoIdentifier" class="form-control" />
                                <span asp-validation-for="AkeneoIdentifier"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.HasSearched)
                {
                    <div class="card card-default">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="fas fa-clipboard-list"></i>
                                Preview Summary
                            </div>
                        </div>

                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-3">Akeneo source found</dt>
                                <dd class="col-sm-9">
                                    @if (Model.AkeneoProductFound)
                                    {
                                        <span class="badge badge-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">No</span>
                                    }
                                </dd>

                                @if (Model.AkeneoProductFound)
                                {
                                    <dt class="col-sm-3">Akeneo entity type</dt>
                                    <dd class="col-sm-9">
                                        <span class="akeneo-summary-target-type">@Model.AkeneoEntityTypeName</span>
                                    </dd>
                                }

                                <dt class="col-sm-3">nopCommerce product found</dt>
                                <dd class="col-sm-9">
                                    @if (Model.NopProductFound)
                                    {
                                        <span class="badge badge-success">Yes</span>
                                        <span class="akeneo-code ml-2">#@Model.NopProductId</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">No</span>
                                    }
                                </dd>

                                <dt class="col-sm-3">Action</dt>
                                <dd class="col-sm-9 mb-0">
                                    @if (!string.IsNullOrWhiteSpace(Model.Action))
                                    {
                                        <span class="akeneo-summary-target-type">@Model.Action</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No action available.</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (Model.Errors?.Any() == true)
                    {
                        <div class="alert alert-danger akeneo-row-errors">
                            <strong>Errors</strong>
                            <ul class="mb-0">
                                @foreach (var error in Model.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                   @*  @if (Model.Warnings?.Any() == true)
                    {
                        <div class="alert alert-warning">
                            <strong>Warnings</strong>
                            <ul class="mb-0">
                                @foreach (var warning in Model.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    } *@

                    @if (Model.AkeneoProductFound)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-file-import"></i>
                                    One-Time Import
                                </div>
                            </div>

                            <div class="card-body">
                                <p>
                                    This will create or update the nopCommerce product using the mappings shown in this dry run.
                                    @if (Model.IsProductModel)
                                    {
                                        <span>Only the resolved parent product model is synchronized; associated child products are not individually reimported.</span>
                                    }
                                </p>

                                <dl class="row">
                                    <dt class="col-sm-3">@(Model.IsProductModel ? "Akeneo product model code" : "Akeneo UUID")</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.IsProductModel && !string.IsNullOrWhiteSpace(Model.AkeneoProductModelCode))
                                        {
                                            <span class="akeneo-code">@Model.AkeneoProductModelCode</span>
                                        }
                                        else if (!Model.IsProductModel && !string.IsNullOrWhiteSpace(Model.AkeneoProductUuid))
                                        {
                                            <span class="akeneo-code">@Model.AkeneoProductUuid</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Missing source key. Import cannot run.</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3">Locale / Channel / Currency</dt>
                                    <dd class="col-sm-9">
                                        <span class="akeneo-code">@Model.Locale</span>
                                        <span class="mx-1">/</span>
                                        <span class="akeneo-code">@Model.Channel</span>
                                        <span class="mx-1">/</span>
                                        <span class="akeneo-code">@Model.Currency</span>
                                    </dd>
                                </dl>

                                <button type="button"
                                        id="akeneo-import-product"
                                        class="btn btn-success"
                                        disabled="@(!Model.CanImport)"
                                        data-import-url="@Url.Action("ImportProduct", "AkeneoSync", new { area = "admin" })"
                                        data-uuid="@Model.AkeneoProductUuid"
                                        data-product-model-code="@Model.AkeneoProductModelCode"
                                        data-entity-type-id="@Model.AkeneoEntityTypeId"
                                        data-locale="@Model.Locale"
                                        data-channel="@Model.Channel"
                                        data-currency="@Model.Currency">
                                    <i class="fas fa-file-import"></i>
                                    Import @(Model.IsProductModel ? "Product Model" : "Product")
                                </button>

                                @if (!Model.CanImport)
                                {
                                    <div class="text-muted mt-2">
                                        Import is disabled until the Akeneo source is found, its UUID or product model code is available, and the preview has no errors.
                                    </div>
                                }

                                <div id="akeneo-import-result" class="alert d-none mt-3"></div>
                            </div>
                        </div>
                    }

                    @if (Model.ProductFields?.Any() == true)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-box"></i>
                                    Product Fields
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>nopCommerce Field</th>
                                                <th>Akeneo Attribute</th>
                                                <th>Value</th>
                                                <th>Required</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var field in Model.ProductFields)
                                            {
                                                <tr>
                                                    <td class="akeneo-summary-target-type">@field.TargetKey</td>
                                                    <td><span class="akeneo-code">@field.AkeneoAttributeCode</span></td>
                                                    <td>
                                                        @if (field.HasValue)
                                                        {
                                                            @field.Value
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No value</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="badge badge-warning">Required</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Optional</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.SpecificationAttributes?.Any() == true)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-list-ul"></i>
                                    Specification Attributes
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>nopCommerce Specification Attribute</th>
                                                <th>Akeneo Attribute</th>
                                                <th>Value</th>
                                                <th>Required</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var sattribute in Model.SpecificationAttributes)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="akeneo-summary-target-type">@sattribute.NopAttributeName</span>
                                                        @if (sattribute.NopAttributeId.HasValue)
                                                        {
                                                            <span class="akeneo-code ml-1">#@sattribute.NopAttributeId</span>
                                                        }
                                                    </td>
                                                    <td><span class="akeneo-code">@sattribute.AkeneoAttributeCode</span></td>
                                                    <td>
                                                        @if (sattribute.HasValue)
                                                        {
                                                            @sattribute.Value
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No value</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (sattribute.IsRequired)
                                                        {
                                                            <span class="badge badge-warning">Required</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Optional</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ProductAttributes?.Any() == true)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-tags"></i>
                                    Product Attributes
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>nopCommerce Product Attribute</th>
                                                <th>Akeneo Attribute</th>
                                                <th>Value</th>
                                                <th>Required</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var pattribute in Model.ProductAttributes)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="akeneo-summary-target-type">@pattribute.NopAttributeName</span>
                                                        @if (pattribute.NopAttributeId.HasValue)
                                                        {
                                                            <span class="akeneo-code ml-1">#@pattribute.NopAttributeId</span>
                                                        }
                                                    </td>
                                                    <td><span class="akeneo-code">@pattribute.AkeneoAttributeCode</span></td>
                                                    <td>
                                                        @if (pattribute.HasValue)
                                                        {
                                                            @pattribute.Value
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No value</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (pattribute.IsRequired)
                                                        {
                                                            <span class="badge badge-warning">Required</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Optional</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.SeoFields?.Any() == true)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-globe"></i>
                                    SEO Fields
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>SEO Field</th>
                                                <th>Akeneo Attribute</th>
                                                <th>Value</th>
                                                <th>Required</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var field in Model.SeoFields)
                                            {
                                                <tr>
                                                    <td class="akeneo-summary-target-type">@field.TargetKey</td>
                                                    <td><span class="akeneo-code">@field.AkeneoAttributeCode</span></td>
                                                    <td>
                                                        @if (field.HasValue)
                                                        {
                                                            @field.Value
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No value</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="badge badge-warning">Required</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Optional</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.CustomProperties?.Any() == true)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-puzzle-piece"></i>
                                    Custom Properties
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Custom Key</th>
                                                <th>Akeneo Attribute</th>
                                                <th>Value</th>
                                                <th>Required</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var field in Model.CustomProperties)
                                            {
                                                <tr>
                                                    <td class="akeneo-summary-target-type">@field.TargetKey</td>
                                                    <td><span class="akeneo-code">@field.AkeneoAttributeCode</span></td>
                                                    <td>
                                                        @if (field.HasValue)
                                                        {
                                                            @field.Value
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">No value</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="badge badge-warning">Required</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Optional</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    </form>
</div>


<div class="modal fade"
     id="akeneo-confirm-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="akeneo-confirm-modal-title"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="akeneo-confirm-modal-title" class="modal-title">Confirm action</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="akeneo-confirm-modal-message" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" id="akeneo-confirm-modal-confirm" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>



<script asp-location="Footer">
    $(function () {
        var $previewForm = $('#akeneo-dry-run-form');
        var $previewButton = $('#akeneo-preview-button');
        var $button = $('#akeneo-import-product');
        var $result = $('#akeneo-import-result');

        var confirmModal = $('#akeneo-confirm-modal');
        var confirmModalTitle = $('#akeneo-confirm-modal-title');
        var confirmModalMessage = $('#akeneo-confirm-modal-message');
        var confirmModalConfirmButton = $('#akeneo-confirm-modal-confirm');

        function setPreviewButtonLoading(isLoading) {
            if (isLoading) {
                if (!$previewButton.data('original-html')) {
                    $previewButton.data('original-html', $previewButton.html());
                }

                $previewButton
                    .prop('disabled', true)
                    .attr('aria-busy', 'true')
                    .html('<span class="akeneo-button-spinner" aria-hidden="true"></span>Previewing...');
            } else {
                var originalHtml = $previewButton.data('original-html');

                if (originalHtml) {
                    $previewButton.html(originalHtml);
                }

                $previewButton
                    .prop('disabled', false)
                    .removeAttr('aria-busy');
            }
        }

        $previewForm.on('submit', function () {
            if ($previewButton.prop('disabled')) {
                return false;
            }

            if (typeof $previewForm.valid === 'function' && !$previewForm.valid()) {
                return false;
            }

            setPreviewButtonLoading(true);
        });

        $(window).on('pageshow', function () {
            setPreviewButtonLoading(false);
        });

        function escapeHtml(value) {
            return $('<div/>').text(value == null ? '' : value).html();
        }

        function renderList(title, items) {
            if (!items || !items.length) {
                return '';
            }

            var html = '<strong>' + escapeHtml(title) + '</strong><ul class="mb-0">';

            $.each(items, function (_, item) {
                html += '<li>' + escapeHtml(item) + '</li>';
            });

            html += '</ul>';

            return html;
        }

        function showResult(success, html) {
            $result
                .removeClass('d-none alert-success alert-danger')
                .addClass(success ? 'alert-success' : 'alert-danger')
                .html(html);
        }

        function showConfirmModal(options) {
            confirmModalTitle.text(options.title || 'Confirm action');
            confirmModalMessage.text(options.message || 'Are you sure?');

            confirmModalConfirmButton
                .removeClass('btn-primary btn-success btn-danger btn-warning')
                .addClass(options.confirmButtonClass || 'btn-primary')
                .html(options.confirmButtonText || 'Confirm')
                .off('click')
                .on('click', function () {
                    confirmModal.modal('hide');
                    if (typeof options.onConfirm === 'function') {
                        options.onConfirm();
                    }
                });

            confirmModal.modal('show');
        }

        function runImport() {
            var originalHtml = $button.html();

            $button
                .prop('disabled', true)
                .html('<span class="akeneo-button-spinner" aria-hidden="true"></span>Importing...');

            $result
                .addClass('d-none')
                .removeClass('alert-success alert-danger')
                .empty();

            $.ajax({
                type: 'POST',
                url: $button.data('import-url'),
                data: addAntiForgeryToken({
                    uuid: $button.data('uuid'),
                    productModelCode: $button.data('product-model-code'),
                    akeneoEntityTypeId: $button.data('entity-type-id'),
                    locale: $button.data('locale'),
                    channel: $button.data('channel'),
                    currency: $button.data('currency')
                })
            })
            .done(function (response) {
                var success = response && response.success === true;

                var html = '';

                if (success) {
                    html += '<strong>Import completed.</strong>';
                } else {
                    html += '<strong>Import failed.</strong>';
                }

                html += '<div class="mt-2">';
                html += '<div><strong>Action:</strong> ' + escapeHtml(response.action) + '</div>';

                if (response.productId) {
                    html += '<div><strong>nopCommerce Product ID:</strong> ' + escapeHtml(response.productId) + '</div>';
                }

                if (response.akeneoEntityType) {
                    html += '<div><strong>Akeneo Entity Type:</strong> ' + escapeHtml(response.akeneoEntityType) + '</div>';
                }

                if (response.akeneoIdentifier) {
                    html += '<div><strong>Akeneo Source Key:</strong> ' + escapeHtml(response.akeneoIdentifier) + '</div>';
                }

                if (response.syncRunRecordId) {
                    html += '<div><strong>Sync Run ID:</strong> <span class="akeneo-code">' + escapeHtml(response.syncRunRecordId) + '</span></div>';
                }

                html += '</div>';

                html += renderList('Messages', response.messages);
                html += renderList('Warnings', response.warnings);
                html += renderList('Errors', response.errors);

                showResult(success, html);

                if (success) {
                    $button.html('<i class="fas fa-check"></i> Imported');
                } else {
                    $button
                        .prop('disabled', false)
                        .html(originalHtml);
                }
            })
            .fail(function (xhr) {
                var message = 'The import request failed.';

                if (xhr.responseJSON && xhr.responseJSON.errors && xhr.responseJSON.errors.length) {
                    message = xhr.responseJSON.errors.join(' ');
                } else if (xhr.responseText) {
                    message = xhr.responseText;
                }

                showResult(false, '<strong>Import failed.</strong><div class="mt-2">' + escapeHtml(message) + '</div>');

                $button
                    .prop('disabled', false)
                    .html(originalHtml);
            });
        }

        $button.on('click', function () {
            if ($button.prop('disabled')) {
                return;
            }

            showConfirmModal({
                title: 'Import Akeneo Source',
                message: 'Import this Akeneo product or product model into nopCommerce now?',
                confirmButtonText: '<i class="fas fa-download"></i> Import',
                confirmButtonClass: 'btn-primary',
                onConfirm: runImport
            });
        });
    });
</script>