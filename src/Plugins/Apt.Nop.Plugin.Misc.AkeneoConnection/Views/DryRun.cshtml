@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoProductMappingPreviewModel
@using Apt.Nop.Plugin.Misc.AkeneoConnection
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Models

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Akeneo product dry run";
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.DryRun");

    var operationGroups = (Model.Operations ?? new List<AkeneoDryRunOperationPreviewModel>())
        .GroupBy(operation => operation.Area)
        .ToList();
}

<div class="akeneo-connection">
    <form id="akeneo-dry-run-form" asp-controller="AkeneoSync" asp-action="DryRun" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Locale" type="hidden" />
        <input asp-for="Channel" type="hidden" />
        <input asp-for="Currency" type="hidden" />

        <div class="content-header clearfix">
            <div class="float-left">
                <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
                <h1 class="m-0">Product dry run</h1>
                <div class="akeneo-dim mt-1">
                    Build a read-only change plan using the same mapping preparation path as the real synchronization pipeline.
                </div>
            </div>
            <div class="float-right">
                <button type="submit"
                        id="akeneo-preview-button"
                        class="btn btn-primary"
                        @(Model.SyncProfileId.HasValue ? null : "disabled")>
                    <i class="fas fa-search"></i>
                    Preview
                </button>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title">
                            <i class="fas fa-barcode"></i>
                            Product / Product Model Lookup
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3 text-right">
                                <label asp-for="AkeneoIdentifier" class="control-label">
                                    Akeneo identifier/SKU or product model code
                                </label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="AkeneoIdentifier" class="form-control" />
                                <span asp-validation-for="AkeneoIdentifier"></span>
                            </div>
                        </div>

                        <div class="form-group row mb-0">
                            <div class="col-md-3 text-right">
                                <span class="control-label">Saved sync context</span>
                            </div>
                            <div class="col-md-9">
                                @if (Model.SyncProfileId.HasValue)
                                {
                                    <span class="akeneo-summary-target-type">
                                        @(!string.IsNullOrWhiteSpace(Model.SyncProfileName)
                                            ? Model.SyncProfileName
                                            : $"Profile #{Model.SyncProfileId}")
                                    </span>
                                    <span class="akeneo-code ml-2">@Model.Locale / @Model.Channel / @Model.Currency</span>
                                    <div class="form-text text-muted">
                                        Dry Run uses the default profile's write, missing-value, and collection synchronization policies.
                                    </div>
                                }
                                else
                                {
                                    <span class="text-danger">No default sync profile is configured.</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!Model.HasSearched && Model.Warnings?.Any() == true)
                {
                    <div class="alert alert-warning">
                        <strong>Configuration required</strong>
                        <ul class="mb-0">
                            @foreach (var warning in Model.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.HasSearched)
                {
                    <div class="card card-default">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="fas fa-clipboard-list"></i>
                                Preview Summary
                            </div>
                        </div>

                        <div class="card-body">
                            <dl class="row mb-3">
                                <dt class="col-sm-3">Akeneo source</dt>
                                <dd class="col-sm-9">
                                    @if (Model.AkeneoProductFound)
                                    {
                                        <span class="badge badge-success">Found</span>
                                        <span class="akeneo-summary-target-type ml-2">@Model.AkeneoEntityTypeName</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Not found</span>
                                    }
                                </dd>

                                <dt class="col-sm-3">nopCommerce destination</dt>
                                <dd class="col-sm-9">
                                    @if (Model.NopProductFound)
                                    {
                                        <span class="badge badge-success">Existing product</span>
                                        <span class="akeneo-code ml-2">#@Model.NopProductId</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">New product</span>
                                    }
                                </dd>

                                @if (!string.IsNullOrWhiteSpace(Model.HierarchyDecision))
                                {
                                    <dt class="col-sm-3">Hierarchy / representation</dt>
                                    <dd class="col-sm-9">
                                        <span class="@(Model.HierarchyRequiresReview ? "text-warning" : "akeneo-summary-target-type")">
                                            @Model.HierarchyDecision
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(Model.ParentProductDecision))
                                        {
                                            <div class="form-text text-muted">@Model.ParentProductDecision</div>
                                        }
                                    </dd>
                                }

                                <dt class="col-sm-3">Expected result</dt>
                                <dd class="col-sm-9 mb-0">
                                    @if (!string.IsNullOrWhiteSpace(Model.Action))
                                    {
                                        <span class="akeneo-summary-target-type">@Model.Action</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No result available.</span>
                                    }
                                </dd>
                            </dl>

                            @if (Model.AkeneoProductFound)
                            {
                                <div class="row">
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted">Planned changes</div>
                                            <div class="h4 mb-0">@Model.PlannedChangeCount</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted">No change</div>
                                            <div class="h4 mb-0">@Model.NoChangeCount</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted">Preserved / skipped</div>
                                            <div class="h4 mb-0">@Model.PreservedCount</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <div class="border rounded p-3 h-100">
                                            <div class="text-muted">Needs review</div>
                                            <div class="h4 mb-0">@Model.ReviewCount</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (Model.Errors?.Any() == true)
                    {
                        <div class="alert alert-danger akeneo-row-errors">
                            <strong>Errors</strong>
                            <ul class="mb-0">
                                @foreach (var error in Model.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.Warnings?.Any() == true)
                    {
                        <div class="alert alert-warning">
                            <strong>Warnings</strong>
                            <ul class="mb-0">
                                @foreach (var warning in Model.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.Messages?.Any() == true)
                    {
                        <div class="alert alert-info">
                            <strong>Preparation messages</strong>
                            <ul class="mb-0">
                                @foreach (var message in Model.Messages)
                                {
                                    <li>@message</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.CoverageNotes?.Any() == true)
                    {
                        <div class="alert alert-info">
                            <strong>Preview coverage</strong>
                            <ul class="mb-0">
                                @foreach (var note in Model.CoverageNotes)
                                {
                                    <li>@note</li>
                                }
                            </ul>
                        </div>
                    }

                    @foreach (var group in operationGroups)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-exchange-alt"></i>
                                    @group.Key
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 110px;">Action</th>
                                                <th>Destination</th>
                                                <th>Akeneo source</th>
                                                <th>Current</th>
                                                <th>Proposed</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var operation in group)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge @operation.BadgeClass">@operation.ChangeTypeName</span>
                                                    </td>
                                                    <td>
                                                        <span class="akeneo-summary-target-type">@operation.Target</span>
                                                        @if (operation.IsRequired)
                                                        {
                                                            <span class="badge badge-warning ml-1">Required</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(operation.AkeneoSource))
                                                        {
                                                            <span class="akeneo-code">@operation.AkeneoSource</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">System behavior</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(operation.CurrentValue))
                                                        {
                                                            <span class="text-break">@operation.CurrentValue</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Empty / absent</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(operation.ProposedValue))
                                                        {
                                                            <span class="text-break">@operation.ProposedValue</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Empty / absent</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(operation.Detail))
                                                        {
                                                            @operation.Detail
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">&mdash;</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.AkeneoProductFound)
                    {
                        <div class="card card-default">
                            <div class="card-header">
                                <div class="card-title">
                                    <i class="fas fa-file-import"></i>
                                    One-Time Import
                                </div>
                            </div>

                            <div class="card-body">
                                <p>
                                    Import rebuilds the plan against the current destination state and then performs the actual synchronization.
                                    @if (Model.IsProductModel)
                                    {
                                        <span>Only the resolved parent product model is synchronized. Descendant products are not individually reimported.</span>
                                    }
                                </p>

                                <dl class="row">
                                    <dt class="col-sm-3">@(Model.IsProductModel ? "Akeneo product model code" : "Akeneo UUID")</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.IsProductModel && !string.IsNullOrWhiteSpace(Model.AkeneoProductModelCode))
                                        {
                                            <span class="akeneo-code">@Model.AkeneoProductModelCode</span>
                                        }
                                        else if (!Model.IsProductModel && !string.IsNullOrWhiteSpace(Model.AkeneoProductUuid))
                                        {
                                            <span class="akeneo-code">@Model.AkeneoProductUuid</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Missing source key. Import cannot run.</span>
                                        }
                                    </dd>
                                </dl>

                                <button type="button"
                                        id="akeneo-import-product"
                                        class="btn btn-success"
                                        @(Model.CanImport ? null : "disabled")
                                        data-import-url="@Url.Action("ImportProduct", "AkeneoSync", new { area = "admin" })"
                                        data-uuid="@Model.AkeneoProductUuid"
                                        data-product-model-code="@Model.AkeneoProductModelCode"
                                        data-entity-type-id="@Model.AkeneoEntityTypeId"
                                        data-locale="@Model.Locale"
                                        data-channel="@Model.Channel"
                                        data-currency="@Model.Currency"
                                        data-change-count="@Model.PlannedChangeCount">
                                    <i class="fas fa-file-import"></i>
                                    Import @(Model.IsProductModel ? "Product Model" : "Product")
                                </button>

                                @if (!Model.CanImport)
                                {
                                    <div class="text-muted mt-2">
                                        @if (!string.IsNullOrWhiteSpace(Model.ImportBlockReason))
                                        {
                                            @Model.ImportBlockReason
                                        }
                                        else
                                        {
                                            <span>Import is disabled until the source is resolved and the preview has no blocking errors.</span>
                                        }
                                    </div>
                                }

                                <div id="akeneo-import-result" class="alert d-none mt-3"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    </form>
</div>

<div class="modal fade"
     id="akeneo-confirm-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="akeneo-confirm-modal-title"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="akeneo-confirm-modal-title" class="modal-title">Confirm action</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="akeneo-confirm-modal-message" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" id="akeneo-confirm-modal-confirm" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script asp-location="Footer">
    $(function () {
        var $previewForm = $('#akeneo-dry-run-form');
        var $previewButton = $('#akeneo-preview-button');
        var $button = $('#akeneo-import-product');
        var $result = $('#akeneo-import-result');

        var confirmModal = $('#akeneo-confirm-modal');
        var confirmModalTitle = $('#akeneo-confirm-modal-title');
        var confirmModalMessage = $('#akeneo-confirm-modal-message');
        var confirmModalConfirmButton = $('#akeneo-confirm-modal-confirm');

        function setPreviewButtonLoading(isLoading) {
            if (isLoading) {
                if (!$previewButton.data('original-html')) {
                    $previewButton.data('original-html', $previewButton.html());
                }

                $previewButton
                    .prop('disabled', true)
                    .attr('aria-busy', 'true')
                    .html('<span class="akeneo-button-spinner" aria-hidden="true"></span>Previewing...');
            } else {
                var originalHtml = $previewButton.data('original-html');

                if (originalHtml) {
                    $previewButton.html(originalHtml);
                }

                $previewButton
                    .prop('disabled', false)
                    .removeAttr('aria-busy');
            }
        }

        $previewForm.on('submit', function () {
            if ($previewButton.prop('disabled')) {
                return false;
            }

            if (typeof $previewForm.valid === 'function' && !$previewForm.valid()) {
                return false;
            }

            setPreviewButtonLoading(true);
        });

        $(window).on('pageshow', function () {
            if ($previewButton.data('original-html')) {
                setPreviewButtonLoading(false);
            }
        });

        function escapeHtml(value) {
            return $('<div/>').text(value == null ? '' : value).html();
        }

        function renderList(title, items) {
            if (!items || !items.length) {
                return '';
            }

            var html = '<strong>' + escapeHtml(title) + '</strong><ul class="mb-0">';

            $.each(items, function (_, item) {
                html += '<li>' + escapeHtml(item) + '</li>';
            });

            html += '</ul>';
            return html;
        }

        function showResult(success, html) {
            $result
                .removeClass('d-none alert-success alert-danger')
                .addClass(success ? 'alert-success' : 'alert-danger')
                .html(html);
        }

        function showConfirmModal(options) {
            confirmModalTitle.text(options.title || 'Confirm action');
            confirmModalMessage.text(options.message || 'Are you sure?');

            confirmModalConfirmButton
                .removeClass('btn-primary btn-success btn-danger btn-warning')
                .addClass(options.confirmButtonClass || 'btn-primary')
                .html(options.confirmButtonText || 'Confirm')
                .off('click')
                .on('click', function () {
                    confirmModal.modal('hide');
                    if (typeof options.onConfirm === 'function') {
                        options.onConfirm();
                    }
                });

            confirmModal.modal('show');
        }

        function runImport() {
            var originalHtml = $button.html();

            $button
                .prop('disabled', true)
                .html('<span class="akeneo-button-spinner" aria-hidden="true"></span>Importing...');

            $result
                .addClass('d-none')
                .removeClass('alert-success alert-danger')
                .empty();

            $.ajax({
                type: 'POST',
                url: $button.data('import-url'),
                data: addAntiForgeryToken({
                    uuid: $button.data('uuid'),
                    productModelCode: $button.data('product-model-code'),
                    akeneoEntityTypeId: $button.data('entity-type-id'),
                    locale: $button.data('locale'),
                    channel: $button.data('channel'),
                    currency: $button.data('currency')
                })
            })
            .done(function (response) {
                var success = response && response.success === true;
                var html = success
                    ? '<strong>Import completed.</strong>'
                    : '<strong>Import failed.</strong>';

                html += '<div class="mt-2">';
                html += '<div><strong>Action:</strong> ' + escapeHtml(response.action) + '</div>';

                if (response.productId) {
                    html += '<div><strong>nopCommerce Product ID:</strong> ' + escapeHtml(response.productId) + '</div>';
                }

                if (response.akeneoEntityType) {
                    html += '<div><strong>Akeneo Entity Type:</strong> ' + escapeHtml(response.akeneoEntityType) + '</div>';
                }

                if (response.akeneoIdentifier) {
                    html += '<div><strong>Akeneo Source Key:</strong> ' + escapeHtml(response.akeneoIdentifier) + '</div>';
                }

                if (response.syncRunRecordId) {
                    html += '<div><strong>Sync Run ID:</strong> <span class="akeneo-code">' + escapeHtml(response.syncRunRecordId) + '</span></div>';
                }

                html += '</div>';
                html += renderList('Messages', response.messages);
                html += renderList('Warnings', response.warnings);
                html += renderList('Errors', response.errors);

                showResult(success, html);

                if (success) {
                    $button.html('<i class="fas fa-check"></i> Imported');
                } else {
                    $button.prop('disabled', false).html(originalHtml);
                }
            })
            .fail(function (xhr) {
                var message = 'The import request failed.';

                if (xhr.responseJSON && xhr.responseJSON.errors && xhr.responseJSON.errors.length) {
                    message = xhr.responseJSON.errors.join(' ');
                } else if (xhr.responseText) {
                    message = xhr.responseText;
                }

                showResult(false, '<strong>Import failed.</strong><div class="mt-2">' + escapeHtml(message) + '</div>');
                $button.prop('disabled', false).html(originalHtml);
            });
        }

        $button.on('click', function () {
            if ($button.prop('disabled')) {
                return;
            }

            var changeCount = parseInt($button.data('change-count'), 10) || 0;

            showConfirmModal({
                title: 'Import Akeneo Source',
                message: 'Import this Akeneo source now? The current preview contains ' + changeCount + ' planned change(s), and the plan will be recalculated before writing.',
                confirmButtonText: '<i class="fas fa-download"></i> Import',
                confirmButtonClass: 'btn-primary',
                onConfirm: runImport
            });
        });
    });
</script>
