<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Akeneo Catalog Binding";

    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-combobox.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.CatalogBinding");

    var appModel = new
    {
        scanUrl = Url.Action("Scan", "AkeneoCatalogBinding"),
        commitUrl = Url.Action("Commit", "AkeneoCatalogBinding"),
        productEditUrl = Url.Action("Edit", "Product", new { area = "Admin", id = 0 }),
        families = ViewBag.Families ?? new List<object>(),
        familyLoadError = (string)ViewBag.FamilyLoadError ?? string.Empty
    };
}

<div class="akeneo-connection">
    @Html.AntiForgeryToken()

    <div class="content-header clearfix">
        <div class="float-left">
            <div class="akeneo-eyebrow">Akeneo &harr; nopCommerce</div>
            <h1 class="m-0">Catalog Binding</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div id="akeneo-binding-app" class="akeneo-binding card card-default" v-cloak>
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-link"></i>
                        Bind existing nopCommerce products to Akeneo
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="akeneo-toolbar">
                        <div class="akeneo-toolbar-panel akeneo-toolbar-panel--scope">
                            <div class="akeneo-toolbar-panel-label">
                                <i class="fas fa-layer-group"></i>
                                <span>Scope</span>
                            </div>
                            <div class="akeneo-toolbar-panel-body">
                                <akeneo-combobox class="akeneo-binding-families"
                                                 v-model="familyCodes"
                                                 v-bind:options="families"
                                                 v-bind:disabled="!!busy"
                                                 placeholder="All families · type to filter"
                                                 add-placeholder="Add a family…"
                                                 item-name="family"
                                                 empty-text="No Akeneo families are available."></akeneo-combobox>
                                <div class="akeneo-toolbar-panel-hint">
                                    <template v-if="familyCodes.length">
                                        Scanning {{ familyCodes.length }} {{ familyCodes.length === 1 ? 'family' : 'families' }}.
                                        The unbound-product report needs a whole-catalog scan.
                                    </template>
                                    <template v-else>
                                        No families selected: the whole Akeneo catalog is scanned.
                                    </template>
                                </div>
                                <div class="alert alert-warning mb-0" v-if="familyLoadError">{{ familyLoadError }}</div>
                            </div>
                        </div>

                        <div class="akeneo-toolbar-panel akeneo-toolbar-panel--actions">
                            <div class="akeneo-toolbar-panel-label">
                                <i class="fas fa-bolt"></i>
                                <span>Actions</span>
                            </div>
                            <div class="akeneo-toolbar-panel-body">
                                <div class="akeneo-binding-actions">
                                    <button type="button"
                                            class="btn btn-default"
                                            v-bind:disabled="!!busy"
                                            v-on:click="scan">
                                        <span v-if="busy === 'scan'" class="akeneo-button-spinner" aria-hidden="true"></span>
                                        <i v-else class="fas fa-search"></i>
                                        {{ busy === 'scan' ? 'Scanning...' : 'Scan' }}
                                    </button>
                                    <button type="button"
                                            class="btn btn-primary"
                                            v-bind:disabled="!!busy || !report || report.committed"
                                            v-on:click="confirmCommit">
                                        <span v-if="busy === 'commit'" class="akeneo-button-spinner" aria-hidden="true"></span>
                                        <i v-else class="fas fa-link"></i>
                                        {{ busy === 'commit' ? 'Committing...' : 'Commit bindings' }}
                                    </button>
                                </div>
                                <div class="akeneo-toolbar-panel-hint">
                                    Scan reads Akeneo and nopCommerce without writing anything. Commit rescans,
                                    writes every matched binding plus the conflicts you resolved, and never changes a nopCommerce product.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="akeneo-binding-body">
                        <div class="alert mb-0 mt-3"
                             v-if="message"
                             v-bind:class="messageClass">
                            {{ message }}
                        </div>

                        <div class="alert alert-info mb-0" v-if="!report && !message">
                            Run a scan to see what can be bound.
                        </div>

                        <template v-if="report">
                            <!-- Summary -->
                            <div class="akeneo-binding-tiles">
                                <div class="akeneo-binding-tile" v-for="tile in tiles" v-bind:key="tile.key">
                                    <div class="akeneo-binding-tile-label">{{ tile.label }}</div>
                                    <table class="akeneo-binding-tile-table">
                                        <tbody>
                                            <tr><th>Matched</th><td class="is-mapped">{{ tile.counts.matched }}</td></tr>
                                            <tr><th>Already bound</th><td>{{ tile.counts.alreadyBound }}</td></tr>
                                            <tr v-if="tile.key !== 'axisValues'"><th>Unmatched (sync will create)</th><td>{{ tile.counts.unmatched }}</td></tr>
                                            <tr v-if="tile.key !== 'axisValues'"><th>Conflict</th><td v-bind:class="{ 'is-attention': tile.counts.conflict }">{{ tile.counts.conflict }}</td></tr>
                                            <tr v-if="tile.key !== 'models'"><th>Issue</th><td v-bind:class="{ 'is-danger': tile.counts.issue }">{{ tile.counts.issue }}</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Resolutions (after commit) -->
                            <div class="akeneo-toolbar-panel akeneo-binding-section" v-if="report.resolutions && report.resolutions.length">
                                <div class="akeneo-toolbar-panel-label akeneo-binding-label--mapped">
                                    <i class="fas fa-check-circle"></i>
                                    <span>Resolved conflicts &middot; parents not chosen (report only)</span>
                                </div>
                                <div class="akeneo-toolbar-panel-body">
                                    <table class="table table-sm mb-0 akeneo-binding-table">
                                        <thead>
                                            <tr><th>Product model</th><th>Bound to</th><th>Not chosen</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="item in report.resolutions" v-bind:key="item.productModelCode">
                                                <td class="akeneo-mono">{{ item.productModelCode }}</td>
                                                <td><a v-bind:href="productUrl(item.chosen.id)" target="_blank">#{{ item.chosen.id }} {{ item.chosen.name }}</a></td>
                                                <td>
                                                    <div v-for="other in item.notChosen" v-bind:key="other.id">
                                                        <a v-bind:href="productUrl(other.id)" target="_blank">#{{ other.id }} {{ other.name }}</a>
                                                        <span class="akeneo-dim" v-if="!other.published"> (unpublished)</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Conflicts -->
                            <div class="akeneo-toolbar-panel akeneo-binding-section" v-if="report.conflicts.length">
                                <div class="akeneo-toolbar-panel-label akeneo-binding-label--attention">
                                    <i class="fas fa-code-branch"></i>
                                    <span>Conflicts &middot; {{ report.conflicts.length }}</span>
                                </div>
                                <div class="akeneo-toolbar-panel-body">
                                    <div class="akeneo-toolbar-panel-hint">
                                        These product models have variants that live under more than one nopCommerce product.
                                        Choose the parent to bind; leave a conflict on <strong>Skip</strong> to keep it unbound.
                                        Parents not chosen are only reported.
                                    </div>

                                    <div class="akeneo-binding-conflict" v-for="conflict in report.conflicts" v-bind:key="conflict.productModelCode">
                                        <div class="akeneo-binding-conflict-head">
                                            <span class="akeneo-code">{{ conflict.productModelCode }}</span>
                                            <span class="akeneo-type-chip">{{ conflict.familyCode }}</span>
                                            <span class="akeneo-dim">{{ conflict.variantCount }} {{ conflict.variantCount === 1 ? 'variant' : 'variants' }}</span>
                                        </div>
                                        <label class="akeneo-binding-choice">
                                            <input type="radio"
                                                   v-bind:name="'choice-' + conflict.productModelCode"
                                                   value=""
                                                   v-model="choices[conflict.productModelCode]"
                                                   v-bind:disabled="report.committed" />
                                            <span>Skip (leave unbound)</span>
                                        </label>
                                        <label class="akeneo-binding-choice" v-for="candidate in conflict.candidates" v-bind:key="candidate.productId">
                                            <input type="radio"
                                                   v-bind:name="'choice-' + conflict.productModelCode"
                                                   v-bind:value="String(candidate.productId)"
                                                   v-model="choices[conflict.productModelCode]"
                                                   v-bind:disabled="report.committed" />
                                            <span>
                                                <a v-bind:href="productUrl(candidate.productId)" target="_blank">#{{ candidate.productId }} {{ candidate.name }}</a>
                                                <span class="akeneo-dim" v-if="candidate.sku"> &middot; {{ candidate.sku }}</span>
                                                <span class="akeneo-dim" v-if="!candidate.published"> &middot; unpublished</span>
                                                <span class="badge badge-info ml-1">{{ candidate.variantVotes }} {{ candidate.variantVotes === 1 ? 'variant' : 'variants' }}</span>
                                                <span class="badge badge-secondary ml-1" v-if="candidate.ambiguousVariants">{{ candidate.ambiguousVariants }} shared SKU</span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Issues -->
                            <div class="akeneo-toolbar-panel akeneo-binding-section" v-if="report.issues.length">
                                <div class="akeneo-toolbar-panel-label akeneo-binding-label--danger">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <span>Can't bind &middot; {{ report.issueTotal }}</span>
                                </div>
                                <div class="akeneo-toolbar-panel-body">
                                    <div class="akeneo-toolbar-panel-hint" v-if="report.issueTotal > report.issues.length">
                                        Showing the first {{ report.issues.length }} of {{ report.issueTotal }}.
                                    </div>
                                    <table class="table table-sm mb-0 akeneo-binding-table">
                                        <thead>
                                            <tr><th>Level</th><th>Akeneo</th><th>Family</th><th>Reason</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="(issue, index) in report.issues" v-bind:key="index">
                                                <td>{{ issue.level }}</td>
                                                <td class="akeneo-mono">{{ issue.akeneoCode }}</td>
                                                <td class="akeneo-dim">{{ issue.familyCode }}</td>
                                                <td>{{ issue.message }}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Unbound nopCommerce products -->
                            <div class="akeneo-toolbar-panel akeneo-binding-section">
                                <div class="akeneo-toolbar-panel-label akeneo-binding-label--muted">
                                    <i class="fas fa-unlink"></i>
                                    <span>Published nopCommerce products with no Akeneo binding &middot; {{ report.familyCodes.length ? 'n/a' : report.unboundProductTotal }}</span>
                                </div>
                                <div class="akeneo-toolbar-panel-body">
                                    <div class="akeneo-toolbar-panel-hint" v-if="report.familyCodes.length">
                                        Only produced for a whole-catalog scan. Clear the family selection and scan again.
                                    </div>
                                    <div class="akeneo-toolbar-panel-hint" v-else-if="!report.unboundProductTotal">
                                        Every published product is bound or will be bound by this commit.
                                    </div>
                                    <template v-else>
                                        <div class="akeneo-toolbar-panel-hint" v-if="report.unboundProductTotal > report.unboundProducts.length">
                                            Showing the first {{ report.unboundProducts.length }} of {{ report.unboundProductTotal }}.
                                        </div>
                                        <table class="table table-sm mb-0 akeneo-binding-table">
                                            <thead>
                                                <tr><th>Product</th><th>SKU</th><th>Type</th></tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="product in report.unboundProducts" v-bind:key="product.id">
                                                    <td><a v-bind:href="productUrl(product.id)" target="_blank">#{{ product.id }} {{ product.name }}</a></td>
                                                    <td class="akeneo-mono">{{ product.sku }}</td>
                                                    <td class="akeneo-dim">{{ product.productType }}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <div v-if="commitConfirmVisible" class="modal fade show" style="display: block;" tabindex="-1" role="dialog" aria-modal="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Commit catalog bindings</h5>
                                <button type="button" class="close" aria-label="Close" v-on:click="commitConfirmVisible = false">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-2">
                                    The catalog is rescanned and every matched binding is written.
                                    <template v-if="report && report.conflicts.length">
                                        {{ chosenCount }} of {{ report.conflicts.length }} conflict(s) have a chosen parent; the rest stay unbound.
                                    </template>
                                </p>
                                <p class="mb-0 akeneo-dim">
                                    The next delta sync will apply your attribute mappings to every newly bound product.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" v-on:click="commitConfirmVisible = false">Cancel</button>
                                <button type="button" class="btn btn-primary" v-on:click="commit">
                                    <i class="fas fa-link"></i>
                                    Commit bindings
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div v-if="commitConfirmVisible" class="modal-backdrop fade show" v-on:click="commitConfirmVisible = false"></div>
            </div>
        </div>
    </section>
</div>

<script id="akeneo-binding-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(appModel))</script>

<script asp-location="Footer">
    (function () {
        var appData = JSON.parse(document.getElementById('akeneo-binding-data').textContent);

        // Families arrive as { value: code, text: "Label (code)" }; the combo box
        // shows the label and code separately.
        var families = (appData.families || []).map(function (family) {
            var suffix = ' (' + family.value + ')';
            var text = family.text || family.value;

            return {
                value: family.value,
                label: text.slice(-suffix.length) === suffix
                    ? text.slice(0, -suffix.length)
                    : text
            };
        });

        Vue.createApp({
            data: function () {
                return {
                    families: families,
                    familyLoadError: appData.familyLoadError,
                    familyCodes: [],
                    report: null,
                    choices: {},
                    busy: false, // false or 'scan' / 'commit'; never '' (Vue renders disabled="" as disabled)
                    message: '',
                    messageLevel: 'info',
                    commitConfirmVisible: false
                };
            },
            computed: {
                tiles: function () {
                    if (!this.report)
                        return [];

                    return [
                        { key: 'models', label: 'Product models → parent products', counts: this.report.models },
                        { key: 'variants', label: 'Variants → products / combinations', counts: this.report.variants },
                        { key: 'axisValues', label: 'Axis options → attribute values', counts: this.report.axisValues }
                    ];
                },
                chosenCount: function () {
                    var choices = this.choices;
                    return Object.keys(choices).filter(function (key) { return !!choices[key]; }).length;
                },
                messageClass: function () {
                    return {
                        'alert-info': this.messageLevel === 'info',
                        'alert-success': this.messageLevel === 'success',
                        'alert-warning': this.messageLevel === 'warning',
                        'alert-danger': this.messageLevel === 'danger'
                    };
                }
            },
            methods: {
                productUrl: function (id) {
                    return appData.productEditUrl.replace(/0$/, String(id));
                },
                post: function (url, data) {
                    return $.ajax({
                        type: 'POST',
                        url: url,
                        dataType: 'json',
                        data: addAntiForgeryToken(data)
                    });
                },
                errorMessage: function (xhr, fallback) {
                    return xhr && xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : fallback;
                },
                scan: function () {
                    var self = this;

                    self.busy = 'scan';
                    self.message = '';

                    self.post(appData.scanUrl, {
                        familyCodesJson: JSON.stringify(self.familyCodes)
                    }).done(function (report) {
                        var choices = {};
                        report.conflicts.forEach(function (conflict) {
                            choices[conflict.productModelCode] = '';
                        });

                        self.choices = choices;
                        self.report = report;
                        self.message = report.message;
                        self.messageLevel = report.conflicts.length ? 'warning' : 'info';
                    }).fail(function (xhr) {
                        self.message = self.errorMessage(xhr, 'Catalog binding scan failed.');
                        self.messageLevel = 'danger';
                    }).always(function () {
                        self.busy = false;
                    });
                },
                confirmCommit: function () {
                    this.commitConfirmVisible = true;
                },
                commit: function () {
                    var self = this;
                    var choices = {};

                    Object.keys(self.choices).forEach(function (code) {
                        if (self.choices[code])
                            choices[code] = Number(self.choices[code]);
                    });

                    self.commitConfirmVisible = false;
                    self.busy = 'commit';
                    self.message = '';

                    self.post(appData.commitUrl, {
                        familyCodesJson: JSON.stringify(self.familyCodes),
                        conflictChoicesJson: JSON.stringify(choices)
                    }).done(function (report) {
                        self.report = report;
                        self.message = report.message;
                        self.messageLevel = report.conflicts.length || report.issueTotal ? 'warning' : 'success';
                    }).fail(function (xhr) {
                        self.message = self.errorMessage(xhr, 'Catalog binding commit failed.');
                        self.messageLevel = 'danger';
                    }).always(function () {
                        self.busy = false;
                    });
                }
            }
        })
            .component('akeneo-combobox', window.AkeneoCombobox)
            .mount('#akeneo-binding-app');
    })();
</script>
