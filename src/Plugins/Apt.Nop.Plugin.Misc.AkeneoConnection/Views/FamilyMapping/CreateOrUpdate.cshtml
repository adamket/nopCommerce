@model AkeneoFamilyMappingModel
@using System.Text.Json
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Models
<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{

    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-combobox.js");
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.FamilyMappings");

    Layout = "_AdminLayout";

    var isCreate = Model.Id == 0;

    ViewBag.PageTitle = isCreate
        ? "Create family mapping"
        : "Edit family mapping";



    var vueModelJson = JsonSerializer.Serialize(
        new
        {
            id = Model.Id,
            akeneoFamilyCode = Model.AkeneoFamilyCode,
            akeneoFamilyError = Model.AkeneoFamilyError ?? string.Empty,
            akeneoFamilyVariantCode = Model.AkeneoFamilyVariantCode,
            enabled = Model.Enabled,
            manageVariantsByEnabledStatus = Model.ManageVariantsByEnabledStatus,
            combinationAvailabilitySourceId = Model.CombinationAvailabilitySourceId,
            variantRelationshipModeId = Model.VariantRelationshipModeId,
            productModelHierarchyModeId = Model.ProductModelHierarchyModeId,
            preserveExistingNopVariantStructure = Model.PreserveExistingNopVariantStructure,
            associatedProductAttributeId = Model.AssociatedProductAttributeId,
            associatedValueNameTemplate = Model.AssociatedValueNameTemplate,
            variantDisplayOrderKeys = Model.VariantDisplayOrderKeys ?? string.Empty,
            hideChildProductsWhenRepresentedByParent = Model.HideChildProductsWhenRepresentedByParent,
            newProductTaxCategoryId = Model.NewProductTaxCategoryId,
            newProductIsShipEnabled = Model.NewProductIsShipEnabled,
            newProductWarehouseId = Model.NewProductWarehouseId,
            newProductTemplateId = Model.NewProductTemplateId,
            displayOrder = Model.DisplayOrder,
            axisMappings = Model.AxisMappings.Select(x => new
            {
                id = x.Id,
                familyVariantImportConfigurationId = x.FamilyVariantImportConfigurationId,
                akeneoAttributeCode = x.AkeneoAttributeCode,
                nopProductAttributeId = x.NopProductAttributeId,
                isRequired = x.IsRequired,
                displayOrder = x.DisplayOrder,
                akeneoVariantAxisLevel = x.AkeneoVariantAxisLevel
            }),
            subModelRules = Model.SubModelRules.Select(x => new
            {
                id = x.Id,
                familyMappingId = x.FamilyMappingId,
                akeneoAxisAttributeCode = x.AkeneoAxisAttributeCode,
                triggerValue = x.TriggerValue,
                variantAxisAttributeCode = x.VariantAxisAttributeCode,
                variantTriggerValue = x.VariantTriggerValue,
                variantRelationshipOverrideModeId = x.VariantRelationshipOverrideModeId,
                mergeAncestorValues = x.MergeAncestorValues,
                displayOrder = x.DisplayOrder,
                parentLevelId = x.ParentLevelId,
                associatedProductAttributeId = x.AssociatedProductAttributeId,
                associatedValueNameTemplate = x.AssociatedValueNameTemplate,
                hideChildProducts = x.HideChildProducts
            }),
            availableProductAttributes = Model.AvailableProductAttributes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableTaxCategories = Model.AvailableTaxCategories.Select(x => new { text = x.Text, value = x.Value }),
            availableWarehouses = Model.AvailableWarehouses.Select(x => new { text = x.Text, value = x.Value }),
            availableProductTemplates = Model.AvailableProductTemplates.Select(x => new { text = x.Text, value = x.Value }),
            availableAkeneoFamilies = Model.AvailableAkeneoFamilies.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableAkeneoFamilyVariants = Model.AvailableAkeneoFamilyVariants.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableSubModelAxisAttributes = Model.AvailableSubModelAxisAttributes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableVariantAttributes = Model.AvailableVariantAxisAttributes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableVariantRelationshipModes = Model.AvailableVariantRelationshipModes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableProductModelHierarchyModes = Model.AvailableProductModelHierarchyModes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            familyRuleFieldsUrl = Url.Action(
                "GetFamilyRuleFields",
                "AkeneoFamilyMapping"),

            familyVariantsUrl = Url.Action(
                "GetFamilyVariants",
                "AkeneoFamilyMapping"),

            attributeOptionsUrl = Url.Action(
                "GetAttributeOptions",
                "AkeneoFamilyMapping")
        },
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="akeneo-connection">
    <div id="akeneo-family-variant-config-edit-app" v-cloak>
        <form asp-controller="AkeneoFamilyMapping"
              asp-action="@(isCreate ? "Create" : "Edit")"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div class="content-header clearfix">
                <h1 class="float-left">
                    <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
                    <span>
                        @ViewBag.PageTitle    &nbsp;&nbsp;
                        <small>
                            <a asp-action="List"><i class="fas fa-arrow-circle-left"></i> back to family mapping list</a>
                        </small>
                    </span>
                </h1>

                <div class="float-right">
                    <button type="submit" name="save" class="btn btn-primary">
                        <i class="far fa-save"></i>
                        Save
                    </button>

                    @if (!isCreate)
                    {
                        <button type="button"
                                class="btn btn-default"
                                v-on:click="showDeleteModal = true">
                            <i class="far fa-trash-alt"></i>
                            Delete
                        </button>
                    }
                </div>
            </div>

            <section class="content">
                <div class="container-fluid">
                    <div asp-validation-summary="All" class="akeneo-row-errors text-danger"></div>

                    <div class="card akeneo-mapping-card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-sliders-h"></i>
                                General
                            </h3>
                        </div>

                        <div class="card-body">
                            <div class="p-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="AkeneoFamilyCode"></label>
                                            <akeneo-search-select input-id="AkeneoFamilyCode" item-name="Akeneo family"
                                                                  v-model="form.akeneoFamilyCode"
                                                                  v-bind:options="comboOptions(availableAkeneoFamilies)"
                                                                  placeholder="Search families by label or code"></akeneo-search-select>
                                            <input type="hidden" name="AkeneoFamilyCode" v-bind:value="form.akeneoFamilyCode ?? ''" />
                                            <span asp-validation-for="AkeneoFamilyCode"></span>
                                            <div class="alert alert-danger mt-2 mb-0"
                                                 role="alert"
                                                 v-if="familyError">
                                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                                {{ familyError }}
                                            </div>
                                            <div class="form-text">
                                                Select the Akeneo family this configuration applies to.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="DisplayOrder"></label>
                                            <input asp-for="DisplayOrder"
                                                   type="number"
                                                   class="form-control"
                                                   v-model.number="form.displayOrder" />
                                            <span asp-validation-for="DisplayOrder"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Status</label>
                                            <div>
                                                <label class="akeneo-switch">
                                                    <input asp-for="Enabled"
                                                           type="checkbox"
                                                           v-model="form.enabled" />
                                                    <span class="akeneo-switch-track">
                                                        <span class="akeneo-switch-thumb"></span>
                                                    </span>
                                                    <span class="akeneo-switch-text">
                                                        {{ form.enabled ? 'Enabled' : 'Disabled' }}
                                                    </span>
                                                </label>
                                            </div>
                                            <span asp-validation-for="Enabled"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="AkeneoFamilyVariantCode">Akeneo family variant</label>
                                            <akeneo-search-select input-id="AkeneoFamilyVariantCode" item-name="Akeneo family variant"
                                                                  v-model="form.akeneoFamilyVariantCode"
                                                                  v-bind:options="comboOptions(availableAkeneoFamilyVariants)"
                                                                  v-bind:disabled="!form.akeneoFamilyCode"
                                                                  placeholder="Search family variants"></akeneo-search-select>
                                            <input type="hidden" name="AkeneoFamilyVariantCode" v-bind:value="form.akeneoFamilyVariantCode ?? ''" />
                                            <span asp-validation-for="AkeneoFamilyVariantCode"></span>
                                            <div class="form-text">
                                                Choose a specific family variant for an exact mapping, or use the default to provide fallback behavior for variants without an enabled exact mapping.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <hr />

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="VariantRelationshipModeId"></label>
                                            <akeneo-search-select input-id="VariantRelationshipModeId" item-name="Variant relationship mode"
                                                                  v-model="form.variantRelationshipModeId"
                                                                  v-bind:options="variantRelationshipModeOptions"></akeneo-search-select>
                                            <input type="hidden" name="VariantRelationshipModeId" v-bind:value="form.variantRelationshipModeId" />
                                            <span asp-validation-for="VariantRelationshipModeId"></span>
                                            <div class="form-text">
                                                Controls how newly inserted products and variants for this Akeneo family are represented in nopCommerce.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Existing nopCommerce structure</label>
                                            <div>
                                                <label class="akeneo-switch">
                                                    <input asp-for="PreserveExistingNopVariantStructure"
                                                           type="checkbox"
                                                           v-model="form.preserveExistingNopVariantStructure" />
                                                    <span class="akeneo-switch-track">
                                                        <span class="akeneo-switch-thumb"></span>
                                                    </span>
                                                    <span class="akeneo-switch-text">
                                                        Preserve existing parent variant structure
                                                    </span>
                                                </label>
                                            </div>
                                            <span asp-validation-for="PreserveExistingNopVariantStructure"></span>
                                            <div class="form-text">
                                                Recommended. If a nopCommerce parent already has variants, the import follows that existing structure.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="ProductModelHierarchyModeId">Product model hierarchy</label>
                                            <akeneo-search-select input-id="ProductModelHierarchyModeId" item-name="Product model hierarchy"
                                                                  v-model="form.productModelHierarchyModeId"
                                                                  v-bind:options="comboOptions(availableProductModelHierarchyModes, true)"></akeneo-search-select>
                                            <input type="hidden" name="ProductModelHierarchyModeId" v-bind:value="form.productModelHierarchyModeId" />
                                            <span asp-validation-for="ProductModelHierarchyModeId"></span>
                                            <div class="form-text">
                                                <strong>Root product model</strong> creates only the root parent; submodels still supply inherited and axis values but aren't imported.
                                                Products earlier syncs created for submodels aren't deleted.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <transition name="akeneo-detail-slide">
                                    <div v-if="isAssociatedMode" class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="AssociatedProductAttributeId"></label>
                                                <akeneo-search-select input-id="AssociatedProductAttributeId" item-name="nopCommerce product attribute"
                                                                      v-model="form.associatedProductAttributeId"
                                                                      v-bind:options="comboOptions(availableProductAttributes, true)"
                                                                      placeholder="Search product attributes"></akeneo-search-select>
                                                <input type="hidden" name="AssociatedProductAttributeId" v-bind:value="form.associatedProductAttributeId ?? ''" />
                                                <span asp-validation-for="AssociatedProductAttributeId"></span>
                                                <div class="form-text">
                                                    Required only for associated-to-product product attribute value mode.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="AssociatedValueNameTemplate"></label>
                                                <input asp-for="AssociatedValueNameTemplate"
                                                       class="form-control"
                                                       v-model="form.associatedValueNameTemplate"
                                                       placeholder="{root_variant.label}{root_variant == potted ? &quot; {container_size}&quot; : &quot;&quot;}" />

                                                <span asp-validation-for="AssociatedValueNameTemplate"></span>

                                                <div class="form-text">
                                                    Same template language as computed mappings: {container_size}, {container_size:code},
                                                    {root_variant.label}, {sku}, and conditionals such as {root_variant == potted ? " {container_size}" : ""}.
                                                    Separate alternatives with ||; the first with all its values wins
                                                    (e.g. {attribute:variant_name} || {axes}). If none does, the SKU is used.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>

                                <transition name="akeneo-detail-slide">
                                    <div v-if="isAssociatedMode || isCombinationMode" class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="VariantDisplayOrderKeys">Variant display order</label>
                                                <input id="VariantDisplayOrderKeys" name="VariantDisplayOrderKeys"
                                                       class="form-control"
                                                       v-model="form.variantDisplayOrderKeys"
                                                       placeholder="root_type.display_order, container_size, pack_quantity" />
                                                <span asp-validation-for="VariantDisplayOrderKeys"></span>
                                                <div class="form-text">
                                                    Up to three attributes, most significant first. Selects sort by Akeneo option order, numbers by value;
                                                    for a reference entity name a number field (root_type.display_order). Missing values sort last.
                                                    Values are numbered 0, 10, 20…; empty keeps creation order. Resync after reordering in Akeneo.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>

                                <transition name="akeneo-detail-slide">
                                    <div v-if="usesChildProducts" class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Child product visibility</label>
                                                <div>
                                                    <label class="akeneo-switch">
                                                        <input asp-for="HideChildProductsWhenRepresentedByParent"
                                                               type="checkbox"
                                                               v-model="form.hideChildProductsWhenRepresentedByParent" />
                                                        <span class="akeneo-switch-track">
                                                            <span class="akeneo-switch-thumb"></span>
                                                        </span>
                                                        <span class="akeneo-switch-text">
                                                            Hide child products when represented by parent
                                                        </span>
                                                    </label>
                                                </div>
                                                <span asp-validation-for="HideChildProductsWhenRepresentedByParent"></span>
                                                <div class="form-text">
                                                    Applies to grouped product and associated-to-product modes.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>
                            </div>
                        </div>
                    </div>

                    <div class="card akeneo-mapping-card">
                        <div class="card-header"><h3 class="card-title">New product defaults</h3></div>
                        <div class="card-body">
                            <p class="form-text text-muted mt-0">
                                Set only when the sync creates a product in this family. Later syncs never change them.
                            </p>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Tax category</label>
                                        <akeneo-search-select input-id="NewProductTaxCategoryId" item-name="tax category"
                                                              v-model="form.newProductTaxCategoryId"
                                                              v-bind:options="comboOptions(availableTaxCategories, true)"
                                                              placeholder="Store default"></akeneo-search-select>
                                        <input type="hidden" name="NewProductTaxCategoryId" v-bind:value="form.newProductTaxCategoryId ?? ''" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Warehouse</label>
                                        <akeneo-search-select input-id="NewProductWarehouseId" item-name="warehouse"
                                                              v-model="form.newProductWarehouseId"
                                                              v-bind:options="comboOptions(availableWarehouses, true)"
                                                              placeholder="No warehouse"></akeneo-search-select>
                                        <input type="hidden" name="NewProductWarehouseId" v-bind:value="form.newProductWarehouseId ?? ''" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Product template</label>
                                        <akeneo-search-select input-id="NewProductTemplateId" item-name="product template"
                                                              v-model="form.newProductTemplateId"
                                                              v-bind:options="comboOptions(availableProductTemplates, true)"
                                                              placeholder="Select a product template"></akeneo-search-select>
                                        <input type="hidden" name="NewProductTemplateId" v-bind:value="form.newProductTemplateId ?? ''" />
                                    </div>
                                </div>
                            </div>
                            <label class="akeneo-switch mb-0">
                                <input type="checkbox" name="NewProductIsShipEnabled" value="true" v-model="form.newProductIsShipEnabled" />
                                <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                <span class="akeneo-switch-text">Shipping enabled</span>
                            </label>
                            @* Must follow the checkbox: a bool binds from the first posted value. *@
                            <input type="hidden" name="NewProductIsShipEnabled" value="false" />
                        </div>
                    </div>

                    <input type="hidden" name="ManageVariantsByEnabledStatus" v-bind:value="manageVariantsByEnabledStatusValue" />
                    <input type="hidden" name="CombinationAvailabilitySourceId" v-bind:value="form.combinationAvailabilitySourceId" />
                    <div v-if="isCombinationMode" class="card akeneo-mapping-card">
                        <div class="card-header"><h3 class="card-title">Combination availability</h3></div>
                        <div class="card-body">
                            <div class="form-group mb-2" style="max-width: 420px;">
                                <akeneo-search-select item-name="Combination availability"
                                                      v-model="availabilityChoice"
                                                      v-bind:options="availabilityOptions"></akeneo-search-select>
                            </div>
                            <span class="form-text text-muted" v-if="availabilityChoice === 'enabled'">Disabled Akeneo SKUs have their combinations removed. Re-enabled SKUs have them recreated.</span>
                            <span class="form-text text-muted" v-if="availabilityChoice === 'published'">
                                Each variant's Published mapping decides: false removes its combination, true recreates it,
                                held by "Apply only when" leaves it. A missing value blocks the item.
                            </span>
                            <span class="form-text text-muted" v-if="availabilityChoice === 'off'">Every variant keeps its combination.</span>
                            <span class="form-text text-muted" v-if="availabilityChoice !== 'off'">The parent and shared values are kept. Applies to every profile using this family; profiles must allow updates and include enabled and disabled SKUs. Skip rules take precedence.</span>
                        </div>
                    </div>

                    <transition name="akeneo-detail-slide">
                        <div v-if="isCombinationMode" class="card akeneo-mapping-card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-random"></i>
                                    Axis mappings
                                </h3>
                            </div>

                            <div class="card-body">
                                <div class="alert alert-info">
                                    Map each Akeneo variant axis to a nopCommerce product attribute.
                                    These mappings are used only for product attribute combination mode.
                                </div>

                                <div class="akeneo-list">
                                    <div class="akeneo-group-row">
                                        <a href="#"
                                           class="akeneo-attribute-group-toggle"
                                           v-bind:aria-expanded="axisMappingsOpen ? 'true' : 'false'"
                                           v-on:click.prevent="axisMappingsOpen = !axisMappingsOpen">
                                            <i class="fas fa-chevron-right chevron"></i>
                                            Axis mappings
                                            <span class="akeneo-group-count" v-text="form.axisMappings.length"></span>
                                        </a>

                                        <button type="button"
                                                class="btn btn-default ml-auto"
                                                v-on:click="addAxisMapping">
                                            <i class="fas fa-plus-square"></i>
                                            Add axis mapping
                                        </button>
                                    </div>

                                    <transition name="akeneo-detail-slide">
                                        <div v-show="axisMappingsOpen" class="akeneo-group-items">
                                            <div v-for="(row, index) in form.axisMappings"
                                                 v-bind:key="row.uid"
                                                 class="akeneo-row-shell">
                                                <div class="akeneo-row"
                                                     v-bind:class="axisRowClass(row)">
                                                    <div class="akeneo-col">
                                                        <div class="form-group mb-0">
                                                            <label>Akeneo attribute code</label>

                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'Id')"
                                                                   v-bind:value="row.id" />

                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'FamilyVariantImportConfigurationId')"
                                                                   v-bind:value="row.familyVariantImportConfigurationId" />

                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'AkeneoVariantAxisLevel')"
                                                                   v-bind:value="row.akeneoVariantAxisLevel" />

                                                            <input type="text"
                                                                   class="form-control"
                                                                   v-bind:name="axisName(index, 'AkeneoAttributeCode')"
                                                                   v-model="row.akeneoAttributeCode"
                                                                   placeholder="color" />
                                                        </div>
                                                    </div>

                                                    <div class="akeneo-col">
                                                        <div class="form-group mb-0">
                                                            <label>nopCommerce product attribute</label>
                                                            <akeneo-search-select item-name="nopCommerce product attribute"
                                                                                  v-model="row.nopProductAttributeId"
                                                                                  v-bind:options="comboOptions(availableProductAttributes, true)"
                                                                                  placeholder="Search product attributes"></akeneo-search-select>
                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'NopProductAttributeId')"
                                                                   v-bind:value="row.nopProductAttributeId ?? ''" />
                                                        </div>
                                                    </div>

                                                    <div class="akeneo-col">
                                                        <label class="akeneo-switch">
                                                            <input type="checkbox"
                                                                   v-bind:name="axisName(index, 'IsRequired')"
                                                                   value="true"
                                                                   v-model="row.isRequired" />
                                                            <span class="akeneo-switch-track">
                                                                <span class="akeneo-switch-thumb"></span>
                                                            </span>
                                                            <span class="akeneo-switch-text">
                                                                {{ row.isRequired ? 'Required' : 'Optional' }}
                                                            </span>
                                                        </label>
                                                        @* Must follow the checkbox: a bool binds from the first posted value. *@
                                                        <input type="hidden"
                                                               v-bind:name="axisName(index, 'IsRequired')"
                                                               value="false" />
                                                    </div>

                                                    <div class="akeneo-col">
                                                        <div class="form-group mb-0">
                                                            <label>Display order</label>
                                                            <input type="number"
                                                                   class="form-control"
                                                                   v-bind:name="axisName(index, 'DisplayOrder')"
                                                                   v-model.number="row.displayOrder" />
                                                        </div>
                                                    </div>

                                                    <div class="akeneo-col akeneo-col-actions">
                                                        <button type="button"
                                                                class="btn btn-default"
                                                                v-on:click="removeAxisMapping(index)">
                                                            <i class="far fa-trash-alt"></i>
                                                            Remove
                                                        </button>
                                                    </div>
                                                </div>

                                                <transition name="akeneo-detail-slide">
                                                    <div v-if="axisRowNeedsAttention(row)" class="akeneo-mapping-detail">
                                                        <div class="akeneo-row-errors mb-0">
                                                            <i class="fas fa-exclamation-triangle akeneo-row-errors-icon"></i>
                                                            <div>
                                                                <div class="akeneo-row-errors-title">
                                                                    Mapping is incomplete
                                                                </div>
                                                                <ul>
                                                                    <li v-if="!row.akeneoAttributeCode">
                                                                        Akeneo attribute code is required.
                                                                    </li>
                                                                    <li v-if="!row.nopProductAttributeId">
                                                                        nopCommerce product attribute is required.
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </transition>
                                            </div>
                                        </div>
                                    </transition>
                                </div>
                            </div>
                        </div>
                    </transition>

                    <div class="card akeneo-mapping-card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-code-branch"></i>
                                Sub-model override rules
                            </h3>
                        </div>

                        <div class="card-body">
                            @* <div class="alert alert-info">
                                Rules are checked in display-order sequence. The first matching rule overrides the family's
                                normal variant relationship mode. A sub-model condition is evaluated against the leaf product's
                                parent product model; a variant condition is evaluated against the leaf variant itself.
                            </div> *@

                            <div class="akeneo-list">
                                <div class="akeneo-group-row">
                                    <a href="#"
                                       class="akeneo-attribute-group-toggle"
                                       v-bind:aria-expanded="subModelRulesOpen ? 'true' : 'false'"
                                       v-on:click.prevent="subModelRulesOpen = !subModelRulesOpen">
                                        <i class="fas fa-chevron-right chevron"></i>
                                        Override rules
                                        <span class="akeneo-group-count" v-text="form.subModelRules.length"></span>
                                    </a>

                                    <button type="button"
                                            class="btn btn-default ml-auto"
                                            v-on:click="addSubModelRule">
                                        <i class="fas fa-plus-square"></i>
                                        Add override rule
                                    </button>
                                </div>

                                <transition name="akeneo-detail-slide">
                                    <div v-show="subModelRulesOpen" class="akeneo-group-items">
                                        <div v-if="form.subModelRules.length === 0"
                                             class="alert alert-secondary mt-3 mb-0">
                                            No sub-model overrides are configured. The family-level relationship mode will be used.
                                        </div>

                                        <div v-for="(row, index) in form.subModelRules"
                                             v-bind:key="row.uid"
                                             class="akeneo-row-shell">
                                            <div class="akeneo-row"
                                                 v-bind:class="subModelRuleRowClass(row)">
                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Sub-model axis</label>

                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'Id')"
                                                               v-bind:value="row.id" />

                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'FamilyMappingId')"
                                                               v-bind:value="row.familyMappingId" />

                                                        <akeneo-search-select item-name="Sub-model axis"
                                                                              v-model="row.akeneoAxisAttributeCode"
                                                                              v-bind:options="comboOptions(availableSubModelAxisAttributes)"
                                                                              v-on:change="loadSubModelAttributeOptions(row, true)"
                                                                              placeholder="Search axes"></akeneo-search-select>
                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'AkeneoAxisAttributeCode')"
                                                               v-bind:value="row.akeneoAxisAttributeCode ?? ''" />
                                                    </div>
                                                </div>

                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Sub-model value</label>

                                                        <template v-if="row.subModelSupportsOptions">
                                                            <akeneo-search-select item-name="Sub-model value"
                                                                                  v-model="row.triggerValue"
                                                                                  v-bind:options="valueOptions(row.subModelOptions, row.subModelOptionsLoading)"
                                                                                  v-bind:disabled="!row.akeneoAxisAttributeCode || row.subModelOptionsLoading"
                                                                                  placeholder="Search values"></akeneo-search-select>
                                                            <input type="hidden"
                                                                   v-bind:name="subModelRuleName(index, 'TriggerValue')"
                                                                   v-bind:value="row.triggerValue ?? ''" />
                                                        </template>

                                                        <input v-else
                                                               type="text"
                                                               class="form-control"
                                                               v-bind:name="subModelRuleName(index, 'TriggerValue')"
                                                               v-model.trim="row.triggerValue"
                                                               v-bind:disabled="!row.akeneoAxisAttributeCode"
                                                               placeholder="Value to match" />
                                                    </div>
                                                </div>

                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Variant attribute</label>

                                                        <akeneo-search-select item-name="Variant attribute"
                                                                              v-model="row.variantAxisAttributeCode"
                                                                              v-bind:options="[{ value: '', label: 'No variant condition', hint: '' }].concat(comboOptions(availableVariantAttributes))"
                                                                              v-on:change="loadVariantAttributeOptions(row, true)"
                                                                              placeholder="Search attributes"></akeneo-search-select>
                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'VariantAxisAttributeCode')"
                                                               v-bind:value="row.variantAxisAttributeCode ?? ''" />

                                                      @*   <div class="form-text">
                                                            Select a simple-select attribute stored on the leaf variant.
                                                        </div> *@
                                                    </div>
                                                </div>

                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Variant value</label>

                                                        <akeneo-search-select item-name="Variant value"
                                                                              v-model="row.variantTriggerValue"
                                                                              v-bind:options="valueOptions(row.variantOptions, row.variantOptionsLoading)"
                                                                              v-bind:disabled="!row.variantAxisAttributeCode || row.variantOptionsLoading"
                                                                              placeholder="Search values"></akeneo-search-select>
                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'VariantTriggerValue')"
                                                               v-bind:value="row.variantTriggerValue ?? ''" />

                                                       @*  <div class="form-text">
                                                            The Akeneo option code is saved, while the translated label is displayed.
                                                        </div> *@
                                                    </div>
                                                </div>

                                                <div class="akeneo-col akeneo-col-actions">
                                                    <button type="button"
                                                            class="btn btn-default"
                                                            v-on:click="removeSubModelRule(index)">
                                                        <i class="far fa-trash-alt"></i>
                                                        Remove
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="akeneo-mapping-detail">
                                                <div class="row mb-3">
                                                    <div class="col-md-5">
                                                        <div class="form-group mb-0">
                                                            <label>nopCommerce parent</label>
                                                            <akeneo-search-select item-name="nopCommerce parent"
                                                                                  v-model="row.parentLevelId"
                                                                                  v-bind:options="parentLevelOptions"></akeneo-search-select>
                                                            <input type="hidden"
                                                                   v-bind:name="subModelRuleName(index, 'ParentLevelId')"
                                                                   v-bind:value="row.parentLevelId" />
                                                            <div class="form-text">
                                                                The matching sub-model can be the parent, with each variant an associated-to-product value.
                                                                Its parent product uses mappings with the Sub-model parents role.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row mb-3" v-if="isSubModelParentRule(row)">
                                                    <div class="col-md-4">
                                                        <div class="form-group mb-0">
                                                            <label>Associated product attribute</label>
                                                            <akeneo-search-select item-name="nopCommerce product attribute"
                                                                                  v-model="row.associatedProductAttributeId"
                                                                                  v-bind:options="comboOptions(availableProductAttributes, true)"
                                                                                  placeholder="Family attribute"></akeneo-search-select>
                                                            <input type="hidden"
                                                                   v-bind:name="subModelRuleName(index, 'AssociatedProductAttributeId')"
                                                                   v-bind:value="row.associatedProductAttributeId ?? ''" />
                                                            <div class="form-text">Holds one value per variant. Blank uses the family's attribute.</div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-5">
                                                        <div class="form-group mb-0">
                                                            <label>Associated value name</label>
                                                            <input type="text"
                                                                   class="form-control"
                                                                   v-bind:name="subModelRuleName(index, 'AssociatedValueNameTemplate')"
                                                                   v-model="row.associatedValueNameTemplate"
                                                                   placeholder="Family template" />
                                                            <div class="form-text">Same template language as the family's associated value name. Blank uses the family's.</div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <div class="form-group mb-0">
                                                            <label>Child products</label>
                                                            <div>
                                                                <label class="akeneo-switch">
                                                                    <input type="checkbox"
                                                                           v-bind:name="subModelRuleName(index, 'HideChildProducts')"
                                                                           value="true"
                                                                           v-model="row.hideChildProducts" />
                                                                    <span class="akeneo-switch-track">
                                                                        <span class="akeneo-switch-thumb"></span>
                                                                    </span>
                                                                    <span class="akeneo-switch-text">
                                                                        {{ row.hideChildProducts ? 'Hidden' : 'Visible individually' }}
                                                                    </span>
                                                                </label>
                                                                @* Must follow the checkbox: a bool binds from the first posted value. *@
                                                                <input type="hidden"
                                                                       v-bind:name="subModelRuleName(index, 'HideChildProducts')"
                                                                       value="false" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-5" v-if="!isSubModelParentRule(row)">
                                                        <div class="form-group mb-0">
                                                            <label>Relationship override</label>
                                                            <akeneo-search-select item-name="Relationship override"
                                                                                  v-model="row.variantRelationshipOverrideModeId"
                                                                                  v-bind:options="comboOptions(availableVariantRelationshipModes, true)"></akeneo-search-select>
                                                            <input type="hidden"
                                                                   v-bind:name="subModelRuleName(index, 'VariantRelationshipOverrideModeId')"
                                                                   v-bind:value="row.variantRelationshipOverrideModeId" />
                                                            <div class="form-text">
                                                                None imports a matching leaf as a standalone product when no existing variant structure must be preserved.
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-4" v-if="!isSubModelParentRule(row)">
                                                        <div class="form-group mb-0">
                                                            <label>Ancestor values</label>
                                                            <div>
                                                                <label class="akeneo-switch">
                                                                    <input type="checkbox"
                                                                           v-bind:name="subModelRuleName(index, 'MergeAncestorValues')"
                                                                           value="true"
                                                                           v-model="row.mergeAncestorValues" />
                                                                    <span class="akeneo-switch-track">
                                                                        <span class="akeneo-switch-thumb"></span>
                                                                    </span>
                                                                    <span class="akeneo-switch-text">
                                                                        {{ row.mergeAncestorValues ? 'Merge ancestor values' : 'Leaf values only' }}
                                                                    </span>
                                                                </label>
                                                                @* Must follow the checkbox: a bool binds from the first posted value. *@
                                                                <input type="hidden"
                                                                       v-bind:name="subModelRuleName(index, 'MergeAncestorValues')"
                                                                       value="false" />
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <div class="form-group mb-0">
                                                            <label>Display order</label>
                                                            <input type="number"
                                                                   class="form-control"
                                                                   min="0"
                                                                   v-bind:name="subModelRuleName(index, 'DisplayOrder')"
                                                                   v-model.number="row.displayOrder" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div v-if="subModelRuleNeedsAttention(row)"
                                                     class="akeneo-row-errors mt-3 mb-0">
                                                    <i class="fas fa-exclamation-triangle akeneo-row-errors-icon"></i>
                                                    <div>
                                                        <div class="akeneo-row-errors-title">
                                                            Override rule is incomplete
                                                        </div>
                                                        <ul>
                                                            <li v-if="!hasAnySubModelRuleCondition(row)">
                                                                Add at least one complete sub-model or variant condition.
                                                            </li>
                                                            <li v-if="Boolean(row.akeneoAxisAttributeCode) !== Boolean(row.triggerValue)">
                                                                The sub-model axis and trigger value must be supplied together.
                                                            </li>
                                                            <li v-if="Boolean(row.variantAxisAttributeCode) !== Boolean(row.variantTriggerValue)">
                                                                The variant axis and trigger value must be supplied together.
                                                            </li>
                                                            <li v-if="isSubModelParentRule(row) && !subModelParentRuleIsValid(row)">
                                                                A sub-model parent needs a sub-model condition and no variant condition.
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>

        @if (!isCreate)
        {
            <div v-if="showDeleteModal"
                 class="modal fade show"
                 style="display: block;"
                 tabindex="-1"
                 role="dialog"
                 aria-modal="true">
                <div class="modal-dialog" role="document">
                    <form asp-controller="AkeneoFamilyMapping"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Delete configuration</h5>
                                <button type="button"
                                        class="close"
                                        aria-label="Close"
                                        v-on:click="showDeleteModal = false">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                Are you sure you want to delete this family variant import configuration?
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-default"
                                        v-on:click="showDeleteModal = false">
                                    Cancel
                                </button>

                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div v-if="showDeleteModal"
                 class="modal-backdrop fade show"
                 v-on:click="showDeleteModal = false"></div>
        }
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const { createApp } = Vue;

        const initialModel = @Html.Raw(vueModelJson);

        createApp({
            data() {
                return {
                    showDeleteModal: false,
                    axisMappingsOpen: true,
                    subModelRulesOpen: true,
                    modes: {
                        none: @((int)AkeneoVariantRelationshipMode.None),
                        combinations: @((int)AkeneoVariantRelationshipMode.ProductAttributeCombinations),
                        associated: @((int)AkeneoVariantRelationshipMode.AssociatedToProductAttributeValue),
                        grouped: @((int)AkeneoVariantRelationshipMode.GroupedProducts)
                    },
                    parentLevels: {
                        familySetting: @((int)AkeneoSubModelParentLevel.FamilySetting),
                        matchingSubModel: @((int)AkeneoSubModelParentLevel.MatchingSubModel)
                    },
                    availableProductAttributes: initialModel.availableProductAttributes,
                    availableTaxCategories: initialModel.availableTaxCategories,
                    availableWarehouses: initialModel.availableWarehouses,
                    availableProductTemplates: initialModel.availableProductTemplates,
                    availableAkeneoFamilies: initialModel.availableAkeneoFamilies,
                    familyError: initialModel.akeneoFamilyError || '',
                    availableAkeneoFamilyVariants: initialModel.availableAkeneoFamilyVariants,
                    availableSubModelAxisAttributes: initialModel.availableSubModelAxisAttributes,
                    availableVariantAttributes: initialModel.availableVariantAttributes,
                    availableVariantRelationshipModes: initialModel.availableVariantRelationshipModes,
                    availableProductModelHierarchyModes: initialModel.availableProductModelHierarchyModes,
                    form: {
                        ...initialModel,
                        akeneoFamilyVariantCode: initialModel.akeneoFamilyVariantCode || '',
                        associatedProductAttributeId: initialModel.associatedProductAttributeId ?? '',
                        newProductTaxCategoryId: initialModel.newProductTaxCategoryId ?? '',
                        newProductWarehouseId: initialModel.newProductWarehouseId ?? '',
                        newProductTemplateId: initialModel.newProductTemplateId ?? '',
                        axisMappings: initialModel.axisMappings.map((row, index) => ({
                            uid: `${Date.now()}-axis-${index}`,
                            id: row.id || 0,
                            familyVariantImportConfigurationId: row.familyVariantImportConfigurationId || initialModel.id || 0,
                            akeneoAttributeCode: row.akeneoAttributeCode || '',
                            nopProductAttributeId: row.nopProductAttributeId || '',
                            isRequired: row.isRequired !== false,
                            displayOrder: row.displayOrder || index + 1,
                            akeneoVariantAxisLevel: row.akeneoVariantAxisLevel || 1
                        })),
                            subModelRules: initialModel.subModelRules.map((row, index) => ({
                            uid: `${Date.now()}-rule-${index}`,
                            id: row.id || 0,
                            familyMappingId: row.familyMappingId || initialModel.id || 0,
                            akeneoAxisAttributeCode: row.akeneoAxisAttributeCode || '',
                            triggerValue: row.triggerValue || '',
                            variantAxisAttributeCode: row.variantAxisAttributeCode || '',
                            variantTriggerValue: row.variantTriggerValue || '',
                            variantRelationshipOverrideModeId:
                                Number(row.variantRelationshipOverrideModeId ??
                                    @((int)AkeneoVariantRelationshipMode.None)),
                            mergeAncestorValues: row.mergeAncestorValues !== false,
                            displayOrder: row.displayOrder || index + 1,
                            parentLevelId: Number(row.parentLevelId || 0),
                            associatedProductAttributeId: row.associatedProductAttributeId ?? '',
                            associatedValueNameTemplate: row.associatedValueNameTemplate || '',
                            hideChildProducts: row.hideChildProducts !== false,

                            // UI-only properties
                            subModelOptions: [],
                            subModelOptionsLoading: false,
                            subModelSupportsOptions: false,
                            variantOptions: [],
                            variantOptionsLoading: false
                        }))
                    }
                };
            },

            computed: {
                // Off, Akeneo enabled status, or the Published rule: the switch plus its source.
                availabilityChoice: {
                    get() {
                        if (!this.form.manageVariantsByEnabledStatus)
                            return 'off';
                        return Number(this.form.combinationAvailabilitySourceId) === @((int)AkeneoCombinationAvailabilitySource.PublishedRule)
                            ? 'published'
                            : 'enabled';
                    },
                    set(value) {
                        this.form.manageVariantsByEnabledStatus = value !== 'off';
                        this.form.combinationAvailabilitySourceId = value === 'published'
                            ? @((int)AkeneoCombinationAvailabilitySource.PublishedRule)
                            : @((int)AkeneoCombinationAvailabilitySource.EnabledStatus);
                    }
                },

                availabilityOptions() {
                    return [
                        { value: 'off', label: 'Off: every variant keeps its combination', hint: '' },
                        { value: 'enabled', label: 'Akeneo enabled status', hint: '' },
                        { value: 'published', label: 'Published rule', hint: '' }
                    ];
                },

                manageVariantsByEnabledStatusValue() {
                    return this.isCombinationMode && this.form.manageVariantsByEnabledStatus ? 'true' : 'false';
                },
                isCombinationMode() {
                    return Number(this.form.variantRelationshipModeId) === this.modes.combinations;
                },

                isAssociatedMode() {
                    return Number(this.form.variantRelationshipModeId) === this.modes.associated;
                },

                isGroupedMode() {
                    return Number(this.form.variantRelationshipModeId) === this.modes.grouped;
                },

                usesChildProducts() {
                    return this.isAssociatedMode || this.isGroupedMode;
                },

                parentLevelOptions() {
                    return [
                        { value: this.parentLevels.familySetting, label: 'Family setting', hint: '' },
                        { value: this.parentLevels.matchingSubModel, label: 'Matching sub-model is the parent', hint: '' }
                    ];
                },

                variantRelationshipModeOptions() {
                    return [
                        { value: this.modes.none, label: 'None', hint: '' },
                        { value: this.modes.combinations, label: 'Product attribute combinations', hint: '' },
                        { value: this.modes.associated, label: 'Associated-to-product product attribute values', hint: '' },
                        { value: this.modes.grouped, label: 'Grouped products', hint: '' }
                    ];
                }
            },

            watch: {
                'form.akeneoFamilyCode': async function (
                    newFamilyCode,
                    oldFamilyCode) {

                    if (newFamilyCode === oldFamilyCode)
                        return;

                    // A newly chosen family comes from Akeneo's own list.
                    this.familyError = '';

                    await this.loadFamilyVariants(newFamilyCode, false);
                    await this.loadFamilyRuleFields(
                        newFamilyCode,
                        this.form.akeneoFamilyVariantCode);
                },

                'form.akeneoFamilyVariantCode': function (
                    newFamilyVariantCode,
                    oldFamilyVariantCode) {

                    if (newFamilyVariantCode === oldFamilyVariantCode)
                        return;

                    this.loadFamilyRuleFields(
                        this.form.akeneoFamilyCode,
                        newFamilyVariantCode);
                }
            },

            async mounted() {
                if (this.form.axisMappings.length === 0)
                    this.addAxisMapping();

                // The server already reported a missing family; its variant and
                // axis lookups would only 404.
                if (this.form.akeneoFamilyCode && !this.familyError) {
                    await this.loadFamilyVariants(
                        this.form.akeneoFamilyCode,
                        true);
                    await this.loadFamilyRuleFields(
                        this.form.akeneoFamilyCode,
                        this.form.akeneoFamilyVariantCode);
                }
            },

            methods: {
                newUid() {
                    return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
                },
                async loadFamilyVariants(
                    familyCode,
                    preserveSelection = true) {

                    const defaultOption = {
                        text: 'All family variants (default)',
                        value: ''
                    };

                    if (!familyCode) {
                        this.availableAkeneoFamilyVariants = [defaultOption];
                        this.form.akeneoFamilyVariantCode = '';
                        return;
                    }

                    const selected = preserveSelection
                        ? (this.form.akeneoFamilyVariantCode || '')
                        : '';

                    try {
                        const separator =
                            initialModel.familyVariantsUrl.includes('?')
                                ? '&'
                                : '?';

                        const response = await fetch(
                            `${initialModel.familyVariantsUrl}` +
                            `${separator}familyCode=${encodeURIComponent(familyCode)}`,
                            {
                                method: 'GET',
                                headers: { Accept: 'application/json' }
                            });

                        if (!response.ok) {
                            throw new Error(
                                `Unable to load family variants. HTTP ${response.status}.`);
                        }

                        this.availableAkeneoFamilyVariants = await response.json();

                        const selectionExists =
                            this.availableAkeneoFamilyVariants.some(option =>
                                String(option.value || '').toLowerCase() ===
                                String(selected).toLowerCase());

                        if (selected && !selectionExists) {
                            this.availableAkeneoFamilyVariants.push({
                                text: `${selected} (not currently returned by Akeneo)`,
                                value: selected
                            });
                        }

                        this.form.akeneoFamilyVariantCode = selected;
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo family variants.',
                            error);

                        this.availableAkeneoFamilyVariants = [defaultOption];
                        if (selected) {
                            this.availableAkeneoFamilyVariants.push({
                                text: `${selected} (not currently returned by Akeneo)`,
                                value: selected
                            });
                        }
                        this.form.akeneoFamilyVariantCode = selected;
                    }
                },
                async loadFamilyRuleFields(
                    familyCode,
                    familyVariantCode) {
                    const emptySubModelOption = {
                        text: 'No sub-model condition',
                        value: ''
                    };

                    if (!familyCode) {
                        this.availableSubModelAxisAttributes = [
                            emptySubModelOption
                        ];

                        this.availableVariantAttributes = [];

                        this.form.subModelRules.forEach(row => {
                            row.subModelOptions = [];
                            row.subModelOptionsLoading = false;
                            row.subModelSupportsOptions = false;
                            row.variantOptions = [];
                            row.variantOptionsLoading = false;
                        });

                        return;
                    }

                    try {
                        const separator =
                            initialModel.familyRuleFieldsUrl.includes('?')
                                ? '&'
                                : '?';

                        const response = await fetch(
                            `${initialModel.familyRuleFieldsUrl}` +
                            `${separator}familyCode=${encodeURIComponent(familyCode)}` +
                            `&familyVariantCode=${encodeURIComponent(familyVariantCode || '')}`,
                            {
                                method: 'GET',
                                headers: {
                                    Accept: 'application/json'
                                }
                            });

                        if (!response.ok) {
                            throw new Error(
                                `Unable to load family rule fields. ` +
                                `HTTP ${response.status}.`
                            );
                        }

                        const result = await response.json();

                        this.availableSubModelAxisAttributes = [
                            emptySubModelOption,
                            ...(result.subModelAxes || [])
                        ];

                        this.availableVariantAttributes =
                            result.variantAttributes || [];

                        this.preserveSelectedRuleAttributeOptions();

                        await Promise.all(
                            this.form.subModelRules.flatMap(row => [
                                this.loadSubModelAttributeOptions(row, false),
                                this.loadVariantAttributeOptions(row, false)
                            ])
                        );
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo family rule fields.',
                            error);

                        this.preserveSelectedRuleAttributeOptions();
                    }
                },
                async loadSubModelAttributeOptions(
                    row,
                    clearSelectedValue = false) {

                    if (clearSelectedValue)
                        row.triggerValue = '';

                    row.subModelOptions = [];
                    row.subModelSupportsOptions =
                        this.subModelAxisSupportsOptions(
                            row.akeneoAxisAttributeCode);

                    if (!row.akeneoAxisAttributeCode ||
                        !row.subModelSupportsOptions) {
                        row.subModelOptionsLoading = false;
                        return;
                    }

                    row.subModelOptionsLoading = true;

                    try {
                        row.subModelOptions = await this.fetchAttributeOptions(
                            row.akeneoAxisAttributeCode);

                        this.preserveSelectedSubModelValue(row);
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo sub-model axis options.',
                            error);

                        this.preserveSelectedSubModelValue(row);
                    }
                    finally {
                        row.subModelOptionsLoading = false;
                    }
                },

                subModelAxisSupportsOptions(attributeCode) {
                    if (!attributeCode)
                        return false;

                    const attribute =
                        this.availableSubModelAxisAttributes.find(option =>
                            String(option.value).toLowerCase() ===
                            String(attributeCode).toLowerCase());

                    return attribute?.supportsOptions === true;
                },

                async fetchAttributeOptions(attributeCode) {
                    const separator =
                        initialModel.attributeOptionsUrl.includes('?')
                            ? '&'
                            : '?';

                    const response = await fetch(
                        `${initialModel.attributeOptionsUrl}` +
                        `${separator}attributeCode=` +
                        `${encodeURIComponent(attributeCode)}`,
                        {
                            method: 'GET',
                            headers: {
                                Accept: 'application/json'
                            }
                        });

                    if (!response.ok) {
                        throw new Error(
                            `Unable to load attribute options. ` +
                            `HTTP ${response.status}.`
                        );
                    }

                    return await response.json();
                },

                    async loadVariantAttributeOptions(row, clearSelectedValue = false) {

                    if (clearSelectedValue)
                        row.variantTriggerValue = '';

                    row.variantOptions = [];

                    if (!row.variantAxisAttributeCode)
                        return;

                    row.variantOptionsLoading = true;

                    try {
                        row.variantOptions = await this.fetchAttributeOptions(
                            row.variantAxisAttributeCode);

                        this.preserveSelectedVariantValue(row);
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo attribute options.',
                            error);

                        this.preserveSelectedVariantValue(row);
                    }
                    finally {
                        row.variantOptionsLoading = false;
                    }
                },
                preserveSelectedRuleAttributeOptions() {
                    this.form.subModelRules.forEach(row => {
                        this.addMissingOption(
                            this.availableSubModelAxisAttributes,
                            row.akeneoAxisAttributeCode);

                        this.addMissingOption(
                            this.availableVariantAttributes,
                            row.variantAxisAttributeCode);
                    });
                },

                addMissingOption(options, code) {
                    if (!code)
                        return;

                    const exists = options.some(option =>
                        String(option.value).toLowerCase() ===
                        String(code).toLowerCase());

                    if (exists)
                        return;

                    options.push({
                        text: `${code} (not currently returned by Akeneo)`,
                        value: code,
                        supportsOptions: false
                    });
                },

                addAxisMapping() {
                    this.form.axisMappings.push({
                        uid: this.newUid(),
                        id: 0,
                        familyVariantImportConfigurationId: this.form.id || 0,
                        akeneoAttributeCode: '',
                        nopProductAttributeId: '',
                        isRequired: true,
                        displayOrder: this.form.axisMappings.length + 1,
                        akeneoVariantAxisLevel: 1
                    });

                    this.axisMappingsOpen = true;
                },

                removeAxisMapping(index) {
                    this.form.axisMappings.splice(index, 1);

                    this.form.axisMappings.forEach((row, rowIndex) => {
                        if (!row.displayOrder)
                            row.displayOrder = rowIndex + 1;
                    });
                },
                preserveSelectedSubModelValue(row) {
                    const selectedValue = row.triggerValue;

                    if (!selectedValue)
                        return;

                    const exists = row.subModelOptions.some(option =>
                        String(option.value).toLowerCase() ===
                        String(selectedValue).toLowerCase());

                    if (exists)
                        return;

                    row.subModelOptions.push({
                        text: `${selectedValue} (not currently returned by Akeneo)`,
                        value: selectedValue
                    });
                },

                preserveSelectedVariantValue(row) {
                    const selectedValue = row.variantTriggerValue;

                    if (!selectedValue)
                        return;

                    const exists = row.variantOptions.some(option =>
                        String(option.value).toLowerCase() ===
                        String(selectedValue).toLowerCase());

                    if (exists)
                        return;

                    row.variantOptions.push({
                        text: `${selectedValue} (not currently returned by Akeneo)`,
                        value: selectedValue
                    });
                },

                addSubModelRule() {
                    this.form.subModelRules.push({
                        uid: this.newUid(),
                        id: 0,
                        familyMappingId: this.form.id || 0,
                        akeneoAxisAttributeCode: '',
                        triggerValue: '',
                        variantAxisAttributeCode: '',
                        variantTriggerValue: '',
                        variantRelationshipOverrideModeId: this.modes.none,
                        mergeAncestorValues: true,
                        displayOrder: this.form.subModelRules.length + 1,
                        parentLevelId: this.parentLevels.familySetting,
                        associatedProductAttributeId: '',
                        associatedValueNameTemplate: '',
                        hideChildProducts: true,

                        subModelOptions: [],
                        subModelOptionsLoading: false,
                        subModelSupportsOptions: false,
                        variantOptions: [],
                        variantOptionsLoading: false
                    });

                    this.subModelRulesOpen = true;
                },

                removeSubModelRule(index) {
                    this.form.subModelRules.splice(index, 1);

                    this.form.subModelRules.forEach((row, rowIndex) => {
                        if (!row.displayOrder)
                            row.displayOrder = rowIndex + 1;
                    });
                },

                axisName(index, propertyName) {
                    return `AxisMappings[${index}].${propertyName}`;
                },

                subModelRuleName(index, propertyName) {
                    return `SubModelRules[${index}].${propertyName}`;
                },

                numberOrEmpty(value) {
                    if (value === null || value === undefined || value === '')
                        return '';

                    return Number(value);
                },

                // { text, value } lists to <akeneo-search-select> options. "Label (code)"
                // text is split into the label and a monospace code hint, as on the
                // attribute mappings page. Numeric lists keep '' for their empty option.
                comboOptions(options, numeric = false) {
                    return (options || []).map(option => {
                        const raw = option.value ?? '';
                        const value = numeric ? this.numberOrEmpty(raw) : raw;
                        const text = String(option.text ?? raw);
                        const suffix = ` (${raw})`;
                        const hasCode = raw !== '' && text.endsWith(suffix);

                        return {
                            value,
                            label: hasCode ? text.slice(0, -suffix.length) : text,
                            hint: hasCode ? String(raw) : ''
                        };
                    });
                },

                // Option values for a rule condition, behind a "Select a value" (or
                // loading) placeholder.
                valueOptions(options, loading) {
                    return [{
                        value: '',
                        label: loading ? 'Loading values...' : 'Select a value',
                        hint: ''
                    }].concat(this.comboOptions(options));
                },

                axisRowNeedsAttention(row) {
                    return !row.akeneoAttributeCode || !row.nopProductAttributeId;
                },

                axisRowClass(row) {
                    if (this.axisRowNeedsAttention(row))
                        return 'is-attention';

                    return 'is-mapped';
                },

                hasAnySubModelRuleCondition(row) {
                    const hasSubModelCondition = Boolean(row.akeneoAxisAttributeCode) && Boolean(row.triggerValue);
                    const hasVariantCondition = Boolean(row.variantAxisAttributeCode) && Boolean(row.variantTriggerValue);
                    return hasSubModelCondition || hasVariantCondition;
                },

                isSubModelParentRule(row) {
                    return Number(row.parentLevelId) === this.parentLevels.matchingSubModel;
                },

                subModelParentRuleIsValid(row) {
                    return Boolean(row.akeneoAxisAttributeCode) && Boolean(row.triggerValue) &&
                        !row.variantAxisAttributeCode && !row.variantTriggerValue;
                },

                subModelRuleNeedsAttention(row) {
                    if (!this.hasAnySubModelRuleCondition(row))
                        return true;

                    if (this.isSubModelParentRule(row) && !this.subModelParentRuleIsValid(row))
                        return true;

                    if (Boolean(row.akeneoAxisAttributeCode) !== Boolean(row.triggerValue))
                        return true;

                    return Boolean(row.variantAxisAttributeCode) !== Boolean(row.variantTriggerValue);
                },

                subModelRuleRowClass(row) {
                    return this.subModelRuleNeedsAttention(row)
                        ? 'is-attention'
                        : 'is-mapped';
                }
            }
        }).component('akeneo-search-select', {
            extends: window.AkeneoCombobox,
            props: {
                multiple: { type: Boolean, default: false },
                clearable: { type: Boolean, default: false }
            }
        }).mount('#akeneo-family-variant-config-edit-app');
    })();
</script>
