@model AkeneoFamilyMappingModel
@using System.Text.Json
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Models
<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{

    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.FamilyMappings");

    Layout = "_AdminLayout";

    var isCreate = Model.Id == 0;

    ViewBag.PageTitle = isCreate
        ? "Create family mapping"
        : "Edit family mapping";



    var vueModelJson = JsonSerializer.Serialize(
        new
        {
            id = Model.Id,
            akeneoFamilyCode = Model.AkeneoFamilyCode,
            enabled = Model.Enabled,
            variantRelationshipModeId = Model.VariantRelationshipModeId,
            productModelHierarchyModeId = Model.ProductModelHierarchyModeId,
            preserveExistingNopVariantStructure = Model.PreserveExistingNopVariantStructure,
            associatedProductAttributeId = Model.AssociatedProductAttributeId,
            associatedValueNameTemplate = Model.AssociatedValueNameTemplate,
            hideChildProductsWhenRepresentedByParent = Model.HideChildProductsWhenRepresentedByParent,
            displayOrder = Model.DisplayOrder,
            axisMappings = Model.AxisMappings.Select(x => new
            {
                id = x.Id,
                familyVariantImportConfigurationId = x.FamilyVariantImportConfigurationId,
                akeneoAttributeCode = x.AkeneoAttributeCode,
                nopProductAttributeId = x.NopProductAttributeId,
                isRequired = x.IsRequired,
                displayOrder = x.DisplayOrder
            }),
            subModelRules = Model.SubModelRules.Select(x => new
            {
                id = x.Id,
                familyMappingId = x.FamilyMappingId,
                akeneoAxisAttributeCode = x.AkeneoAxisAttributeCode,
                triggerValue = x.TriggerValue,
                variantAxisAttributeCode = x.VariantAxisAttributeCode,
                variantTriggerValue = x.VariantTriggerValue,
                variantRelationshipOverrideModeId = x.VariantRelationshipOverrideModeId,
                mergeAncestorValues = x.MergeAncestorValues,
                displayOrder = x.DisplayOrder
            }),
            availableProductAttributes = Model.AvailableProductAttributes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableAkeneoFamilies = Model.AvailableAkeneoFamilies.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableSubModelAxisAttributes = Model.AvailableSubModelAxisAttributes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableVariantAttributes = Model.AvailableVariantAxisAttributes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableVariantRelationshipModes = Model.AvailableVariantRelationshipModes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            availableProductModelHierarchyModes = Model.AvailableProductModelHierarchyModes.Select(x => new
            {
                text = x.Text,
                value = x.Value
            }),
            familyRuleFieldsUrl = Url.Action(
                "GetFamilyRuleFields",
                "AkeneoFamilyMapping"),

            attributeOptionsUrl = Url.Action(
                "GetAttributeOptions",
                "AkeneoFamilyMapping")
        },
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="akeneo-connection">
    <div id="akeneo-family-variant-config-edit-app" v-cloak>
        <form asp-controller="AkeneoFamilyMapping"
              asp-action="@(isCreate ? "Create" : "Edit")"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div class="content-header clearfix">
                <h1 class="float-left">
                    <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
                    <span>
                        @ViewBag.PageTitle    &nbsp;&nbsp;
                        <small>
                            <a asp-action="List"><i class="fas fa-arrow-circle-left"></i> back to family mapping list</a>
                        </small>
                    </span>
                </h1>

                <div class="float-right">
                    <button type="submit" name="save" class="btn btn-primary">
                        <i class="far fa-save"></i>
                        Save
                    </button>

                    @if (!isCreate)
                    {
                        <button type="button"
                                class="btn btn-default"
                                v-on:click="showDeleteModal = true">
                            <i class="far fa-trash-alt"></i>
                            Delete
                        </button>
                    }
                </div>
            </div>

            <section class="content">
                <div class="container-fluid">
                    <div asp-validation-summary="All" class="akeneo-row-errors text-danger"></div>

                    <div class="card akeneo-mapping-card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-sliders-h"></i>
                                General
                            </h3>
                        </div>

                        <div class="card-body">
                            <div class="p-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="AkeneoFamilyCode"></label>
                                            <select asp-for="AkeneoFamilyCode"
                                                    class="form-control"
                                                    v-model="form.akeneoFamilyCode">
                                                <option v-for="family in availableAkeneoFamilies"
                                                        v-bind:key="family.value || 'empty'"
                                                        v-bind:value="family.value">
                                                    {{ family.text }}
                                                </option>
                                            </select>
                                            <span asp-validation-for="AkeneoFamilyCode"></span>
                                            <div class="form-text">
                                                Select the Akeneo family this configuration applies to.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label asp-for="DisplayOrder"></label>
                                            <input asp-for="DisplayOrder"
                                                   type="number"
                                                   class="form-control"
                                                   v-model.number="form.displayOrder" />
                                            <span asp-validation-for="DisplayOrder"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Status</label>
                                            <div>
                                                <label class="akeneo-switch">
                                                    <input asp-for="Enabled"
                                                           type="checkbox"
                                                           v-model="form.enabled" />
                                                    <span class="akeneo-switch-track">
                                                        <span class="akeneo-switch-thumb"></span>
                                                    </span>
                                                    <span class="akeneo-switch-text">
                                                        {{ form.enabled ? 'Enabled' : 'Disabled' }}
                                                    </span>
                                                </label>
                                            </div>
                                            <span asp-validation-for="Enabled"></span>
                                        </div>
                                    </div>
                                </div>

                                <hr />

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="VariantRelationshipModeId"></label>
                                            <select asp-for="VariantRelationshipModeId"
                                                    class="form-control"
                                                    v-model.number="form.variantRelationshipModeId">
                                                <option value="@((int)AkeneoVariantRelationshipMode.None)">
                                                    None
                                                </option>
                                                <option value="@((int)AkeneoVariantRelationshipMode.ProductAttributeCombinations)">
                                                    Product attribute combinations
                                                </option>
                                                <option value="@((int)AkeneoVariantRelationshipMode.AssociatedToProductAttributeValue)">
                                                    Associated-to-product product attribute values
                                                </option>
                                                <option value="@((int)AkeneoVariantRelationshipMode.GroupedProducts)">
                                                    Grouped products
                                                </option>
                                            </select>
                                            <span asp-validation-for="VariantRelationshipModeId"></span>
                                            <div class="form-text">
                                                Controls how newly inserted products and variants for this Akeneo family are represented in nopCommerce.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Existing nopCommerce structure</label>
                                            <div>
                                                <label class="akeneo-switch">
                                                    <input asp-for="PreserveExistingNopVariantStructure"
                                                           type="checkbox"
                                                           v-model="form.preserveExistingNopVariantStructure" />
                                                    <span class="akeneo-switch-track">
                                                        <span class="akeneo-switch-thumb"></span>
                                                    </span>
                                                    <span class="akeneo-switch-text">
                                                        Preserve existing parent variant structure
                                                    </span>
                                                </label>
                                            </div>
                                            <span asp-validation-for="PreserveExistingNopVariantStructure"></span>
                                            <div class="form-text">
                                                Recommended. If a nopCommerce parent already has variants, the import follows that existing structure.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="ProductModelHierarchyModeId">Product model hierarchy</label>
                                            <select asp-for="ProductModelHierarchyModeId"
                                                    class="form-control"
                                                    v-model.number="form.productModelHierarchyModeId">
                                                <option v-for="mode in availableProductModelHierarchyModes"
                                                        v-bind:key="mode.value"
                                                        v-bind:value="Number(mode.value)">
                                                    {{ mode.text }}
                                                </option>
                                            </select>
                                            <span asp-validation-for="ProductModelHierarchyModeId"></span>
                                            <div class="form-text">
                                                Choose <strong>Root product model</strong> to create only the root nopCommerce parent. Intermediate Akeneo submodels still contribute inherited values and variant-axis values, but are not imported as products.
                                                Products created for submodels by earlier syncs are intentionally not deleted automatically.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <transition name="akeneo-detail-slide">
                                    <div v-if="isAssociatedMode" class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="AssociatedProductAttributeId"></label>
                                                <select asp-for="AssociatedProductAttributeId"
                                                        class="form-control"
                                                        v-model="form.associatedProductAttributeId">
                                                    <option v-for="attribute in availableProductAttributes"
                                                            v-bind:key="attribute.value || 'empty'"
                                                            v-bind:value="attribute.value">
                                                        {{ attribute.text }}
                                                    </option>
                                                </select>
                                                <span asp-validation-for="AssociatedProductAttributeId"></span>
                                                <div class="form-text">
                                                    Required only for associated-to-product product attribute value mode.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="AssociatedValueNameTemplate"></label>
                                                <input asp-for="AssociatedValueNameTemplate"
                                                       class="form-control"
                                                       v-model="form.associatedValueNameTemplate"
                                                       placeholder="{attribute:variant_name}" />

                                                <span asp-validation-for="AssociatedValueNameTemplate"></span>

                                                <div class="form-text">
                                                    Supports {sku}, {identifier}, {axes}, {axis:attribute_code},
                                                    and {attribute:attribute_code}. Example:
                                                    {attribute:variant_name} ({sku})
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>

                                <transition name="akeneo-detail-slide">
                                    <div v-if="usesChildProducts" class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Child product visibility</label>
                                                <div>
                                                    <label class="akeneo-switch">
                                                        <input asp-for="HideChildProductsWhenRepresentedByParent"
                                                               type="checkbox"
                                                               v-model="form.hideChildProductsWhenRepresentedByParent" />
                                                        <span class="akeneo-switch-track">
                                                            <span class="akeneo-switch-thumb"></span>
                                                        </span>
                                                        <span class="akeneo-switch-text">
                                                            Hide child products when represented by parent
                                                        </span>
                                                    </label>
                                                </div>
                                                <span asp-validation-for="HideChildProductsWhenRepresentedByParent"></span>
                                                <div class="form-text">
                                                    Applies to grouped product and associated-to-product modes.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>
                            </div>
                        </div>
                    </div>

                    <transition name="akeneo-detail-slide">
                        <div v-if="isCombinationMode" class="card akeneo-mapping-card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-random"></i>
                                    Axis mappings
                                </h3>
                            </div>

                            <div class="card-body">
                                <div class="alert alert-info">
                                    Map each Akeneo variant axis to a nopCommerce product attribute.
                                    These mappings are used only for product attribute combination mode.
                                </div>

                                <div class="akeneo-list">
                                    <div class="akeneo-group-row">
                                        <a href="#"
                                           class="akeneo-attribute-group-toggle"
                                           v-bind:aria-expanded="axisMappingsOpen ? 'true' : 'false'"
                                           v-on:click.prevent="axisMappingsOpen = !axisMappingsOpen">
                                            <i class="fas fa-chevron-right chevron"></i>
                                            Axis mappings
                                            <span class="akeneo-group-count" v-text="form.axisMappings.length"></span>
                                        </a>

                                        <button type="button"
                                                class="btn btn-default ml-auto"
                                                v-on:click="addAxisMapping">
                                            <i class="fas fa-plus-square"></i>
                                            Add axis mapping
                                        </button>
                                    </div>

                                    <transition name="akeneo-detail-slide">
                                        <div v-show="axisMappingsOpen" class="akeneo-group-items">
                                            <div v-for="(row, index) in form.axisMappings"
                                                 v-bind:key="row.uid"
                                                 class="akeneo-row-shell">
                                                <div class="akeneo-row"
                                                     v-bind:class="axisRowClass(row)">
                                                    <div class="akeneo-col">
                                                        <div class="form-group mb-0">
                                                            <label>Akeneo attribute code</label>

                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'Id')"
                                                                   v-bind:value="row.id" />

                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'FamilyVariantImportConfigurationId')"
                                                                   v-bind:value="row.familyVariantImportConfigurationId" />

                                                            <input type="text"
                                                                   class="form-control"
                                                                   v-bind:name="axisName(index, 'AkeneoAttributeCode')"
                                                                   v-model="row.akeneoAttributeCode"
                                                                   placeholder="color" />
                                                        </div>
                                                    </div>

                                                    <div class="akeneo-col">
                                                        <div class="form-group mb-0">
                                                            <label>nopCommerce product attribute</label>
                                                            <select class="form-control"
                                                                    v-bind:name="axisName(index, 'NopProductAttributeId')"
                                                                    v-model.number="row.nopProductAttributeId">
                                                                <option v-for="attribute in availableProductAttributes"
                                                                        v-bind:key="attribute.value || 'empty'"
                                                                        v-bind:value="numberOrEmpty(attribute.value)">
                                                                    {{ attribute.text }}
                                                                </option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="akeneo-col">
                                                        <label class="akeneo-switch">
                                                            <input type="hidden"
                                                                   v-bind:name="axisName(index, 'IsRequired')"
                                                                   value="false" />
                                                            <input type="checkbox"
                                                                   v-bind:name="axisName(index, 'IsRequired')"
                                                                   value="true"
                                                                   v-model="row.isRequired" />
                                                            <span class="akeneo-switch-track">
                                                                <span class="akeneo-switch-thumb"></span>
                                                            </span>
                                                            <span class="akeneo-switch-text">
                                                                {{ row.isRequired ? 'Required' : 'Optional' }}
                                                            </span>
                                                        </label>
                                                    </div>

                                                    <div class="akeneo-col">
                                                        <div class="form-group mb-0">
                                                            <label>Display order</label>
                                                            <input type="number"
                                                                   class="form-control"
                                                                   v-bind:name="axisName(index, 'DisplayOrder')"
                                                                   v-model.number="row.displayOrder" />
                                                        </div>
                                                    </div>

                                                    <div class="akeneo-col akeneo-col-actions">
                                                        <button type="button"
                                                                class="btn btn-default"
                                                                v-on:click="removeAxisMapping(index)">
                                                            <i class="far fa-trash-alt"></i>
                                                            Remove
                                                        </button>
                                                    </div>
                                                </div>

                                                <transition name="akeneo-detail-slide">
                                                    <div v-if="axisRowNeedsAttention(row)" class="akeneo-mapping-detail">
                                                        <div class="akeneo-row-errors mb-0">
                                                            <i class="fas fa-exclamation-triangle akeneo-row-errors-icon"></i>
                                                            <div>
                                                                <div class="akeneo-row-errors-title">
                                                                    Mapping is incomplete
                                                                </div>
                                                                <ul>
                                                                    <li v-if="!row.akeneoAttributeCode">
                                                                        Akeneo attribute code is required.
                                                                    </li>
                                                                    <li v-if="!row.nopProductAttributeId">
                                                                        nopCommerce product attribute is required.
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </transition>
                                            </div>
                                        </div>
                                    </transition>
                                </div>
                            </div>
                        </div>
                    </transition>

                    <div class="card akeneo-mapping-card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-code-branch"></i>
                                Sub-model override rules
                            </h3>
                        </div>

                        <div class="card-body">
                            @* <div class="alert alert-info">
                                Rules are checked in display-order sequence. The first matching rule overrides the family's
                                normal variant relationship mode. A sub-model condition is evaluated against the leaf product's
                                parent product model; a variant condition is evaluated against the leaf variant itself.
                            </div> *@

                            <div class="akeneo-list">
                                <div class="akeneo-group-row">
                                    <a href="#"
                                       class="akeneo-attribute-group-toggle"
                                       v-bind:aria-expanded="subModelRulesOpen ? 'true' : 'false'"
                                       v-on:click.prevent="subModelRulesOpen = !subModelRulesOpen">
                                        <i class="fas fa-chevron-right chevron"></i>
                                        Override rules
                                        <span class="akeneo-group-count" v-text="form.subModelRules.length"></span>
                                    </a>

                                    <button type="button"
                                            class="btn btn-default ml-auto"
                                            v-on:click="addSubModelRule">
                                        <i class="fas fa-plus-square"></i>
                                        Add override rule
                                    </button>
                                </div>

                                <transition name="akeneo-detail-slide">
                                    <div v-show="subModelRulesOpen" class="akeneo-group-items">
                                        <div v-if="form.subModelRules.length === 0"
                                             class="alert alert-secondary mt-3 mb-0">
                                            No sub-model overrides are configured. The family-level relationship mode will be used.
                                        </div>

                                        <div v-for="(row, index) in form.subModelRules"
                                             v-bind:key="row.uid"
                                             class="akeneo-row-shell">
                                            <div class="akeneo-row"
                                                 v-bind:class="subModelRuleRowClass(row)">
                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Sub-model axis</label>

                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'Id')"
                                                               v-bind:value="row.id" />

                                                        <input type="hidden"
                                                               v-bind:name="subModelRuleName(index, 'FamilyMappingId')"
                                                               v-bind:value="row.familyMappingId" />

                                                        <select class="form-control"
                                                                v-bind:name="subModelRuleName(index, 'AkeneoAxisAttributeCode')"
                                                                v-model="row.akeneoAxisAttributeCode"
                                                                v-on:change="loadSubModelAttributeOptions(row, true)">
                                                            <option v-for="attribute in availableSubModelAxisAttributes"
                                                                    v-bind:key="attribute.value || 'empty-submodel'"
                                                                    v-bind:value="attribute.value">
                                                                {{ attribute.text }}
                                                            </option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Sub-model value</label>

                                                        <select v-if="row.subModelSupportsOptions"
                                                                class="form-control"
                                                                v-bind:name="subModelRuleName(index, 'TriggerValue')"
                                                                v-model="row.triggerValue"
                                                                v-bind:disabled="
                                                                    !row.akeneoAxisAttributeCode ||
                                                                    row.subModelOptionsLoading">
                                                            <option value="">
                                                                {{
                                                                    row.subModelOptionsLoading
                                                                        ? 'Loading values...'
                                                                        : 'Select a value'
                                                                }}
                                                            </option>

                                                            <option v-for="option in row.subModelOptions"
                                                                    v-bind:key="option.value"
                                                                    v-bind:value="option.value">
                                                                {{ option.text }}
                                                            </option>
                                                        </select>

                                                        <input v-else
                                                               type="text"
                                                               class="form-control"
                                                               v-bind:name="subModelRuleName(index, 'TriggerValue')"
                                                               v-model.trim="row.triggerValue"
                                                               v-bind:disabled="!row.akeneoAxisAttributeCode"
                                                               placeholder="Value to match" />
                                                    </div>
                                                </div>

                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Variant attribute</label>

                                                        <select class="form-control"
                                                                v-bind:name="subModelRuleName(index, 'VariantAxisAttributeCode')"
                                                                v-model="row.variantAxisAttributeCode"
                                                                v-on:change="loadVariantAttributeOptions(row, true)">
                                                            <option value="">No variant condition</option>

                                                            <option v-for="attribute in availableVariantAttributes"
                                                                    v-bind:key="attribute.value || 'empty-variant'"
                                                                    v-bind:value="attribute.value">
                                                                {{ attribute.text }}
                                                            </option>
                                                        </select>

                                                      @*   <div class="form-text">
                                                            Select a simple-select attribute stored on the leaf variant.
                                                        </div> *@
                                                    </div>
                                                </div>

                                                <div class="akeneo-col">
                                                    <div class="form-group mb-0">
                                                        <label>Variant value</label>

                                                        <select class="form-control"
                                                                v-bind:name="subModelRuleName(index, 'VariantTriggerValue')"
                                                                v-model="row.variantTriggerValue"
                                                                v-bind:disabled="
                                                            !row.variantAxisAttributeCode ||
                                                            row.variantOptionsLoading">
                                                            <option value="">
                                                                {{
                                                                row.variantOptionsLoading
                                                                ? 'Loading values...'
                                                                : 'Select a value'
                                                                }}
                                                            </option>

                                                            <option v-for="option in row.variantOptions"
                                                                    v-bind:key="option.value"
                                                                    v-bind:value="option.value">
                                                                {{ option.text }}
                                                            </option>
                                                        </select>

                                                       @*  <div class="form-text">
                                                            The Akeneo option code is saved, while the translated label is displayed.
                                                        </div> *@
                                                    </div>
                                                </div>

                                                <div class="akeneo-col akeneo-col-actions">
                                                    <button type="button"
                                                            class="btn btn-default"
                                                            v-on:click="removeSubModelRule(index)">
                                                        <i class="far fa-trash-alt"></i>
                                                        Remove
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="akeneo-mapping-detail">
                                                <div class="row">
                                                    <div class="col-md-5">
                                                        <div class="form-group mb-0">
                                                            <label>Relationship override</label>
                                                            <select class="form-control"
                                                                    v-bind:name="subModelRuleName(index, 'VariantRelationshipOverrideModeId')"
                                                                    v-model.number="row.variantRelationshipOverrideModeId">
                                                                <option v-for="mode in availableVariantRelationshipModes"
                                                                        v-bind:key="mode.value"
                                                                        v-bind:value="Number(mode.value)">
                                                                    {{ mode.text }}
                                                                </option>
                                                            </select>
                                                            <div class="form-text">
                                                                None imports a matching leaf as a standalone product when no existing variant structure must be preserved.
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <div class="form-group mb-0">
                                                            <label>Ancestor values</label>
                                                            <div>
                                                                <label class="akeneo-switch">
                                                                    <input type="hidden"
                                                                           v-bind:name="subModelRuleName(index, 'MergeAncestorValues')"
                                                                           value="false" />
                                                                    <input type="checkbox"
                                                                           v-bind:name="subModelRuleName(index, 'MergeAncestorValues')"
                                                                           value="true"
                                                                           v-model="row.mergeAncestorValues" />
                                                                    <span class="akeneo-switch-track">
                                                                        <span class="akeneo-switch-thumb"></span>
                                                                    </span>
                                                                    <span class="akeneo-switch-text">
                                                                        {{ row.mergeAncestorValues ? 'Merge ancestor values' : 'Leaf values only' }}
                                                                    </span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <div class="form-group mb-0">
                                                            <label>Display order</label>
                                                            <input type="number"
                                                                   class="form-control"
                                                                   min="0"
                                                                   v-bind:name="subModelRuleName(index, 'DisplayOrder')"
                                                                   v-model.number="row.displayOrder" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div v-if="subModelRuleNeedsAttention(row)"
                                                     class="akeneo-row-errors mt-3 mb-0">
                                                    <i class="fas fa-exclamation-triangle akeneo-row-errors-icon"></i>
                                                    <div>
                                                        <div class="akeneo-row-errors-title">
                                                            Override rule is incomplete
                                                        </div>
                                                        <ul>
                                                            <li v-if="!hasAnySubModelRuleCondition(row)">
                                                                Add at least one complete sub-model or variant condition.
                                                            </li>
                                                            <li v-if="Boolean(row.akeneoAxisAttributeCode) !== Boolean(row.triggerValue)">
                                                                The sub-model axis and trigger value must be supplied together.
                                                            </li>
                                                            <li v-if="Boolean(row.variantAxisAttributeCode) !== Boolean(row.variantTriggerValue)">
                                                                The variant axis and trigger value must be supplied together.
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </transition>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>

        @if (!isCreate)
        {
            <div v-if="showDeleteModal"
                 class="modal fade show"
                 style="display: block;"
                 tabindex="-1"
                 role="dialog"
                 aria-modal="true">
                <div class="modal-dialog" role="document">
                    <form asp-controller="AkeneoFamilyMapping"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Delete configuration</h5>
                                <button type="button"
                                        class="close"
                                        aria-label="Close"
                                        v-on:click="showDeleteModal = false">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                Are you sure you want to delete this family variant import configuration?
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-default"
                                        v-on:click="showDeleteModal = false">
                                    Cancel
                                </button>

                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div v-if="showDeleteModal"
                 class="modal-backdrop fade show"
                 v-on:click="showDeleteModal = false"></div>
        }
    </div>
</div>

<script>
    (() => {
        const { createApp } = Vue;

        const initialModel = @Html.Raw(vueModelJson);

        createApp({
            data() {
                return {
                    showDeleteModal: false,
                    axisMappingsOpen: true,
                    subModelRulesOpen: true,
                    modes: {
                        none: @((int)AkeneoVariantRelationshipMode.None),
                        combinations: @((int)AkeneoVariantRelationshipMode.ProductAttributeCombinations),
                        associated: @((int)AkeneoVariantRelationshipMode.AssociatedToProductAttributeValue),
                        grouped: @((int)AkeneoVariantRelationshipMode.GroupedProducts)
                    },
                    availableProductAttributes: initialModel.availableProductAttributes,
                    availableAkeneoFamilies: initialModel.availableAkeneoFamilies,
                    availableSubModelAxisAttributes: initialModel.availableSubModelAxisAttributes,
                    availableVariantAttributes: initialModel.availableVariantAttributes,
                    availableVariantRelationshipModes: initialModel.availableVariantRelationshipModes,
                    availableProductModelHierarchyModes: initialModel.availableProductModelHierarchyModes,
                    form: {
                        ...initialModel,
                        associatedProductAttributeId: initialModel.associatedProductAttributeId ?? '',
                        axisMappings: initialModel.axisMappings.map((row, index) => ({
                            uid: `${Date.now()}-axis-${index}`,
                            id: row.id || 0,
                            familyVariantImportConfigurationId: row.familyVariantImportConfigurationId || initialModel.id || 0,
                            akeneoAttributeCode: row.akeneoAttributeCode || '',
                            nopProductAttributeId: row.nopProductAttributeId || '',
                            isRequired: row.isRequired !== false,
                            displayOrder: row.displayOrder || index + 1
                        })),
                            subModelRules: initialModel.subModelRules.map((row, index) => ({
                            uid: `${Date.now()}-rule-${index}`,
                            id: row.id || 0,
                            familyMappingId: row.familyMappingId || initialModel.id || 0,
                            akeneoAxisAttributeCode: row.akeneoAxisAttributeCode || '',
                            triggerValue: row.triggerValue || '',
                            variantAxisAttributeCode: row.variantAxisAttributeCode || '',
                            variantTriggerValue: row.variantTriggerValue || '',
                            variantRelationshipOverrideModeId:
                                Number(row.variantRelationshipOverrideModeId ??
                                    @((int)AkeneoVariantRelationshipMode.None)),
                            mergeAncestorValues: row.mergeAncestorValues !== false,
                            displayOrder: row.displayOrder || index + 1,

                            // UI-only properties
                            subModelOptions: [],
                            subModelOptionsLoading: false,
                            subModelSupportsOptions: false,
                            variantOptions: [],
                            variantOptionsLoading: false
                        }))
                    }
                };
            },

            computed: {
                isCombinationMode() {
                    return Number(this.form.variantRelationshipModeId) === this.modes.combinations;
                },

                isAssociatedMode() {
                    return Number(this.form.variantRelationshipModeId) === this.modes.associated;
                },

                isGroupedMode() {
                    return Number(this.form.variantRelationshipModeId) === this.modes.grouped;
                },

                usesChildProducts() {
                    return this.isAssociatedMode || this.isGroupedMode;
                }
            },

            watch: {
                'form.akeneoFamilyCode': function (
                    newFamilyCode,
                    oldFamilyCode) {

                    if (newFamilyCode === oldFamilyCode)
                        return;

                    this.loadFamilyRuleFields(newFamilyCode);
                }
            },

            async mounted() {
                if (this.form.axisMappings.length === 0)
                    this.addAxisMapping();

                if (this.form.akeneoFamilyCode) {
                    await this.loadFamilyRuleFields(
                        this.form.akeneoFamilyCode);
                }
            },

            methods: {
                newUid() {
                    return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
                },
                async loadFamilyRuleFields(familyCode) {
                    const emptySubModelOption = {
                        text: 'No sub-model condition',
                        value: ''
                    };

                    if (!familyCode) {
                        this.availableSubModelAxisAttributes = [
                            emptySubModelOption
                        ];

                        this.availableVariantAttributes = [];

                        this.form.subModelRules.forEach(row => {
                            row.subModelOptions = [];
                            row.subModelOptionsLoading = false;
                            row.subModelSupportsOptions = false;
                            row.variantOptions = [];
                            row.variantOptionsLoading = false;
                        });

                        return;
                    }

                    try {
                        const separator =
                            initialModel.familyRuleFieldsUrl.includes('?')
                                ? '&'
                                : '?';

                        const response = await fetch(
                            `${initialModel.familyRuleFieldsUrl}` +
                            `${separator}familyCode=${encodeURIComponent(familyCode)}`,
                            {
                                method: 'GET',
                                headers: {
                                    Accept: 'application/json'
                                }
                            });

                        if (!response.ok) {
                            throw new Error(
                                `Unable to load family rule fields. ` +
                                `HTTP ${response.status}.`
                            );
                        }

                        const result = await response.json();

                        this.availableSubModelAxisAttributes = [
                            emptySubModelOption,
                            ...(result.subModelAxes || [])
                        ];

                        this.availableVariantAttributes =
                            result.variantAttributes || [];

                        this.preserveSelectedRuleAttributeOptions();

                        await Promise.all(
                            this.form.subModelRules.flatMap(row => [
                                this.loadSubModelAttributeOptions(row, false),
                                this.loadVariantAttributeOptions(row, false)
                            ])
                        );
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo family rule fields.',
                            error);

                        this.preserveSelectedRuleAttributeOptions();
                    }
                },
                async loadSubModelAttributeOptions(
                    row,
                    clearSelectedValue = false) {

                    if (clearSelectedValue)
                        row.triggerValue = '';

                    row.subModelOptions = [];
                    row.subModelSupportsOptions =
                        this.subModelAxisSupportsOptions(
                            row.akeneoAxisAttributeCode);

                    if (!row.akeneoAxisAttributeCode ||
                        !row.subModelSupportsOptions) {
                        row.subModelOptionsLoading = false;
                        return;
                    }

                    row.subModelOptionsLoading = true;

                    try {
                        row.subModelOptions = await this.fetchAttributeOptions(
                            row.akeneoAxisAttributeCode);

                        this.preserveSelectedSubModelValue(row);
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo sub-model axis options.',
                            error);

                        this.preserveSelectedSubModelValue(row);
                    }
                    finally {
                        row.subModelOptionsLoading = false;
                    }
                },

                subModelAxisSupportsOptions(attributeCode) {
                    if (!attributeCode)
                        return false;

                    const attribute =
                        this.availableSubModelAxisAttributes.find(option =>
                            String(option.value).toLowerCase() ===
                            String(attributeCode).toLowerCase());

                    return attribute?.supportsOptions === true;
                },

                async fetchAttributeOptions(attributeCode) {
                    const separator =
                        initialModel.attributeOptionsUrl.includes('?')
                            ? '&'
                            : '?';

                    const response = await fetch(
                        `${initialModel.attributeOptionsUrl}` +
                        `${separator}attributeCode=` +
                        `${encodeURIComponent(attributeCode)}`,
                        {
                            method: 'GET',
                            headers: {
                                Accept: 'application/json'
                            }
                        });

                    if (!response.ok) {
                        throw new Error(
                            `Unable to load attribute options. ` +
                            `HTTP ${response.status}.`
                        );
                    }

                    return await response.json();
                },

                    async loadVariantAttributeOptions(row, clearSelectedValue = false) {

                    if (clearSelectedValue)
                        row.variantTriggerValue = '';

                    row.variantOptions = [];

                    if (!row.variantAxisAttributeCode)
                        return;

                    row.variantOptionsLoading = true;

                    try {
                        row.variantOptions = await this.fetchAttributeOptions(
                            row.variantAxisAttributeCode);

                        this.preserveSelectedVariantValue(row);
                    }
                    catch (error) {
                        console.error(
                            'Unable to load Akeneo attribute options.',
                            error);

                        this.preserveSelectedVariantValue(row);
                    }
                    finally {
                        row.variantOptionsLoading = false;
                    }
                },
                preserveSelectedRuleAttributeOptions() {
                    this.form.subModelRules.forEach(row => {
                        this.addMissingOption(
                            this.availableSubModelAxisAttributes,
                            row.akeneoAxisAttributeCode);

                        this.addMissingOption(
                            this.availableVariantAttributes,
                            row.variantAxisAttributeCode);
                    });
                },

                addMissingOption(options, code) {
                    if (!code)
                        return;

                    const exists = options.some(option =>
                        String(option.value).toLowerCase() ===
                        String(code).toLowerCase());

                    if (exists)
                        return;

                    options.push({
                        text: `${code} (not currently returned by Akeneo)`,
                        value: code,
                        supportsOptions: false
                    });
                },

                addAxisMapping() {
                    this.form.axisMappings.push({
                        uid: this.newUid(),
                        id: 0,
                        familyVariantImportConfigurationId: this.form.id || 0,
                        akeneoAttributeCode: '',
                        nopProductAttributeId: '',
                        isRequired: true,
                        displayOrder: this.form.axisMappings.length + 1
                    });

                    this.axisMappingsOpen = true;
                },

                removeAxisMapping(index) {
                    this.form.axisMappings.splice(index, 1);

                    this.form.axisMappings.forEach((row, rowIndex) => {
                        if (!row.displayOrder)
                            row.displayOrder = rowIndex + 1;
                    });
                },
                preserveSelectedSubModelValue(row) {
                    const selectedValue = row.triggerValue;

                    if (!selectedValue)
                        return;

                    const exists = row.subModelOptions.some(option =>
                        String(option.value).toLowerCase() ===
                        String(selectedValue).toLowerCase());

                    if (exists)
                        return;

                    row.subModelOptions.push({
                        text: `${selectedValue} (not currently returned by Akeneo)`,
                        value: selectedValue
                    });
                },

                preserveSelectedVariantValue(row) {
                    const selectedValue = row.variantTriggerValue;

                    if (!selectedValue)
                        return;

                    const exists = row.variantOptions.some(option =>
                        String(option.value).toLowerCase() ===
                        String(selectedValue).toLowerCase());

                    if (exists)
                        return;

                    row.variantOptions.push({
                        text: `${selectedValue} (not currently returned by Akeneo)`,
                        value: selectedValue
                    });
                },

                addSubModelRule() {
                    this.form.subModelRules.push({
                        uid: this.newUid(),
                        id: 0,
                        familyMappingId: this.form.id || 0,
                        akeneoAxisAttributeCode: '',
                        triggerValue: '',
                        variantAxisAttributeCode: '',
                        variantTriggerValue: '',
                        variantRelationshipOverrideModeId: this.modes.none,
                        mergeAncestorValues: true,
                        displayOrder: this.form.subModelRules.length + 1,

                        subModelOptions: [],
                        subModelOptionsLoading: false,
                        subModelSupportsOptions: false,
                        variantOptions: [],
                        variantOptionsLoading: false
                    });

                    this.subModelRulesOpen = true;
                },

                removeSubModelRule(index) {
                    this.form.subModelRules.splice(index, 1);

                    this.form.subModelRules.forEach((row, rowIndex) => {
                        if (!row.displayOrder)
                            row.displayOrder = rowIndex + 1;
                    });
                },

                axisName(index, propertyName) {
                    return `AxisMappings[${index}].${propertyName}`;
                },

                subModelRuleName(index, propertyName) {
                    return `SubModelRules[${index}].${propertyName}`;
                },

                numberOrEmpty(value) {
                    if (value === null || value === undefined || value === '')
                        return '';

                    return Number(value);
                },

                axisRowNeedsAttention(row) {
                    return !row.akeneoAttributeCode || !row.nopProductAttributeId;
                },

                axisRowClass(row) {
                    if (this.axisRowNeedsAttention(row))
                        return 'is-attention';

                    return 'is-mapped';
                },

                hasAnySubModelRuleCondition(row) {
                    const hasSubModelCondition = Boolean(row.akeneoAxisAttributeCode) && Boolean(row.triggerValue);
                    const hasVariantCondition = Boolean(row.variantAxisAttributeCode) && Boolean(row.variantTriggerValue);
                    return hasSubModelCondition || hasVariantCondition;
                },

                subModelRuleNeedsAttention(row) {
                    if (!this.hasAnySubModelRuleCondition(row))
                        return true;

                    if (Boolean(row.akeneoAxisAttributeCode) !== Boolean(row.triggerValue))
                        return true;

                    return Boolean(row.variantAxisAttributeCode) !== Boolean(row.variantTriggerValue);
                },

                subModelRuleRowClass(row) {
                    return this.subModelRuleNeedsAttention(row)
                        ? 'is-attention'
                        : 'is-mapped';
                }
            }
        }).mount('#akeneo-family-variant-config-edit-app');
    })();
</script>