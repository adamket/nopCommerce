@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoSyncRunListModel
<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Akeneo Sync Logs";

    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
   // NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Libraries/Vue/vue.global.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.SyncLogs");

    var appModel = new
    {
        runsUrl = Url.Action("Runs", "AkeneoSyncLog"),
        itemsUrl = Url.Action("RunItems", "AkeneoSyncLog"),
        productEditBase = Url.Content("~/Admin/Product/Edit/"),
        runsPageSize = Model.SyncRunRecordPageSize,
        itemsPageSize = Model.SyncItemLogPageSize
    };
}

<div class="akeneo-connection">
    @Html.AntiForgeryToken()

    <div class="content-header clearfix">
        <div class="float-left">
            <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
            <h1 class="m-0">Sync Logs</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div id="akeneo-sync-log-app" class="akeneo-sync-log card card-default" v-cloak>
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-clipboard-list"></i>
                        Sync Runs
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="p-4" v-if="runsLoading && !runs.length">
                        <div class="akeneo-detail-status">Loading sync runs&hellip;</div>
                    </div>
                    <div class="p-4" v-else-if="runsError">
                        <div class="alert alert-danger mb-0">{{ runsError }}</div>
                    </div>
                    <div class="p-4" v-else-if="!runs.length">
                        <div class="alert alert-info mb-0">No sync runs have been recorded yet.</div>
                    </div>

                    <table class="table table-hover mb-0 akeneo-run-table" v-else>
                        <thead>
                            <tr>
                                <th class="akeneo-chevron-cell"></th>
                                <th>Started (local)</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="text-right">Read</th>
                                <th class="text-right">Created</th>
                                <th class="text-right">Updated</th>
                                <th class="text-right">Skipped</th>
                                <th class="text-right">Failed</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template v-for="run in runs" :key="run.id">
                                <tr class="akeneo-run-row" v-bind:class="{ 'is-open': run.open }" v-on:click="toggle(run)">
                                    <td class="akeneo-chevron-cell"><i class="fas fa-chevron-right chevron"></i></td>
                                    <td class="akeneo-dim">{{ run.startedOn }}</td>
                                    <td>{{ run.syncType }}</td>
                                    <td><span class="badge" v-bind:class="statusClass(run.status)">{{ run.status }}</span></td>
                                    <td class="text-right">{{ run.totalRead }}</td>
                                    <td class="text-right">{{ run.createdCount }}</td>
                                    <td class="text-right">{{ run.updatedCount }}</td>
                                    <td class="text-right">{{ run.skippedCount }}</td>
                                    <td class="text-right">
                                        <span v-bind:class="{ 'text-danger font-weight-bold': run.failedCount > 0 }">{{ run.failedCount }}</span>
                                    </td>
                                </tr>

                                <tr v-if="run.open" class="akeneo-detail-row">
                                    <td></td>
                                    <td colspan="8" class="akeneo-run-detail">
                                        <div class="akeneo-run-detail-inner">
                                            <div v-if="run.errorSummary" class="alert alert-danger py-2 mb-3">
                                                <button v-if="isLongMessage(run.errorSummary)" type="button" class="akeneo-message-preview"
                                                        v-on:click.stop="showRunErrorSummary(run.errorSummary)" aria-haspopup="dialog">
                                                    {{ messagePreview(run.errorSummary) }}
                                                    <span class="akeneo-message-more">View full message</span>
                                                </button>
                                                <akeneo-error-summary v-else :message="run.errorSummary" :product-edit-base="productEditBase"></akeneo-error-summary>
                                            </div>
                                            <div v-if="run.availableActions.length" class="akeneo-status-filter" role="group" aria-label="Filter items by status">
                                                <span class="akeneo-status-filter-label">Status</span>
                                                <button type="button"
                                                        v-for="({ action, count }) in run.availableActions"
                                                        :key="action"
                                                        class="akeneo-status-chip"
                                                        v-bind:class="[actionChipClass(action), { 'is-active': run.actionFilter.indexOf(action) >= 0 }]"
                                                        v-bind:aria-pressed="run.actionFilter.indexOf(action) >= 0 ? 'true' : 'false'"
                                                        v-on:click="toggleActionFilter(run, action)">
                                                    <i class="fas" v-bind:class="run.actionFilter.indexOf(action) >= 0 ? 'fa-check-square' : 'fa-square'"></i>
                                                    {{ action }}
                                                    <span class="akeneo-status-chip-count">{{ count }}</span>
                                                </button>
                                                <button type="button" class="btn btn-link btn-sm akeneo-status-filter-clear"
                                                        v-bind:class="{ 'is-hidden': !run.actionFilter.length }"
                                                        v-bind:tabindex="run.actionFilter.length ? null : -1"
                                                        v-bind:aria-hidden="run.actionFilter.length ? null : 'true'"
                                                        v-on:click="clearActionFilter(run)">
                                                    Show all
                                                </button>
                                            </div>
                                            <div v-if="run.loading && !run.loaded" class="akeneo-detail-status">Loading items&hellip;</div>
                                            <div v-else-if="run.loadError" class="akeneo-detail-status text-danger">{{ run.loadError }}</div>
                                            <div v-else-if="run.loaded && !run.items.length" class="akeneo-detail-status">
                                                {{ run.actionFilter.length ? 'No item logs match the selected statuses.' : 'No item logs for this run.' }}
                                            </div>
                                            <div v-else class="akeneo-item-results" v-bind:class="{ 'is-refreshing': run.loading }" v-bind:aria-busy="run.loading ? 'true' : 'false'">
                                                <table class="table table-sm mb-0 akeneo-item-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Created (local)</th>
                                                            <th>Action</th>
                                                            <th>Identifier</th>
                                                            <th>Nop product</th>
                                                            <th>Message</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr v-for="item in run.items" :key="item.id">
                                                            <td class="akeneo-dim">{{ item.createdOn }}</td>
                                                            <td><span v-if="item.action" class="badge" v-bind:class="actionClass(item.action)">{{ item.action }}</span></td>
                                                            <td class="akeneo-mono">{{ item.akeneoIdentifier || item.akeneoProductUuid || '-' }}</td>
                                                            <td>
                                                                <a v-if="item.nopProductId > 0"
                                                                   :href="`/Admin/Product/Edit/${item.nopProductId}`">
                                                                    {{ item.nopProductId }}
                                                                </a>

                                                                <span v-else>-</span>
                                                            </td>
                                                            <td class="akeneo-msg">
                                                                <button v-if="item.isRunComplete || isLongMessage(item.message) || (item.nopProductId > 0 && item.message)" type="button" class="akeneo-message-preview"
                                                                        v-on:click.stop="showMessage(item.message, item.akeneoIdentifier || item.akeneoProductUuid || 'Sync message', item.isRunComplete ? 'RunComplete' : item.action, item.isRunComplete, item.nopProductId)"
                                                                        aria-haspopup="dialog">
                                                                    {{ messagePreview(item.message) }}
                                                                    <span class="akeneo-message-more">View full message</span>
                                                                </button>
                                                                <akeneo-product-message v-else :message="item.message" :product-edit-base="productEditBase"></akeneo-product-message>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>

                                                <div class="akeneo-pager akeneo-pager-sm" v-if="run.itemTotalPages > 1">
                                                    <button type="button" class="btn btn-sm btn-default"
                                                            v-on:click="loadItems(run, run.itemPage - 1)"
                                                            v-bind:disabled="run.itemPage <= 0 || run.loading">
                                                        <i class="fas fa-chevron-left"></i>
                                                        Previous
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-default"
                                                            v-on:click="loadItems(run, run.itemPage + 1)"
                                                            v-bind:disabled="run.itemPage >= run.itemTotalPages - 1 || run.loading">
                                                        Next
                                                        <i class="fas fa-chevron-right"></i>
                                                    </button>
                                                    <span class="akeneo-pager-info">
                                                        Page {{ run.itemPage + 1 }} of {{ run.itemTotalPages }} &middot;
                                                        {{ run.itemTotal }} item{{ run.itemTotal === 1 ? '' : 's' }}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>

                <div class="akeneo-pager" v-if="runs.length && runsTotalPages > 1">
                    <button type="button" class="btn btn-sm btn-default"
                            v-on:click="loadRuns(runsPage - 1)"
                            v-bind:disabled="runsPage <= 0 || runsLoading">
                        <i class="fas fa-chevron-left"></i>
                        Previous
                    </button>
                    <button type="button" class="btn btn-sm btn-default"
                            v-on:click="loadRuns(runsPage + 1)"
                            v-bind:disabled="runsPage >= runsTotalPages - 1 || runsLoading">
                        Next
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <span class="akeneo-pager-info">
                        Page {{ runsPage + 1 }} of {{ runsTotalPages }} &middot;
                        {{ runsTotal }} run{{ runsTotal === 1 ? '' : 's' }}
                    </span>
                </div>
                <transition name="akeneo-modal">
                <div v-if="messageVisible" ref="messageDialog" class="modal fade show akeneo-sync-message-modal"
                     style="display: block;" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="akeneo-sync-message-title"
                     v-on:click.self="closeMessage" v-on:keydown="messageKeydown">
                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header" v-bind:class="messageHeaderClass">
                                <h4 id="akeneo-sync-message-title" class="modal-title"><i class="fas fa-clipboard-list mr-2"></i>{{ messageTitle }}</h4>
                                <button type="button" class="close" style="color: inherit;" aria-label="Close message" v-on:click="closeMessage">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" tabindex="0" aria-label="Full message">
                                <akeneo-error-summary v-if="showingRunErrors" :message="messageText" :product-edit-base="productEditBase"></akeneo-error-summary>
                                <template v-else-if="messageBlocks">
                                    <div v-for="(block, index) in messageBlocks" :key="index" class="akeneo-completion-block">
                                        <div class="akeneo-message-full"><akeneo-product-message :message="block.text" :product-edit-base="productEditBase"></akeneo-product-message></div>
                                        <div v-if="block.ids.length" class="mt-1">
                                            <template v-for="(id, i) in block.ids" :key="i"><span v-if="i">, </span><a :href="productEditBase + id" target="_blank" rel="noopener noreferrer">{{ id }}</a></template>
                                        </div>
                                        <div v-if="block.detail" class="akeneo-message-full mt-1"><akeneo-product-message :message="block.detail" :product-edit-base="productEditBase"></akeneo-product-message></div>
                                    </div>
                                </template>
                                <template v-else>
                                    <div class="akeneo-message-full"><akeneo-product-message :parts="itemMessageParts" :product-edit-base="productEditBase"></akeneo-product-message></div>
                                    <div v-if="showItemProductLink" class="mt-2">nopCommerce product ID <a :href="productEditBase + messageProductId" target="_blank" rel="noopener noreferrer">{{ messageProductId }}</a></div>
                                </template>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light border" v-on:click="closeMessage">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
                </transition>
                <transition name="akeneo-backdrop">
                <div v-if="messageVisible" class="modal-backdrop fade show" v-on:click="closeMessage"></div>
                </transition>
            </div>
        </div>
    </section>
</div>

<script type="text/x-template" id="akeneo-error-summary-template">
    <div>
        <div v-for="(line, index) in messages" :key="index" class="akeneo-completion-block akeneo-message-full"><akeneo-product-message :message="line" :product-edit-base="productEditBase"></akeneo-product-message></div>
    </div>
</script>

<script id="akeneo-sync-log-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(appModel))</script>

<script asp-location="Footer">
    (function () {
        var appData = JSON.parse(document.getElementById('akeneo-sync-log-data').textContent);
        var messageReturnFocus = null;

        function completionBlocks(message) {
            // Older runs used single newlines between warning groups.
            var text = message.replace(/\r\n?/g, '\n')
                .replace(/^(Warnings:) */m, '\n$1\n\n')
                .replace(/^(Run complete .*?\.) Delta inclusion:/, '$1\n\nDelta inclusion:');
            return text.split(/\n[ \t]*\n+|\n(?=Products missing: |Related products:$|Cross-sell products:$)/m)
                .filter(function (block) { return block.trim().length > 0; })
                .map(function (block) {
                    var lines = block.split('\n');
                    if (lines[0].startsWith('Products missing: {') && /^[1-9]\d*(?:, [1-9]\d*)*$/.test(lines[1] || '')) {
                        return { text: lines[0], ids: lines[1].split(', '), detail: lines.slice(2).join('\n') };
                    }
                    return { text: block, ids: [], detail: '' };
                });
        }


        Vue.createApp({
            data: function () {
                return {
                    runs: [],
                    runsLoading: false,
                    runsError: null,
                    runsPage: 0,
                    runsTotalPages: 0,
                    runsTotal: 0,
                    messageVisible: false,
                    messageText: '',
                    messageProductId: null,
                    messageBlocks: null,
                    showingRunErrors: false,
                    productEditBase: appData.productEditBase,
                    messageTitle: '',
                    messageHeaderClass: ''
                };
            },
            computed: {
                itemMessageParts: function () { return AkeneoProductLog.productReferenceParts(this.messageText); },
                showItemProductLink: function () {
                    return this.messageProductId > 0 && !this.itemMessageParts.some(part => part.productId === String(this.messageProductId));
                }
            },
            mounted: function () {
                this.loadRuns(0);
            },
            methods: {
                isLongMessage: function (message) {
                    return !!message && (message.length > 220 || message.split(/\r?\n/).length > 3);
                },
                messagePreview: function (message) {
                    var text = (message || '').replace(/\s+/g, ' ').trim();
                    return text.length > 220 ? text.slice(0, 220) + '\u2026' : text;
                },
                showRunErrorSummary: function (message) {
                    this.showMessage(message, 'Run error summary', 'Failed');
                    this.showingRunErrors = true;
                },
                showMessage: function (message, title, action, isRunComplete, productId) {
                    this.messageProductId = productId || null;
                    this.showingRunErrors = false;
                    if (!this.messageVisible) {
                        messageReturnFocus = document.activeElement;
                    }
                    this.messageText = message || '';
                    this.messageBlocks = isRunComplete ? completionBlocks(this.messageText) : null;
                    this.messageTitle = title;
                    this.messageHeaderClass = {
                        Failed: 'akeneo-message-header-failed',
                        Skipped: 'akeneo-message-header-skipped',
                        Created: 'bg-success text-white',
                        RunComplete: 'bg-primary text-white',
                        Updated: 'bg-primary text-white'
                    }[action] || 'akeneo-message-header-skipped';
                    this.messageVisible = true;
                    this.$nextTick(function () {
                        if (this.messageVisible)
                            this.$refs.messageDialog.querySelector('button').focus();
                    });
                },
                closeMessage: function () {
                    this.messageVisible = false;
                    if (messageReturnFocus && messageReturnFocus.isConnected)
                        messageReturnFocus.focus();
                },
                messageKeydown: function (event) {
                    if (event.key === 'Escape') {
                        event.preventDefault();
                        this.closeMessage();
                    } else if (event.key === 'Tab') {
                        var controls = this.$refs.messageDialog.querySelectorAll('button, a[href], [tabindex="0"]');
                        var first = controls[0];
                        var last = controls[controls.length - 1];
                        if (event.shiftKey && document.activeElement === first) {
                            event.preventDefault();
                            last.focus();
                        } else if (!event.shiftKey && document.activeElement === last) {
                            event.preventDefault();
                            first.focus();
                        }
                    }
                },
                loadRuns: function (page) {
                    if (page < 0) return;
                    if (this.runsTotalPages && page > this.runsTotalPages - 1) return;

                    var self = this;
                    this.runsLoading = true;
                    this.runsError = null;

                    $.ajax({
                        type: 'POST',
                        url: appData.runsUrl,
                        data: addAntiForgeryToken({ page: page, pageSize: appData.runsPageSize }),
                        success: function (res) {
                            if (!res || !res.success) {
                                self.runsError = 'Unable to load sync runs.';
                                return;
                            }
                            self.runs = (res.runs || []).map(function (r) {
                                return Object.assign({}, r, {
                                    open: false,
                                    loaded: false,
                                    loading: false,
                                    loadError: null,
                                    items: [],
                                    actionFilter: [],
                                    availableActions: [],
                                    requestId: 0,
                                    itemPage: 0,
                                    itemTotalPages: 0,
                                    itemTotal: 0
                                });
                            });
                            self.runsPage = res.pageIndex;
                            self.runsTotalPages = res.totalPages;
                            self.runsTotal = res.totalCount;
                        },
                        error: function () {
                            self.runsError = 'Server error while loading sync runs.';
                        },
                        complete: function () {
                            self.runsLoading = false;
                        }
                    });
                },
                toggle: function (run) {
                    run.open = !run.open;
                    if (run.open && !run.loaded && !run.loading)
                        this.loadItems(run, 0);
                },
                loadItems: function (run, page) {
                    if (page < 0) return;
                    if (run.itemTotalPages && page > run.itemTotalPages - 1) return;

                    // Rapid filter clicks can overlap; only the newest response is applied.
                    var requestId = ++run.requestId;
                    var isCurrent = function () { return run.requestId === requestId; };

                    run.loading = true;
                    run.loadError = null;

                    $.ajax({
                        type: 'POST',
                        url: appData.itemsUrl,
                        data: addAntiForgeryToken({
                            syncRunRecordId: run.syncRunRecordId,
                            page: page,
                            pageSize: appData.itemsPageSize,
                            includeActionCounts: !run.loaded,
                            actions: run.actionFilter.join(',')
                        }),
                        success: function (res) {
                            if (!isCurrent()) return;
                            if (!res || !res.success) {
                                run.loadError = (res && res.errors && res.errors[0]) || 'Unable to load items.';
                                return;
                            }
                            if (res.availableActions) run.availableActions = res.availableActions;
                            run.items = res.items || [];
                            run.itemPage = res.pageIndex;
                            run.itemTotalPages = res.totalPages;
                            run.itemTotal = res.totalCount;
                            run.loaded = true;
                        },
                        error: function () {
                            if (!isCurrent()) return;
                            run.loadError = 'Server error while loading items.';
                        },
                        complete: function () {
                            if (isCurrent()) run.loading = false;
                        }
                    });
                },
                toggleActionFilter: function (run, action) {
                    var index = run.actionFilter.indexOf(action);
                    if (index >= 0)
                        run.actionFilter.splice(index, 1);
                    else
                        run.actionFilter.push(action);
                    this.reloadFilteredItems(run);
                },
                clearActionFilter: function (run) {
                    run.actionFilter.splice(0, run.actionFilter.length);
                    this.reloadFilteredItems(run);
                },
                reloadFilteredItems: function (run) {
                    // The filter changes the page count, so start again from the first page.
                    // The current rows stay on screen (dimmed) until the new page arrives,
                    // so the panel doesn't collapse and re-expand on every click.
                    run.itemTotalPages = 0;
                    this.loadItems(run, 0);
                },
                actionChipClass: function (action) {
                    return 'akeneo-status-chip-' + action.toLowerCase();
                },
                statusClass: function (status) {
                    switch (status) {
                        case 'Completed': return 'badge-success';
                        case 'CompletedWithWarnings': return 'badge-warning';
                        case 'Failed': return 'badge-danger';
                        case 'Cancelled': return 'badge-secondary';
                        default: return 'badge-info'; // Started
                    }
                },
                actionClass: function (action) {
                    switch (action) {
                        case 'Created': return 'badge-success';
                        case 'Updated': return 'badge-info';
                        case 'Failed': return 'badge-danger';
                        default: return 'badge-secondary'; // Skipped
                    }
                }
            }
        }).component('akeneo-product-message', AkeneoProductLog.component).component('akeneo-error-summary', {
            template: '#akeneo-error-summary-template',
            props: ['message', 'productEditBase'],
            computed: {
                messages: function () {
                    return this.message.split(/\r\n|[\r\n]/).filter(line => line.trim());
                }
            }
        }).mount('#akeneo-sync-log-app');
    })();
</script>
