@using Apt.Nop.Plugin.Misc.AkeneoConnection.Types
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Factories
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoAttributeMappingListModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddCssFileParts($"{AkeneoConstants.PathToPlugin}/Content/StyleSheets/akeneo-connection.admin.css");

    var appModel = new
    {
        saveUrl = Url.Action("SaveAttributeMappingRow", "AkeneoMapping"),
        targetTypes = new
        {
            ignore = (int)NopTargetType.Ignore,
            productField = (int)NopTargetType.ProductField,
            seoField = (int)NopTargetType.SeoField,
            customProperty = (int)NopTargetType.CustomProperty,
            specificationAttribute = (int)NopTargetType.SpecificationAttribute,
            productAttribute = (int)NopTargetType.ProductAttribute
        },
        mappings = Model.Mappings.Select((m, idx) => new
        {
            index = idx,
            id = m.Id,
            code = m.AkeneoAttributeCode,
            label = m.AkeneoAttributeLabel,
            type = m.AkeneoAttributeType,
            group = string.IsNullOrWhiteSpace(m.AkeneoAttributeGroup) ? "ungrouped" : m.AkeneoAttributeGroup,
            groupLabel = string.IsNullOrWhiteSpace(m.AkeneoAttributeGroupLabel) ? "Ungrouped" : m.AkeneoAttributeGroupLabel,
            attributeTypeId = m.AkeneoAttributeTypeId,
            isLocalizable = m.IsLocalizable,
            isScopable = m.IsScopable,
            nopTargetTypeId = m.NopTargetTypeId.ToString(),
            nopTargetKey = m.NopTargetKey ?? string.Empty,
            nopSpecificationAttributeId = m.NopSpecificationAttributeId?.ToString() ?? string.Empty,
            nopProductAttributeId = m.NopProductAttributeId?.ToString() ?? string.Empty,
            isRequired = m.IsRequired,
            transformRuleJson = m.TransformRuleJson ?? string.Empty,
            availableTargetTypes = m.AvailableTargetTypes.Select(o => new { value = o.Value, text = o.Text }),
            availableSpecificationAttributes = m.AvailableSpecificationAttributes.Select(o => new { value = o.Value, text = o.Text }),
            availableProductAttributes = m.AvailableProductAttributes.Select(o => new { value = o.Value, text = o.Text })
        }).ToList()
    };
}

<div class="akeneo-mapping">
    @Html.AntiForgeryToken()

    <div class="content-header clearfix">
        <div class="float-left">
            <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
            <h1 class="m-0">Attribute Mapping</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">

            @* Sync Context stays server-rendered so the nop tag helpers / store-scope keep working. *@
            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-sliders-h"></i>
                        Sync Context
                    </div>
                </div>

                <div class="card-body">
                    <p>Set the default Akeneo channel, locale, and currency used when resolving scoped values.</p>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="SelectedChannelId" /></div>
                        <div class="col-md-9">
                            <nop-select asp-for="SelectedChannelId" asp-items="Model.AvailableChannels" />
                            <span asp-validation-for="SelectedChannelId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="SelectedLocaleId" /></div>
                        <div class="col-md-9">
                            <nop-select asp-for="SelectedLocaleId" asp-items="Model.AvailableLocales" />
                            <span asp-validation-for="SelectedLocaleId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="SelectedCurrencyId" /></div>
                        <div class="col-md-9">
                            <nop-select asp-for="SelectedCurrencyId" asp-items="Model.AvailableCurrencies" />
                            <span asp-validation-for="SelectedCurrencyId"></span>
                        </div>
                    </div>
                </div>
            </div>

            @* Mappings table is owned by Vue. *@
            <div id="akeneo-mapping-app" class="card card-default" v-cloak>
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-project-diagram"></i>
                        Attribute Mappings
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="p-4" v-if="!mappings.length">
                        <div class="alert alert-info mb-0">
                            No Akeneo attributes were found. Check the Sync Context connection, then reload this page.
                        </div>
                    </div>

                    <div class="table-responsive" v-else>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col" style="width: 28%;">Attribute</th>
                                    <th scope="col" style="width: 18%;">Type</th>
                                    <th scope="col" style="width: 28%;">Maps to</th>
                                    <th scope="col" style="width: 12%;">Status</th>
                                    <th scope="col" style="width: 14%;"></th>
                                </tr>
                            </thead>

                            <tbody>
                                <template v-for="group in groups" :key="group.key">
                                    <tr class="akeneo-group-row">
                                        <td colspan="5">
                                            <button type="button"
                                                    class="btn btn-link p-0 akeneo-attribute-group-toggle"
                                                    v-bind:aria-expanded="isExpanded(group.key) ? 'true' : 'false'"
                                                    v-on:click="toggleGroup(group.key)">
                                                <i class="fas fa-chevron-right chevron"></i>
                                                <span>{{ group.label }}</span>
                                            </button>
                                            <span class="akeneo-group-count ml-2">{{ group.items.length }}</span>
                                            <span class="akeneo-group-code ml-2">{{ group.code }}</span>
                                        </td>
                                    </tr>

                                    <template v-for="m in group.items" :key="m.index">
                                        <tr v-show="isExpanded(group.key)"
                                            class="akeneo-mapping-summary-row"
                                            v-bind:class="statusFor(m).cls">
                                            <td>
                                                <div class="akeneo-code">{{ m.code }}</div>
                                                <div class="akeneo-label">{{ m.label }}</div>
                                            </td>

                                            <td>
                                                <span class="akeneo-type-chip">{{ m.type }}</span>
                                                <div class="akeneo-flags">
                                                    <span class="akeneo-flag" v-bind:class="{ on: m.isLocalizable }" title="Localizable">L</span>
                                                    <span class="akeneo-flag" v-bind:class="{ on: m.isScopable }" title="Scopable">S</span>
                                                </div>
                                            </td>

                                            <td>
                                                <div>
                                                    <i class="fas fa-arrow-right akeneo-maps-arrow"></i>
                                                    <span class="akeneo-summary-target-type">{{ targetTypeText(m) }}</span>
                                                </div>
                                                <div class="akeneo-summary-target-detail">{{ detail(m) }}</div>
                                            </td>

                                            <td>
                                                <span class="akeneo-status">{{ statusFor(m).text }}</span>
                                            </td>

                                            <td class="text-right">
                                                <span class="akeneo-summary-required">
                                                    <span class="badge" v-bind:class="m.isRequired ? 'badge-warning' : 'badge-secondary'">
                                                        {{ m.isRequired ? 'Required' : 'Optional' }}
                                                    </span>
                                                </span>
                                                <div class="mt-2">
                                                    <button type="button" class="btn btn-sm btn-primary akeneo-edit-row" v-on:click="edit(m)" v-show="!m.editing">Edit</button>
                                                    <button type="button" class="btn btn-sm btn-default akeneo-cancel-row" v-on:click="cancel(m)" v-show="m.editing">Cancel</button>
                                                </div>
                                            </td>
                                        </tr>

                                        <tr v-show="isExpanded(group.key) && m.editing" class="akeneo-mapping-edit-row">
                                            <td colspan="5">
                                                <div class="akeneo-mapping-detail">
                                                    <div class="form-row">
                                                        <div class="form-group col-md-4">
                                                            <label class="font-weight-bold mb-1">Target Type</label>
                                                            <select class="form-control akeneo-edit-target-type"
                                                                    v-model="m.draft.nopTargetTypeId"
                                                                    v-on:change="onTypeChange(m)">
                                                                <option v-for="o in m.availableTargetTypes" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-4 akeneo-detail-block" v-if="isKeyType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Target Key</label>
                                                            <select class="form-control akeneo-edit-target-key" v-model="m.draft.nopTargetKey">
                                                                <option value="">None</option>
                                                                <option v-for="o in keyOptions(m.draft.nopTargetTypeId)" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-4 akeneo-detail-block" v-if="isSpecType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Specification Attribute</label>
                                                            <select class="form-control akeneo-edit-specification-attribute" v-model="m.draft.nopSpecificationAttributeId">
                                                                <option v-for="o in m.availableSpecificationAttributes" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-4 akeneo-detail-block" v-if="isProductType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Product Attribute</label>
                                                            <select class="form-control akeneo-edit-product-attribute" v-model="m.draft.nopProductAttributeId">
                                                                <option v-for="o in m.availableProductAttributes" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-12 akeneo-detail-block akeneo-detail-none" v-if="isNoneType(m.draft.nopTargetTypeId)">
                                                            <span class="akeneo-none-hint">
                                                                <i class="fas fa-info-circle"></i>
                                                                This type maps on its own &mdash; no extra target to choose.
                                                            </span>
                                                        </div>

                                                        <div class="form-group col-md-4">
                                                            <label class="font-weight-bold mb-1">Require value during import</label>
                                                            <div>
                                                                <label class="akeneo-switch">
                                                                    <input type="checkbox" v-model="m.draft.isRequired" />
                                                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                                                    <span class="akeneo-switch-text">{{ m.draft.isRequired ? 'Required' : 'Optional' }}</span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="alert alert-danger akeneo-row-errors" v-if="m.errors.length">
                                                        <ul class="mb-0">
                                                            <li v-for="(err, eIdx) in m.errors" :key="eIdx">{{ err }}</li>
                                                        </ul>
                                                    </div>

                                                    <div class="mb-3">
                                                        <button class="btn btn-sm btn-default" type="button" v-on:click="m.draft.showTransform = !m.draft.showTransform">
                                                            {{ m.draft.transformRuleJson ? 'Edit transform JSON' : 'Add transform JSON' }}
                                                        </button>
                                                        <span class="badge badge-info ml-2" v-if="m.draft.transformRuleJson">Transform configured</span>

                                                        <div class="mt-2" v-show="m.draft.showTransform">
                                                            <textarea class="form-control akeneo-edit-transform-json" rows="3" placeholder="{ }" v-model="m.draft.transformRuleJson"></textarea>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <button type="button" class="btn btn-sm btn-primary akeneo-save-row" v-on:click="save(m)" v-bind:disabled="m.saving">Save</button>
                                                        <span class="akeneo-row-saving ml-2" v-show="m.saving">Saving...</span>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </template>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Toast stack (fixed-position, floats regardless of where it sits in the DOM). *@
                <div class="akeneo-toast-container" aria-live="polite" aria-atomic="true">
                    <transition-group name="akeneo-toast">
                        <div v-for="t in toasts" :key="t.id" class="akeneo-toast" v-on:click="dismissToast(t.id)">
                            <i class="fas fa-check-circle"></i>
                            <span>{{ t.text }}</span>
                        </div>
                    </transition-group>
                </div>
            </div>

            @if (Model.Warnings?.Any() == true)
            {
                <div class="alert alert-warning">
                    <ul class="mb-0">
                        @foreach (var warning in Model.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

<script id="akeneo-app-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(appModel))</script>
<script id="akeneo-target-key-map" type="application/json">@Html.Raw(AkeneoMappingModelFactory.GetNopTargetKeyMapJson())</script>

@* Self-host instead for an offline/locked-down admin: drop vue.global.prod.js into the plugin and register it with NopHtml.AddScriptParts. *@
<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

<script>
    (function () {
        var appData = JSON.parse(document.getElementById('akeneo-app-data').textContent);
        var targetKeyMap = JSON.parse(document.getElementById('akeneo-target-key-map').textContent);

        var mappings = appData.mappings.map(function (m) {
            return Object.assign({}, m, {
                editing: false,
                saving: false,
                errors: [],
                draft: {
                    nopTargetTypeId: m.nopTargetTypeId,
                    nopTargetKey: m.nopTargetKey,
                    nopSpecificationAttributeId: m.nopSpecificationAttributeId,
                    nopProductAttributeId: m.nopProductAttributeId,
                    isRequired: m.isRequired,
                    transformRuleJson: m.transformRuleJson,
                    showTransform: !!(m.transformRuleJson && m.transformRuleJson.trim())
                }
            });
        });

        Vue.createApp({
            data: function () {
                return {
                    mappings: mappings,
                    targetTypes: appData.targetTypes,
                    targetKeyMap: targetKeyMap,
                    expanded: {},
                    toasts: []
                };
            },
            computed: {
                groups: function () {
                    var map = {};
                    this.mappings.forEach(function (m) {
                        var key = m.groupLabel || 'Ungrouped';
                        if (!map[key]) {
                            map[key] = { key: key, label: key, code: m.group, items: [] };
                        }
                        map[key].items.push(m);
                    });
                    return Object.values(map).sort(function (a, b) {
                        return a.label.localeCompare(b.label);
                    });
                }
            },
            methods: {
                isExpanded: function (key) {
                    return !!this.expanded[key];
                },
                toggleGroup: function (key) {
                    this.expanded[key] = !this.expanded[key];
                },
                keyOptions: function (typeId) {
                    return this.targetKeyMap[String(typeId)] || [];
                },
                isKeyType: function (t) {
                    t = Number(t);
                    return t === this.targetTypes.productField
                        || t === this.targetTypes.seoField
                        || t === this.targetTypes.customProperty;
                },
                isSpecType: function (t) {
                    return Number(t) === this.targetTypes.specificationAttribute;
                },
                isProductType: function (t) {
                    return Number(t) === this.targetTypes.productAttribute;
                },
                isNoneType: function (t) {
                    return !this.isKeyType(t) && !this.isSpecType(t) && !this.isProductType(t);
                },
                targetTypeText: function (m) {
                    var found = m.availableTargetTypes.find(function (o) { return o.value === m.nopTargetTypeId; });
                    return found ? found.text : 'Ignore';
                },
                detail: function (m) {
                    var t = Number(m.nopTargetTypeId);

                    if (this.isKeyType(t)) {
                        var k = this.keyOptions(t).find(function (o) { return o.value === m.nopTargetKey; });
                        return (m.nopTargetKey && k) ? 'Target Key: ' + k.text : 'No target key selected';
                    }
                    if (this.isSpecType(t)) {
                        var s = m.availableSpecificationAttributes.find(function (o) { return o.value === m.nopSpecificationAttributeId; });
                        return (m.nopSpecificationAttributeId && s) ? 'Specification Attribute: ' + s.text : 'No specification attribute selected';
                    }
                    if (this.isProductType(t)) {
                        var p = m.availableProductAttributes.find(function (o) { return o.value === m.nopProductAttributeId; });
                        return (m.nopProductAttributeId && p) ? 'Product Attribute: ' + p.text : 'No product attribute selected';
                    }
                    return 'No additional target selected';
                },
                statusFor: function (m) {
                    if (Number(m.nopTargetTypeId) === this.targetTypes.ignore) {
                        return { cls: 'is-ignored', text: 'Ignored' };
                    }
                    return Number(m.id) > 0
                        ? { cls: 'is-mapped', text: 'Mapped' }
                        : { cls: 'is-attention', text: 'Unsaved' };
                },
                edit: function (m) {
                    // Reset the draft from the saved state so reopening after a cancel is clean.
                    m.draft.nopTargetTypeId = m.nopTargetTypeId;
                    m.draft.nopTargetKey = m.nopTargetKey;
                    m.draft.nopSpecificationAttributeId = m.nopSpecificationAttributeId;
                    m.draft.nopProductAttributeId = m.nopProductAttributeId;
                    m.draft.isRequired = m.isRequired;
                    m.draft.transformRuleJson = m.transformRuleJson;
                    m.errors = [];
                    m.editing = true;
                },
                cancel: function (m) {
                    m.editing = false;
                },
                onTypeChange: function (m) {
                    // Drop a now-invalid target key when the type changes.
                    var valid = this.keyOptions(m.draft.nopTargetTypeId).some(function (o) {
                        return o.value === m.draft.nopTargetKey;
                    });
                    if (!valid) {
                        m.draft.nopTargetKey = '';
                    }
                },
                notify: function (text) {
                    var self = this;
                    var id = Date.now() + '-' + Math.random().toString(36).slice(2);
                    this.toasts.push({ id: id, text: text });
                    setTimeout(function () {
                        self.dismissToast(id);
                    }, 3000);
                },
                dismissToast: function (id) {
                    this.toasts = this.toasts.filter(function (t) { return t.id !== id; });
                },
                save: function (m) {
                    var self = this;
                    var d = m.draft;
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    m.errors = [];
                    m.saving = true;

                    $.ajax({
                        type: 'POST',
                        url: appData.saveUrl,
                        data: addAntiForgeryToken({
                            Id: m.id,
                            AkeneoAttributeCode: m.code,
                            AkeneoAttributeTypeId: m.attributeTypeId,
                            NopTargetTypeId: d.nopTargetTypeId,
                            NopTargetKey: d.nopTargetKey || '',
                            NopSpecificationAttributeId: d.nopSpecificationAttributeId || '',
                            NopProductAttributeId: d.nopProductAttributeId || '',
                            IsRequired: d.isRequired,
                            TransformRuleJson: d.transformRuleJson || ''
                        }),
                        success: function (res) {
                            if (!res || !res.success) {
                                m.errors = (res && res.errors) ? res.errors : ['Unable to save mapping.'];
                                return;
                            }

                            // Commit the draft into the saved state.
                            m.id = res.id;
                            m.nopTargetTypeId = d.nopTargetTypeId;
                            m.nopTargetKey = d.nopTargetKey;
                            m.nopSpecificationAttributeId = d.nopSpecificationAttributeId;
                            m.nopProductAttributeId = d.nopProductAttributeId;
                            m.isRequired = d.isRequired;
                            m.transformRuleJson = d.transformRuleJson;

                            m.editing = false;
                            self.notify('Mapping saved \u2014 ' + m.code);
                        },
                        error: function () {
                            m.errors = ['Unable to save mapping due to a server error.'];
                        },
                        complete: function () {
                            m.saving = false;
                        }
                    });
                }
            }
        }).mount('#akeneo-mapping-app');
    })();
</script>
