@using Apt.Nop.Plugin.Misc.AkeneoConnection.Types
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Factories
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoAttributeMappingListModel
<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{
    Layout = "_AdminLayout";
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    //  NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Libraries/Vue/vue.global.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.AttributeMappings");

    ViewBag.PageTitle = "Akeneo Connection - Attribute Mappings";

    var appModel = new
    {
        listUrl = Url.Action("AttributeMappings", "AkeneoMapping"),
        saveUrl = Url.Action("SaveAttributeMappingRow", "AkeneoMapping"),
        deleteOverrideUrl = Url.Action("DeleteAttributeMappingOverride", "AkeneoMapping"),
        selectedFamilyCode = Model.AkeneoFamilyCode ?? string.Empty,
        availableFamilies = Model.AvailableAkeneoFamilies
            .Where(f => !string.IsNullOrWhiteSpace(f.Value))
            .Select(f => new
            {
                value = f.Value,
                text = f.Text
            }).ToList(),
        targetTypes = new
        {
            ignore = (int)NopTargetType.Ignore,
            productField = (int)NopTargetType.ProductField,
            seoField = (int)NopTargetType.SeoField,
            customProperty = (int)NopTargetType.CustomProperty,
            specificationAttribute = (int)NopTargetType.SpecificationAttribute,
            productAttribute = (int)NopTargetType.ProductAttribute
        },
        mappings = Model.Mappings.Select((m, idx) => new
        {
            index = idx,
            id = m.Id,
            akeneoFamilyCode = m.AkeneoFamilyCode ?? string.Empty,
            isInherited = m.IsInherited,
            code = m.AkeneoAttributeCode,
            label = m.AkeneoAttributeLabel,
            type = m.AkeneoAttributeType,
            group = string.IsNullOrWhiteSpace(m.AkeneoAttributeGroup) ? "ungrouped" : m.AkeneoAttributeGroup,
            groupLabel = string.IsNullOrWhiteSpace(m.AkeneoAttributeGroupLabel) ? "Ungrouped" : m.AkeneoAttributeGroupLabel,
            attributeTypeId = m.AkeneoAttributeTypeId,
            isLocalizable = m.IsLocalizable,
            isScopable = m.IsScopable,
            nopTargetTypeId = m.NopTargetTypeId.ToString(),
            nopTargetKey = m.NopTargetKey ?? string.Empty,
            nopTargetEntityId = m.NopTargetEntityId?.ToString() ?? string.Empty,
            isRequired = m.IsRequired,
            transformRuleJson = m.TransformRuleJson ?? string.Empty,
            availableTargetTypes = m.AvailableTargetTypes.Select(o => new { value = o.Value, text = o.Text }),
            availableSpecificationAttributes = m.AvailableSpecificationAttributes.Select(o => new { value = o.Value, text = o.Text }),
            availableProductAttributes = m.AvailableProductAttributes.Select(o => new { value = o.Value, text = o.Text })
        }).ToList()
    };
}

<div class="akeneo-connection">
    @Html.AntiForgeryToken()

    <div class="content-header clearfix">
        <div class="float-left">
            <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
            <h1 class="m-0">Attribute Mapping</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div id="akeneo-mapping-app" class="card card-default" v-cloak>
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-project-diagram"></i>
                        Attribute Mappings
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="p-3 border-bottom bg-light">
                        <div class="form-row align-items-end">
                            <div class="form-group col-md-5 mb-0">
                                <label class="font-weight-bold mb-1" for="akeneo-family-scope">
                                    Mapping scope
                                </label>
                                <select id="akeneo-family-scope"
                                        class="form-control"
                                        v-model="selectedFamilyCode"
                                        v-on:change="changeFamilyScope">
                                    <option value="">Global defaults</option>
                                    <option v-for="family in availableFamilies"
                                            v-bind:key="family.value"
                                            v-bind:value="family.value">
                                        {{ family.text }}
                                    </option>
                                </select>
                               @*  <div class="form-text">
                                    Global mappings are used by every family unless the selected family defines an override.
                                </div> *@
                            </div>

                            @* <div class="col-md-7">
                                <div class="alert mb-0"
                                     v-bind:class="selectedFamilyCode ? 'alert-info' : 'alert-secondary'">
                                    <template v-if="selectedFamilyCode">
                                        Editing mappings for <strong>{{ selectedFamilyLabel }}</strong>.
                                        Rows marked <strong>Inherited</strong> currently use the global mapping.
                                    </template>
                                    <template v-else>
                                        Editing the global default mappings.
                                    </template>
                                </div>
                            </div> *@
                        </div>
                    </div>

                    <div class="p-4" v-if="!mappings.length">
                        <div class="alert alert-info mb-0">
                            {{ selectedFamilyCode
                            ? 'No Akeneo attributes were found for the selected family.'
                            : 'No Akeneo attributes were found. Check the Sync Context connection, then reload this page.' }}
                        </div>
                    </div>

                    <div class="akeneo-list" v-else>
                        <template v-for="group in groups" :key="group.key">
                            <div class="akeneo-group-row">
                                <button type="button"
                                        class="btn btn-link p-0 akeneo-attribute-group-toggle"
                                        v-bind:aria-expanded="isExpanded(group.key) ? 'true' : 'false'"
                                        v-on:click="toggleGroup(group.key)">
                                    <i class="fas fa-chevron-right chevron"></i>
                                    <span>{{ group.label }}</span>
                                </button>
                                <span class="akeneo-group-count ml-2">{{ group.items.length }}</span>
                                <span class="akeneo-group-code ml-2">{{ group.code }}</span>
                            </div>

                            <transition name="akeneo-group-items">
                                <div class="akeneo-group-items" v-if="isExpanded(group.key)">
                                    <template v-for="(m, itemIndex) in group.items" :key="m.index">
                                        <div class="akeneo-row-shell" v-bind:style="rowStaggerStyle(itemIndex)">
                                            <div class="akeneo-row" v-bind:class="statusFor(m).cls">
                                                <div class="akeneo-col akeneo-col-attr">
                                                    <div class="akeneo-code">{{ m.code }}</div>
                                                    <div class="akeneo-label">{{ m.label }}</div>
                                                </div>

                                                <div class="akeneo-col akeneo-col-type">
                                                    <span class="akeneo-type-chip">{{ m.type }}</span>
                                                    <div class="akeneo-flags" aria-label="Attribute localization and scope">
                                                        <span class="akeneo-flag"
                                                              v-bind:class="{ on: m.isLocalizable }"
                                                              v-bind:aria-label="m.isLocalizable ? 'Localizable' : 'Non localizable'"
                                                              v-bind:data-ak-tooltip="m.isLocalizable ? 'Localizable: Akeneo can store a different value per locale.' : 'Non localizable: this attribute uses the same value for every locale.'"
                                                              tabindex="0">L</span>

                                                        <span class="akeneo-flag"
                                                              v-bind:class="{ on: m.isScopable }"
                                                              v-bind:aria-label="m.isScopable ? 'Scopable' : 'Non scopable'"
                                                              v-bind:data-ak-tooltip="m.isScopable ? 'Scopable: Akeneo can store a different value per channel.' : 'Non scopable: this attribute uses the same value for every channel.'"
                                                              tabindex="0">S</span>
                                                    </div>
                                                </div>

                                                <div class="akeneo-col akeneo-col-maps">
                                                    <div>
                                                        <i class="fas fa-arrow-right akeneo-maps-arrow"></i>
                                                        <span class="akeneo-summary-target-type">{{ targetTypeText(m) }}</span>
                                                    </div>
                                                    <div class="akeneo-summary-target-detail">{{ detail(m) }}</div>
                                                </div>

                                                <div class="akeneo-col akeneo-col-status">
                                                    <span class="akeneo-status">{{ statusFor(m).text }}</span>
                                                    <div class="mt-1">
                                                        <span class="badge"
                                                              v-bind:class="scopeFor(m).badgeClass">
                                                            {{ scopeFor(m).text }}
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="akeneo-col akeneo-col-actions">
                                                    <span class="akeneo-summary-required">
                                                        <span class="badge" v-bind:class="m.isRequired ? 'badge-warning' : 'badge-secondary'">
                                                            {{ m.isRequired ? 'Required' : 'Optional' }}
                                                        </span>
                                                    </span>
                                                    <div class="mt-2">
                                                        <button type="button"
                                                                class="btn btn-sm btn-primary akeneo-edit-row"
                                                                v-on:click="edit(m)"
                                                                v-show="!m.editing">
                                                            <i class="fas fa-pencil-alt"></i>
                                                            {{
                                                            selectedFamilyCode &&
                                                            (m.isInherited || Number(m.id) === 0)
                                                            ? 'Create override'
                                                            : Number(m.id) === 0
                                                            ? 'Create mapping'
                                                            : 'Edit'
                                                            }}
                                                        </button>

                                                        <button type="button"
                                                                class="btn btn-sm btn-default akeneo-cancel-row"
                                                                v-on:click="cancel(m)"
                                                                v-show="m.editing">
                                                            Cancel
                                                        </button>

                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger ml-1 mt-2"
                                                                v-if="selectedFamilyCode && !m.isInherited && Number(m.id) > 0"
                                                                v-show="!m.editing"
                                                                v-on:click="removeFamilyOverride(m)"
                                                                v-bind:disabled="m.deleting">
                                                            <i class="fas fa-undo"></i>
                                                            {{ m.deleting ? 'Reverting...' : 'Revert to global' }}
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                            <transition name="akeneo-detail-slide">
                                                <div v-if="m.editing" class="akeneo-mapping-detail">
                                                    <div class="form-row">
                                                        <div class="form-group col-md-4">
                                                            <label class="font-weight-bold mb-1">Target Type</label>
                                                            <select class="form-control akeneo-edit-target-type"
                                                                    v-model="m.draft.nopTargetTypeId"
                                                                    v-on:change="onTypeChange(m)">
                                                                <option v-for="o in m.availableTargetTypes" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-4 akeneo-detail-block" v-if="isKeyType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Target Key</label>
                                                            <select class="form-control akeneo-edit-target-key" v-model="m.draft.nopTargetKey">
                                                                <option value="">None</option>
                                                                <option v-for="o in keyOptions(m.draft.nopTargetTypeId)" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-4 akeneo-detail-block" v-if="isSpecType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Specification Attribute</label>
                                                            <select class="form-control akeneo-edit-specification-attribute" v-model="m.draft.nopTargetEntityId">
                                                                <option v-for="o in m.availableSpecificationAttributes" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-4 akeneo-detail-block" v-if="isProductType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Product Attribute</label>
                                                            <select class="form-control akeneo-edit-product-attribute" v-model="m.draft.nopTargetEntityId">
                                                                <option v-for="o in m.availableProductAttributes" :key="o.value" :value="o.value">{{ o.text }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="form-group col-md-8 akeneo-detail-block akeneo-detail-none"
                                                             v-if="isIgnoreType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1" aria-hidden="true">&nbsp;</label>
                                                            <span class="akeneo-none-hint">
                                                                <i class="fas fa-ban"></i>
                                                                This attribute is ignored - nothing will be imported.
                                                            </span>
                                                        </div>

                                                        <div class="form-group col-md-8 akeneo-detail-block akeneo-detail-none"
                                                             v-else-if="isNoneType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1" aria-hidden="true">&nbsp;</label>
                                                            <span class="akeneo-none-hint">
                                                                <i class="fas fa-info-circle"></i>
                                                                This type maps on its own - no extra target to choose.
                                                            </span>
                                                        </div>

                                                        <div class="form-group col-md-4" v-if="!isIgnoreType(m.draft.nopTargetTypeId)">
                                                            <label class="font-weight-bold mb-1">Require value during import</label>
                                                            <div>
                                                                <label class="akeneo-switch">
                                                                    <input type="checkbox" v-model="m.draft.isRequired" />
                                                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                                                    <span class="akeneo-switch-text">{{ m.draft.isRequired ? 'Required' : 'Optional' }}</span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="alert alert-danger akeneo-row-errors" v-if="m.errors.length" role="alert">
                                                        <i class="fas fa-exclamation-circle akeneo-row-errors-icon" aria-hidden="true"></i>
                                                        <div class="akeneo-row-errors-body">
                                                            <div class="akeneo-row-errors-title">{{ m.errors.length > 1 ? 'Please fix these issues:' : 'Please fix this issue:' }}</div>
                                                            <ul class="mb-0">
                                                                <li v-for="(err, eIdx) in m.errors" :key="eIdx">{{ err }}</li>
                                                            </ul>
                                                        </div>
                                                    </div>

                                                   @*  <div class="mb-3" v-if="!isIgnoreType(m.draft.nopTargetTypeId)">
                                                        <button class="btn btn-sm btn-default" type="button" v-on:click="m.draft.showTransform = !m.draft.showTransform">
                                                            {{ m.draft.transformRuleJson ? 'Edit transform JSON' : 'Add transform JSON' }}
                                                        </button>
                                                        <span class="badge badge-info ml-2" v-if="m.draft.transformRuleJson">Transform configured</span>

                                                        <div class="mt-2" v-show="m.draft.showTransform">
                                                            <textarea class="form-control akeneo-edit-transform-json" rows="3" placeholder="{ }" v-model="m.draft.transformRuleJson"></textarea>
                                                        </div>
                                                    </div> *@

                                                    <div>
                                                        <button type="button" class="btn btn-sm btn-primary akeneo-save-row" v-on:click="save(m)" v-bind:disabled="m.saving">
                                                            <i class="fas fa-save"></i>
                                                            Save
                                                        </button>
                                                        <span class="akeneo-row-saving ml-2" v-show="m.saving">Saving...</span>
                                                    </div>
                                                </div>
                                            </transition>
                                        </div>
                                    </template>
                                </div>
                            </transition>
                        </template>
                    </div>
                </div>

                <div class="akeneo-toast-container" aria-live="polite" aria-atomic="true">
                    <transition-group name="akeneo-toast">
                        <div v-for="t in toasts" :key="t.id" class="akeneo-toast" v-on:click="dismissToast(t.id)">
                            <i class="fas fa-check-circle"></i>
                            <span>{{ t.text }}</span>
                        </div>
                    </transition-group>
                </div>
            </div>

            @if (Model.Warnings?.Any() == true)
            {
                <div class="alert alert-warning mt-3">
                    <ul class="mb-0">
                        @foreach (var warning in Model.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

<script id="akeneo-app-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(appModel))</script>
<script id="akeneo-target-key-map" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NopTargetKeyMap))</script>


<script asp-location="Footer">
    (function () {
        var appData = JSON.parse(document.getElementById('akeneo-app-data').textContent);
        var targetKeyMap = JSON.parse(document.getElementById('akeneo-target-key-map').textContent);

        var mappings = appData.mappings.map(function (m) {
            return Object.assign({}, m, {
                editing: false,
                saving: false,
                deleting: false,
                errors: [],
                draft: {
                    nopTargetTypeId: m.nopTargetTypeId,
                    nopTargetKey: m.nopTargetKey,
                    nopTargetEntityId: m.nopTargetEntityId,
                    isRequired: m.isRequired,
                    transformRuleJson: m.transformRuleJson,
                    showTransform: !!(m.transformRuleJson && m.transformRuleJson.trim())
                }
            });
        });

        Vue.createApp({
            data: function () {
                return {
                    mappings: mappings,
                    selectedFamilyCode: appData.selectedFamilyCode || '',
                    availableFamilies: appData.availableFamilies || [],
                    targetTypes: appData.targetTypes,
                    targetKeyMap: targetKeyMap,
                    expanded: {},
                    toasts: []
                };
            },
            computed: {
                selectedFamilyLabel: function () {
                    if (!this.selectedFamilyCode)
                        return 'Global defaults';

                    var family = this.availableFamilies.find(function (item) {
                        return item.value === this.selectedFamilyCode;
                    }, this);

                    return family ? family.text : this.selectedFamilyCode;
                },
                groups: function () {
                    var map = {};
                    this.mappings.forEach(function (m) {
                        var key = m.groupLabel || 'Ungrouped';
                        if (!map[key]) {
                            map[key] = { key: key, label: key, code: m.group, items: [] };
                        }
                        map[key].items.push(m);
                    });
                    return Object.values(map).sort(function (a, b) {
                        return a.label.localeCompare(b.label);
                    });
                }
            },
            methods: {
                isIgnoreType: function (t) {
                    return Number(t) === this.targetTypes.ignore;
                },
                    rowStaggerStyle: function (index) {
                    return {
                        animationDelay: Math.min(index * 45, 260) + 'ms'
                    };
                },
                isExpanded: function (key) {
                    return !!this.expanded[key];
                },
                toggleGroup: function (key) {
                    this.expanded[key] = !this.expanded[key];
                },
                keyOptions: function (typeId) {
                    return this.targetKeyMap[String(typeId)] || [];
                },
                isKeyType: function (t) {
                    t = Number(t);
                    return t === this.targetTypes.productField
                        || t === this.targetTypes.seoField
                        || t === this.targetTypes.customProperty;
                },
                isSpecType: function (t) {
                    return Number(t) === this.targetTypes.specificationAttribute;
                },
                isProductType: function (t) {
                    return Number(t) === this.targetTypes.productAttribute;
                },
                isNoneType: function (t) {
                    return !this.isKeyType(t) && !this.isSpecType(t) && !this.isProductType(t);
                },
                targetTypeText: function (m) {
                    var found = m.availableTargetTypes.find(function (o) { return o.value === m.nopTargetTypeId; });
                    return found ? found.text : 'Ignore';
                },
                detail: function (m) {
                    var t = Number(m.nopTargetTypeId);

                    if (this.isKeyType(t)) {
                        var k = this.keyOptions(t).find(function (o) { return o.value === m.nopTargetKey; });
                        return (m.nopTargetKey && k) ? 'Target Key: ' + k.text : 'No target key selected';
                    }
                    if (this.isSpecType(t)) {
                        var s = m.availableSpecificationAttributes.find(function (o) { return o.value === m.nopTargetEntityId ; });
                        return (m.nopTargetEntityId && s) ? 'Specification Attribute: ' + s.text : 'No specification attribute selected';
                    }
                    if (this.isProductType(t)) {
                        var p = m.availableProductAttributes.find(function (o) { return o.value === m.nopTargetEntityId ; });
                        return (m.nopTargetEntityId && p) ? 'Product Attribute: ' + p.text : 'No product attribute selected';
                    }
                    return 'No additional target selected';
                },
                statusFor: function (m) {
                    if (Number(m.nopTargetTypeId) === this.targetTypes.ignore) {
                        return { cls: 'is-ignored', text: 'Ignored' };
                    }
                    return Number(m.id) > 0 || m.isInherited
                        ? { cls: 'is-mapped', text: 'Mapped' }
                        : { cls: 'is-attention', text: 'Unsaved' };
                },
                scopeFor: function (m) {
                    if (!this.selectedFamilyCode) {
                        return {
                            text: 'Global',
                            badgeClass: 'badge-secondary'
                        };
                    }

                    if (m.isInherited) {
                        return {
                            text: 'Inherited',
                            badgeClass: 'badge-info'
                        };
                    }

                    if (Number(m.id) > 0) {
                        return {
                            text: 'Family override',
                            badgeClass: 'badge-primary'
                        };
                    }

                    return {
                        text: 'No mapping',
                        badgeClass: 'badge-warning'
                    };
                },
                changeFamilyScope: function () {
                    var url = new URL(appData.listUrl, window.location.origin);

                    if (this.selectedFamilyCode)
                        url.searchParams.set('akeneoFamilyCode', this.selectedFamilyCode);
                    else
                        url.searchParams.delete('akeneoFamilyCode');

                    window.location.assign(url.pathname + url.search);
                },
                edit: function (m) {
                    m.draft.nopTargetTypeId = m.nopTargetTypeId;
                    m.draft.nopTargetKey = m.nopTargetKey;
                    m.draft.nopTargetEntityId = m.nopTargetEntityId ;
                    m.draft.isRequired = m.isRequired;
                    m.draft.transformRuleJson = m.transformRuleJson;
                    m.draft.showTransform = !!(m.transformRuleJson && m.transformRuleJson.trim());
                    m.errors = [];
                    m.editing = true;
                },
                cancel: function (m) {
                    m.editing = false;
                },
                onTypeChange: function (m) {
                    var valid = this.keyOptions(m.draft.nopTargetTypeId).some(function (o) {
                        return o.value === m.draft.nopTargetKey;
                    });
                    if (!valid) {
                        m.draft.nopTargetKey = '';
                    }

                    m.draft.nopTargetEntityId = '';
                },
                notify: function (text) {
                    var self = this;
                    var id = Date.now() + '-' + Math.random().toString(36).slice(2);
                    this.toasts.push({ id: id, text: text });
                    setTimeout(function () {
                        self.dismissToast(id);
                    }, 3000);
                },
                dismissToast: function (id) {
                    this.toasts = this.toasts.filter(function (t) { return t.id !== id; });
                },
                removeFamilyOverride: function (m) {
                    var self = this;

                    if (!this.selectedFamilyCode || m.isInherited || Number(m.id) <= 0)
                        return;

                    m.errors = [];
                    m.deleting = true;

                    $.ajax({
                        type: 'POST',
                        url: appData.deleteOverrideUrl,
                        data: addAntiForgeryToken({
                            id: m.id,
                            akeneoFamilyCode: this.selectedFamilyCode,
                            akeneoAttributeCode: m.code
                        }),
                        success: function (res) {
                            if (!res || !res.success) {
                                m.errors = (res && res.errors)
                                    ? res.errors
                                    : ['Unable to remove the family override.'];
                                return;
                            }

                            self.notify('Family override removed - ' + m.code);
                            window.setTimeout(function () {
                                window.location.reload();
                            }, 300);
                        },
                        error: function () {
                            m.errors = ['Unable to remove the family override due to a server error.'];
                        },
                        complete: function () {
                            m.deleting = false;
                        }
                    });
                },
                save: function (m) {
                    var self = this;
                    var d = m.draft;

                    m.errors = [];
                    m.saving = true;

                    $.ajax({
                        type: 'POST',
                        url: appData.saveUrl,
                        data: addAntiForgeryToken({
                            Id: m.isInherited ? 0 : m.id,
                            AkeneoFamilyCode: self.selectedFamilyCode || '',
                            AkeneoAttributeCode: m.code,
                            AkeneoAttributeTypeId: m.attributeTypeId,
                            NopTargetTypeId: d.nopTargetTypeId,
                            NopTargetKey: d.nopTargetKey || '',
                            NopTargetEntityId: d.nopTargetEntityId || '',
                            IsRequired: d.isRequired,
                            TransformRuleJson: d.transformRuleJson || ''
                        }),
                        success: function (res) {
                            if (!res || !res.success) {
                                m.errors = (res && res.errors) ? res.errors : ['Unable to save mapping.'];
                                return;
                            }

                            m.id = res.id;
                            m.akeneoFamilyCode = self.selectedFamilyCode || '';
                            m.isInherited = false;
                            m.nopTargetTypeId = d.nopTargetTypeId;
                            m.nopTargetKey = d.nopTargetKey;
                            m.nopTargetEntityId = d.nopTargetEntityId;
                            m.isRequired = d.isRequired;
                            m.transformRuleJson = d.transformRuleJson;

                            m.editing = false;
                            self.notify('Mapping saved - ' + m.code);
                        },
                        error: function () {
                            m.errors = ['Unable to save mapping due to a server error.'];
                        },
                        complete: function () {
                            m.saving = false;
                        }
                    });
                }
            }
        }).mount('#akeneo-mapping-app');
    })();
</script>
