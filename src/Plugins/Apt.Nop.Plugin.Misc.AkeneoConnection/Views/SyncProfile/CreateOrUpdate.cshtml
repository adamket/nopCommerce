@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoSyncProfileModel
<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{
    Layout = "_AdminLayout";

    var isEdit = Model.Id > 0;
    ViewBag.PageTitle = isEdit ? "Edit Akeneo Sync Profile" : "Create Akeneo Sync Profile";

    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-combobox.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.SyncProfiles");

    object Options(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> items) =>
        items
            .Where(item => item.Value != null)
            .Select(item => new { value = item.Value, text = item.Text })
            .ToList();

    IList<string> Codes(IEnumerable<string> codes) =>
        (codes ?? Enumerable.Empty<string>())
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .Select(code => code.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    var appModel = new
    {
        id = Model.Id,
        savedEnabled = Model.Enabled,
        timeZone = Model.UpdatedAfterTimeZoneDisplayName ?? string.Empty,
        form = new
        {
            name = Model.Name ?? string.Empty,
            enabled = Model.Enabled,
            akeneoChannel = Model.AkeneoChannel ?? string.Empty,
            selectedAkeneoLocaleCodes = Codes(Model.SelectedAkeneoLocaleCodes),
            currencyCode = Model.CurrencyCode ?? string.Empty,
            pageSize = Model.PageSize > 0 ? Model.PageSize.ToString() : "100",
            maxProducts = Model.MaxProducts?.ToString() ?? string.Empty,
            continueOnError = Model.ContinueOnError,
            saveRawPayloadSnapshot = Model.SaveRawPayloadSnapshot,
            productWriteModeId = Model.ProductWriteModeId.ToString(),
            unmappedAttributeBehaviorId = Model.UnmappedAttributeBehaviorId.ToString(),
            productFieldMissingValueBehaviorId = Model.ProductFieldMissingValueBehaviorId.ToString(),
            seoFieldMissingValueBehaviorId = Model.SeoFieldMissingValueBehaviorId.ToString(),
            customPropertyMissingValueBehaviorId = Model.CustomPropertyMissingValueBehaviorId.ToString(),
            categorySyncModeId = Model.CategorySyncModeId.ToString(),
            specificationAttributeSyncModeId = Model.SpecificationAttributeSyncModeId.ToString(),
            productAttributeSyncModeId = Model.ProductAttributeSyncModeId.ToString(),
            assetSyncModeId = Model.AssetSyncModeId.ToString(),
            missingProductBehaviorId = Model.MissingProductBehaviorId.ToString(),
            createMissingProductAttributeValues = Model.CreateMissingProductAttributeValues,
            selectedAkeneoFamilyCodes = Codes(Model.SelectedAkeneoFamilyCodes),
            selectedAkeneoCategoryCodes = Codes(Model.SelectedAkeneoCategoryCodes),
            categoryFilterModeId = Model.CategoryFilterModeId.ToString(),
            selectedAkeneoProductGroupCodes = Codes(Model.SelectedAkeneoProductGroupCodes),
            productEnabledFilterId = Model.ProductEnabledFilterId.ToString(),
            completenessFilterId = Model.CompletenessFilterId.ToString(),
            updatedFilterModeId = Model.UpdatedFilterModeId.ToString(),
            updatedAfter = Model.UpdatedAfter?.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty,
            updatedSinceLastNDays = Model.UpdatedSinceLastNDays?.ToString() ?? string.Empty,
            includeLinkedAssetUpdates = Model.IncludeLinkedAssetUpdates,
            productParentFilterModeId = Model.ProductParentFilterModeId.ToString(),
            additionalSearchJson = Model.AdditionalSearchJson ?? string.Empty
        },
        options = new
        {
            channels = Options(Model.AvailableAkeneoChannels),
            locales = Options(Model.AvailableAkeneoLocales),
            families = Options(Model.AvailableAkeneoFamilies),
            categories = Options(Model.AvailableAkeneoCategories),
            productWriteModes = Options(Model.AvailableProductWriteModes),
            unmappedAttributeBehaviors = Options(Model.AvailableUnmappedAttributeBehaviors),
            productFieldMissingValueBehaviors = Options(Model.AvailableProductFieldMissingValueBehaviors),
            seoFieldMissingValueBehaviors = Options(Model.AvailableSeoFieldMissingValueBehaviors),
            customPropertyMissingValueBehaviors = Options(Model.AvailableCustomPropertyMissingValueBehaviors),
            categorySyncModes = Options(Model.AvailableCategorySyncModes),
            specificationAttributeSyncModes = Options(Model.AvailableSpecificationAttributeSyncModes),
            productAttributeSyncModes = Options(Model.AvailableProductAttributeSyncModes),
            assetSyncModes = Options(Model.AvailableAssetSyncModes),
            missingProductBehaviors = Options(Model.AvailableMissingProductBehaviors),
            categoryFilterModes = Options(Model.AvailableCategoryFilterModes),
            productEnabledFilters = Options(Model.AvailableProductEnabledFilters),
            completenessFilters = Options(Model.AvailableCompletenessFilters),
            updatedFilterModes = Options(Model.AvailableUpdatedFilterModes),
            productParentFilterModes = Options(Model.AvailableProductParentFilterModes)
        },
        updatedFilterModeIds = new
        {
            sinceLastSuccessfulRun = ((int)AkeneoUpdatedFilterMode.SinceLastSuccessfulRun).ToString(),
            fixedDate = ((int)AkeneoUpdatedFilterMode.FixedDate).ToString(),
            rollingDays = ((int)AkeneoUpdatedFilterMode.RollingDays).ToString(),
            none = ((int)AkeneoUpdatedFilterMode.None).ToString()
        },
        urls = new
        {
            save = Url.Action("Save", "AkeneoSyncProfile"),
            list = Url.Action("List", "AkeneoSyncProfile"),
            lockStatus = Url.Action("LockStatus", "AkeneoSyncProfile"),
            releaseLock = Url.Action("ReleaseLock", "AkeneoSyncProfile"),
            edit = isEdit ? Url.Action("Edit", "AkeneoSyncProfile", new { id = Model.Id }) : null,
            delete = isEdit ? Url.Action("Delete", "AkeneoSyncProfile", new { id = Model.Id }) : null,
            run = isEdit ? Url.Action("ImportProductsByProfile", "AkeneoSync", new { id = Model.Id }) : null,
            fullRun = isEdit ? Url.Action("ImportProductsByProfile", "AkeneoSync", new { id = Model.Id, fullSync = true }) : null
        }
    };
}

<div class="akeneo-connection">
    @Html.AntiForgeryToken()

    <div id="akeneo-sync-profile-app" v-cloak>
        <div class="content-header clearfix">
            <h1 class="float-left">
                <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
                <span>
                    {{ isEdit ? 'Edit Akeneo Sync Profile' : 'Create Akeneo Sync Profile' }}
                    &nbsp;&nbsp;
                    <small>
                        <a v-bind:href="urls.list"><i class="fas fa-arrow-circle-left"></i> back to sync profile list</a>
                    </small>
                </span>
            </h1>

            <div class="float-right akeneo-profile-actions">
                <span class="akeneo-unsaved-indicator" v-if="isDirty">
                    <i class="fas fa-circle"></i> Unsaved changes
                </span>

                <button type="button"
                        class="btn btn-primary"
                        v-bind:disabled="!!busy"
                        v-on:click="save"
                        title="Save (Ctrl+S)">
                    <span v-if="busy === 'save'" class="akeneo-button-spinner" aria-hidden="true"></span>
                    <i v-else class="far fa-save"></i>
                    {{ busy === 'save' ? 'Saving...' : 'Save' }}
                </button>

                <template v-if="isEdit">
                    <button type="button"
                            class="btn btn-success"
                            v-bind:disabled="!canRun"
                            v-bind:title="runDisabledReason || 'Runs the saved version of this profile.'"
                            v-on:click="confirmRun(false)">
                        <span v-if="busy === 'run'" class="akeneo-button-spinner" aria-hidden="true"></span>
                        <i v-else class="fas fa-play"></i>
                        {{ busy === 'run' ? 'Running...' : 'Run Profile' }}
                    </button>

                    <button type="button"
                            class="btn btn-warning"
                            v-bind:disabled="!canRun"
                            v-bind:title="runDisabledReason || 'Runs a complete authoritative profile pass using only 100% complete Akeneo products.'"
                            v-on:click="confirmRun(true)">
                        <span v-if="busy === 'fullRun'" class="akeneo-button-spinner" aria-hidden="true"></span>
                        <i v-else class="fas fa-sync-alt"></i>
                        {{ busy === 'fullRun' ? 'Running...' : 'Run Full Reconciliation' }}
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            v-bind:disabled="!!busy"
                            v-on:click="confirmDelete">
                        <span v-if="busy === 'delete'" class="akeneo-button-spinner" aria-hidden="true"></span>
                        <i v-else class="far fa-trash-alt"></i>
                        Delete
                    </button>
                </template>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="alert alert-danger mb-3" role="alert" v-if="saveError">
                    <strong>{{ saveError }}</strong>
                    <ul class="mb-0 mt-1" v-if="errorList.length">
                        <li v-for="(error, index) in errorList" v-bind:key="index">{{ error }}</li>
                    </ul>
                </div>

                <div class="alert mb-3 akeneo-lock-alert"
                     role="status"
                     v-if="lock && lock.held"
                     v-bind:class="lockLooksAbandoned ? 'alert-danger' : 'alert-warning'">
                    <div class="akeneo-lock-alert-body">
                        <div>
                            <strong>
                                <i class="fas fa-lock"></i>
                                A sync is holding the Akeneo catalog lock{{ lock.runRecordId ? ' (run record ' + lock.runRecordId + ')' : '' }}.
                            </strong>
                            <div class="mt-1">
                                <span v-if="lock.runType">{{ lock.runType }} · </span>
                                <span v-if="lock.runStatus">{{ lock.runStatus }} · </span>
                                started {{ lock.acquired }} · last check-in {{ lock.heartbeatMinutesAgo }} min ago ({{ lock.lastHeartbeat }}) · expires {{ lock.expires }}
                            </div>
                            <div class="mt-1" v-if="lockLooksAbandoned">
                                A running sync checks in every 5 minutes, so this run has most likely stopped.
                                Release the lock to run a sync now instead of waiting for it to expire.
                            </div>
                            <div class="mt-1" v-else>
                                A running sync checks in every 5 minutes, so this one is probably still working.
                                Releasing the lock stops it at its next checkpoint.
                            </div>
                            <div class="mt-1 akeneo-dim">The lock is shared by every sync profile and Catalog Binding.</div>
                        </div>
                        <div class="akeneo-lock-alert-actions">
                            <button type="button"
                                    class="btn btn-sm btn-default"
                                    v-bind:disabled="lockBusy"
                                    v-on:click="loadLock">
                                <i class="fas fa-redo"></i>
                                Refresh
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    v-bind:disabled="lockBusy || !!busy"
                                    v-on:click="confirmReleaseLock">
                                <span v-if="lockBusy" class="akeneo-button-spinner" aria-hidden="true"></span>
                                <i v-else class="fas fa-unlock"></i>
                                Release lock
                            </button>
                        </div>
                    </div>
                </div>

                <div class="alert mb-3"
                     role="alert"
                     v-if="runResult"
                     v-bind:class="runResult.cls">
                    <button type="button" class="close" aria-label="Close" v-on:click="runResult = null">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <strong>{{ runResult.message }}</strong>

                    <div class="akeneo-run-counts mt-2" v-if="runResult.counts">
                        <span v-for="count in runCounts" v-bind:key="count.label">
                            <strong>{{ count.label }}:</strong> {{ count.value }}
                        </span>
                    </div>

                    <div class="mt-2" v-if="runResult.warnings.length">
                        <strong>Warnings:</strong>
                        <ul class="mb-0">
                            <li v-for="(warning, index) in runResult.warnings" v-bind:key="'w' + index">{{ warning }}</li>
                        </ul>
                    </div>

                    <div class="mt-2" v-if="runResult.errors.length">
                        <strong>Errors:</strong>
                        <ul class="mb-0">
                            <li v-for="(error, index) in runResult.errors" v-bind:key="'e' + index">{{ error }}</li>
                        </ul>
                    </div>
                </div>

                <!-- Profile -->
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title"><i class="fas fa-id-card"></i> Profile</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-name">Profile name</label></div>
                            <div class="col-md-9">
                                <input id="sp-name" type="text" class="form-control"
                                       v-bind:class="{ 'is-invalid': fieldError('Name') }"
                                       v-model="form.name" maxlength="400" />
                                <div class="invalid-feedback d-block" v-if="fieldError('Name')">{{ fieldError('Name') }}</div>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Enabled</label></div>
                            <div class="col-md-9">
                                <label class="akeneo-switch">
                                    <input type="checkbox" v-model="form.enabled" />
                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                    <span class="akeneo-switch-text">{{ form.enabled ? 'Enabled' : 'Disabled' }}</span>
                                </label>
                                <div class="alert alert-warning mt-2 mb-0" v-if="isEdit && !savedEnabled">
                                    This profile is disabled. Enable and save the profile before running it.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Akeneo scope -->
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title"><i class="fas fa-globe"></i> Akeneo Scope</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-channel">Akeneo channel</label></div>
                            <div class="col-md-9">
                                <select id="sp-channel" class="form-control"
                                        v-bind:class="{ 'is-invalid': fieldError('AkeneoChannel') }"
                                        v-model="form.akeneoChannel">
                                    <option v-for="option in options.channels" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                                <div class="invalid-feedback d-block" v-if="fieldError('AkeneoChannel')">{{ fieldError('AkeneoChannel') }}</div>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Akeneo locales</label></div>
                            <div class="col-md-9">
                                <akeneo-combobox v-model="form.selectedAkeneoLocaleCodes"
                                                 v-bind:options="comboLocales"
                                                 v-bind:class="{ 'is-invalid': fieldError('SelectedAkeneoLocaleCodes') }"
                                                 placeholder="Select locales · type to filter"
                                                 add-placeholder="Add a locale…"
                                                 item-name="locale"
                                                 empty-text="No Akeneo locales are available."></akeneo-combobox>
                                <div class="invalid-feedback d-block" v-if="fieldError('SelectedAkeneoLocaleCodes')">{{ fieldError('SelectedAkeneoLocaleCodes') }}</div>
                                <span class="form-text text-muted">Values are resolved using the first selected locale.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-currency">Currency</label></div>
                            <div class="col-md-9">
                                <input id="sp-currency" type="text" class="form-control akeneo-input-short"
                                       v-model="form.currencyCode" maxlength="3" placeholder="USD" />
                                <span class="form-text text-muted">ISO code used to pick a price from Akeneo price collections. Defaults to USD.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Batch behavior -->
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title"><i class="fas fa-layer-group"></i> Batch Behavior</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-page-size">Page size</label></div>
                            <div class="col-md-9">
                                <input id="sp-page-size" type="number" min="1" class="form-control akeneo-input-short"
                                       v-bind:class="{ 'is-invalid': fieldError('PageSize') }"
                                       v-model="form.pageSize" />
                                <div class="invalid-feedback d-block" v-if="fieldError('PageSize')">{{ fieldError('PageSize') }}</div>
                                <span class="form-text text-muted">Recommended: 100.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-max-products">Max products</label></div>
                            <div class="col-md-9">
                                <input id="sp-max-products" type="number" min="1" class="form-control akeneo-input-short"
                                       v-bind:class="{ 'is-invalid': fieldError('MaxProducts') }"
                                       v-model="form.maxProducts" placeholder="No limit" />
                                <div class="invalid-feedback d-block" v-if="fieldError('MaxProducts')">{{ fieldError('MaxProducts') }}</div>
                                <span class="form-text text-muted">Optional. Useful for testing small batches.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Continue on error</label></div>
                            <div class="col-md-9">
                                <label class="akeneo-switch">
                                    <input type="checkbox" v-model="form.continueOnError" />
                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                    <span class="akeneo-switch-text">{{ form.continueOnError ? 'Keep going after a failed product' : 'Stop at the first failed product' }}</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Save raw payload snapshot</label></div>
                            <div class="col-md-9">
                                <label class="akeneo-switch">
                                    <input type="checkbox" v-model="form.saveRawPayloadSnapshot" />
                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                    <span class="akeneo-switch-text">{{ form.saveRawPayloadSnapshot ? 'Store the Akeneo payload in item logs' : 'Off' }}</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Synchronization behavior -->
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title"><i class="fas fa-cogs"></i> Synchronization Behavior</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group row" v-for="field in syncSelects" v-bind:key="field.key">
                            <div class="col-md-3 text-right"><label class="control-label" v-bind:for="'sp-' + field.key">{{ field.label }}</label></div>
                            <div class="col-md-9">
                                <select v-bind:id="'sp-' + field.key" class="form-control"
                                        v-bind:class="{ 'is-invalid': fieldError(field.name) }"
                                        v-model="form[field.key]">
                                    <option v-for="option in options[field.options]" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                                <div class="invalid-feedback d-block" v-if="fieldError(field.name)">{{ fieldError(field.name) }}</div>
                                <span class="form-text text-muted" v-if="field.help">{{ field.help }}</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Create missing product attribute values</label></div>
                            <div class="col-md-9">
                                <label class="akeneo-switch">
                                    <input type="checkbox" v-model="form.createMissingProductAttributeValues" />
                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                    <span class="akeneo-switch-text">{{ form.createMissingProductAttributeValues ? 'Create values that do not exist yet' : 'Off' }}</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product filters -->
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title"><i class="fas fa-filter"></i> Akeneo Product Filters</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Akeneo families</label></div>
                            <div class="col-md-9">
                                <akeneo-combobox v-model="form.selectedAkeneoFamilyCodes"
                                                 v-bind:options="comboFamilies"
                                                 placeholder="All families · type to filter"
                                                 add-placeholder="Add a family…"
                                                 item-name="family"
                                                 empty-text="No Akeneo families are available."></akeneo-combobox>
                                <span class="form-text text-muted">Optional. If selected, only products assigned to one or more of these Akeneo families will be imported.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Akeneo categories</label></div>
                            <div class="col-md-9">
                                <akeneo-combobox v-model="form.selectedAkeneoCategoryCodes"
                                                 v-bind:options="comboCategories"
                                                 placeholder="No category filter · type to filter"
                                                 add-placeholder="Add a category…"
                                                 item-name="category"
                                                 empty-text="No Akeneo categories are available."></akeneo-combobox>
                                <span class="form-text text-muted">Optional. If selected, the chosen category filter mode will be applied to these Akeneo categories.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-category-filter-mode">Category filter mode</label></div>
                            <div class="col-md-9">
                                <select id="sp-category-filter-mode" class="form-control" v-model="form.categoryFilterModeId">
                                    <option v-for="option in options.categoryFilterModes" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Akeneo product groups</label></div>
                            <div class="col-md-9">
                                <akeneo-combobox v-model="form.selectedAkeneoProductGroupCodes"
                                                 v-bind:options="[]"
                                                 v-bind:allow-custom="true"
                                                 placeholder="Type an Akeneo group code and press Enter"
                                                 add-placeholder="Add another group code…"
                                                 item-name="group"
                                                 empty-text="Type an Akeneo group code, then press Enter or comma."></akeneo-combobox>
                                <span class="form-text text-muted">Optional. If one or more group codes are entered, only products belonging to those groups will be imported.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-enabled-filter">Product enabled filter</label></div>
                            <div class="col-md-9">
                                <select id="sp-enabled-filter" class="form-control" v-model="form.productEnabledFilterId">
                                    <option v-for="option in options.productEnabledFilters" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-completeness">Completeness rule</label></div>
                            <div class="col-md-9">
                                <select id="sp-completeness" class="form-control"
                                        v-bind:class="{ 'is-invalid': fieldError('CompletenessFilterId') }"
                                        v-model="form.completenessFilterId">
                                    <option v-for="option in options.completenessFilters" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                                <div class="invalid-feedback d-block" v-if="fieldError('CompletenessFilterId')">{{ fieldError('CompletenessFilterId') }}</div>
                                <span class="form-text text-muted">Controls completeness filtering for normal profile runs. Full reconciliation runs always require 100% completeness for the selected Akeneo channel.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-updated-mode">Updated filter mode</label></div>
                            <div class="col-md-9">
                                <select id="sp-updated-mode" class="form-control"
                                        v-bind:class="{ 'is-invalid': fieldError('UpdatedFilterModeId') }"
                                        v-model="form.updatedFilterModeId">
                                    <option v-for="option in options.updatedFilterModes" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                                <div class="invalid-feedback d-block" v-if="fieldError('UpdatedFilterModeId')">{{ fieldError('UpdatedFilterModeId') }}</div>
                                <span class="form-text text-muted">Delta runs use this policy to determine the Akeneo updated cutoff. Full runs ignore it.</span>
                                <div class="alert alert-info py-2 mt-2 mb-0" role="status">
                                    <strong>{{ updatedModeHelp.title }}</strong> {{ updatedModeHelp.text }}
                                </div>
                            </div>
                        </div>

                        <div class="form-group row" v-if="form.updatedFilterModeId === modes.fixedDate">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-updated-after">Updated after</label></div>
                            <div class="col-md-9">
                                <input id="sp-updated-after" type="datetime-local" class="form-control akeneo-input-medium"
                                       v-bind:class="{ 'is-invalid': fieldError('UpdatedAfter') }"
                                       v-model="form.updatedAfter" />
                                <div class="invalid-feedback d-block" v-if="fieldError('UpdatedAfter')">{{ fieldError('UpdatedAfter') }}</div>
                                <span class="form-text text-muted">
                                    Enter the date and time in the store time zone: <strong>{{ timeZone }}</strong>.
                                    The value is stored internally as UTC. Required for fixed-date mode.
                                </span>
                            </div>
                        </div>

                        <div class="form-group row" v-if="form.updatedFilterModeId === modes.rollingDays">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-rolling-days">Updated since last N days</label></div>
                            <div class="col-md-9">
                                <input id="sp-rolling-days" type="number" min="1" class="form-control akeneo-input-short"
                                       v-bind:class="{ 'is-invalid': fieldError('UpdatedSinceLastNDays') }"
                                       v-model="form.updatedSinceLastNDays" />
                                <div class="invalid-feedback d-block" v-if="fieldError('UpdatedSinceLastNDays')">{{ fieldError('UpdatedSinceLastNDays') }}</div>
                                <span class="form-text text-muted">Required for rolling-days mode and must be greater than zero. Example: 7 reprocesses the most recent seven days on every delta run.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label">Include asset-only updates</label></div>
                            <div class="col-md-9">
                                <label class="akeneo-switch">
                                    <input type="checkbox" v-model="form.includeLinkedAssetUpdates" />
                                    <span class="akeneo-switch-track"><span class="akeneo-switch-thumb"></span></span>
                                    <span class="akeneo-switch-text">{{ form.includeLinkedAssetUpdates ? 'On' : 'Off' }}</span>
                                </label>
                                <span class="form-text text-muted">Uses Akeneo's linked-entity updated filter during delta runs so a product is revisited when a linked Asset Manager record changes. Requires an active updated cutoff, Akeneo SaaS Enterprise, and linked asset updates enabled in Akeneo.</span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-parent-filter">Product parent filter mode</label></div>
                            <div class="col-md-9">
                                <select id="sp-parent-filter" class="form-control" v-model="form.productParentFilterModeId">
                                    <option v-for="option in options.productParentFilterModes" v-bind:key="option.value" v-bind:value="option.value">{{ option.text }}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Advanced -->
                <div class="card card-default">
                    <div class="card-header">
                        <div class="card-title"><i class="fas fa-code"></i> Advanced</div>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3 text-right"><label class="control-label" for="sp-search-json">Additional search JSON</label></div>
                            <div class="col-md-9">
                                <textarea id="sp-search-json" class="form-control" rows="5"
                                          v-bind:class="{ 'is-invalid': fieldError('AdditionalSearchJson') || searchJsonError }"
                                          v-model="form.additionalSearchJson"
                                          spellcheck="false"></textarea>
                                <div class="invalid-feedback d-block" v-if="fieldError('AdditionalSearchJson') || searchJsonError">
                                    {{ fieldError('AdditionalSearchJson') || searchJsonError }}
                                </div>
                                <span class="form-text text-muted">Optional Akeneo search JSON merged into the generated search filter.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Confirmation modal -->
        <div v-if="confirm.visible" class="modal fade show" style="display: block;" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="akeneo-profile-confirm-title">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 id="akeneo-profile-confirm-title" class="modal-title">{{ confirm.title }}</h5>
                        <button type="button" class="close" aria-label="Close" v-on:click="confirm.visible = false">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">{{ confirm.message }}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" v-on:click="confirm.visible = false">Cancel</button>
                        <button type="button" class="btn" v-bind:class="confirm.buttonClass" v-on:click="acceptConfirm">
                            <i v-bind:class="confirm.icon"></i>
                            {{ confirm.buttonText }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div v-if="confirm.visible" class="modal-backdrop fade show" v-on:click="confirm.visible = false"></div>

        <div class="akeneo-toast-container" aria-live="polite" aria-atomic="true">
            <transition-group name="akeneo-toast">
                <div v-for="toast in toasts" v-bind:key="toast.id" class="akeneo-toast" v-on:click="dismissToast(toast.id)">
                    <i class="fas fa-check-circle"></i>
                    <span>{{ toast.text }}</span>
                </div>
            </transition-group>
        </div>
    </div>
</div>

<script id="akeneo-sync-profile-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(appModel))</script>

<script asp-location="Footer">
    (function () {
        var appData = JSON.parse(document.getElementById('akeneo-sync-profile-data').textContent);

        // Combo box options: text arrives as "Label (code)" or just the code.
        function toComboOptions(options) {
            return (options || [])
                .filter(function (option) { return option.value; })
                .map(function (option) {
                    var suffix = ' (' + option.value + ')';
                    var text = option.text || option.value;
                    var label = text.slice(-suffix.length) === suffix ? text.slice(0, -suffix.length) : text;

                    return { value: option.value, label: label, hint: label === option.value ? '' : option.value };
                });
        }

        function snapshot(form) {
            return JSON.stringify(form);
        }

        // Maps form keys to the posted model property names.
        var postNames = {
            name: 'Name',
            enabled: 'Enabled',
            akeneoChannel: 'AkeneoChannel',
            selectedAkeneoLocaleCodes: 'SelectedAkeneoLocaleCodes',
            currencyCode: 'CurrencyCode',
            pageSize: 'PageSize',
            maxProducts: 'MaxProducts',
            continueOnError: 'ContinueOnError',
            saveRawPayloadSnapshot: 'SaveRawPayloadSnapshot',
            productWriteModeId: 'ProductWriteModeId',
            unmappedAttributeBehaviorId: 'UnmappedAttributeBehaviorId',
            productFieldMissingValueBehaviorId: 'ProductFieldMissingValueBehaviorId',
            seoFieldMissingValueBehaviorId: 'SeoFieldMissingValueBehaviorId',
            customPropertyMissingValueBehaviorId: 'CustomPropertyMissingValueBehaviorId',
            categorySyncModeId: 'CategorySyncModeId',
            specificationAttributeSyncModeId: 'SpecificationAttributeSyncModeId',
            productAttributeSyncModeId: 'ProductAttributeSyncModeId',
            assetSyncModeId: 'AssetSyncModeId',
            missingProductBehaviorId: 'MissingProductBehaviorId',
            createMissingProductAttributeValues: 'CreateMissingProductAttributeValues',
            selectedAkeneoFamilyCodes: 'SelectedAkeneoFamilyCodes',
            selectedAkeneoCategoryCodes: 'SelectedAkeneoCategoryCodes',
            categoryFilterModeId: 'CategoryFilterModeId',
            selectedAkeneoProductGroupCodes: 'SelectedAkeneoProductGroupCodes',
            productEnabledFilterId: 'ProductEnabledFilterId',
            completenessFilterId: 'CompletenessFilterId',
            updatedFilterModeId: 'UpdatedFilterModeId',
            updatedAfter: 'UpdatedAfter',
            updatedSinceLastNDays: 'UpdatedSinceLastNDays',
            includeLinkedAssetUpdates: 'IncludeLinkedAssetUpdates',
            productParentFilterModeId: 'ProductParentFilterModeId',
            additionalSearchJson: 'AdditionalSearchJson'
        };

        var app = Vue.createApp({
            data: function () {
                return {
                    id: appData.id,
                    savedEnabled: appData.savedEnabled,
                    timeZone: appData.timeZone,
                    form: JSON.parse(JSON.stringify(appData.form)),
                    savedSnapshot: snapshot(appData.form),
                    options: appData.options,
                    modes: appData.updatedFilterModeIds,
                    urls: appData.urls,
                    busy: false, // false or 'save' / 'run' / 'fullRun' / 'delete'
                    errors: {},
                    saveError: '',
                    runResult: null,
                    lock: null,
                    lockBusy: false,
                    toasts: [],
                    leaving: false,
                    confirm: { visible: false, title: '', message: '', buttonText: '', buttonClass: '', icon: '', action: null },
                    syncSelects: [
                        { key: 'productWriteModeId', name: 'ProductWriteModeId', label: 'Product write mode', options: 'productWriteModes' },
                        { key: 'unmappedAttributeBehaviorId', name: 'UnmappedAttributeBehaviorId', label: 'Unmapped attribute behavior', options: 'unmappedAttributeBehaviors' },
                        { key: 'productFieldMissingValueBehaviorId', name: 'ProductFieldMissingValueBehaviorId', label: 'Missing product field values', options: 'productFieldMissingValueBehaviors', help: 'What happens to a mapped product field (name, descriptions, price, Published…) when the Akeneo value is empty.' },
                        { key: 'seoFieldMissingValueBehaviorId', name: 'SeoFieldMissingValueBehaviorId', label: 'Missing SEO field values', options: 'seoFieldMissingValueBehaviors', help: 'What happens to a mapped SEO field (meta title, description, slug…) when the Akeneo value is empty.' },
                        { key: 'customPropertyMissingValueBehaviorId', name: 'CustomPropertyMissingValueBehaviorId', label: 'Missing custom property values', options: 'customPropertyMissingValueBehaviors' },
                        { key: 'categorySyncModeId', name: 'CategorySyncModeId', label: 'Category sync mode', options: 'categorySyncModes' },
                        { key: 'specificationAttributeSyncModeId', name: 'SpecificationAttributeSyncModeId', label: 'Specification sync mode', options: 'specificationAttributeSyncModes', help: 'Missing specification values are handled per attribute mapping.' },
                        { key: 'productAttributeSyncModeId', name: 'ProductAttributeSyncModeId', label: 'Product attribute sync mode', options: 'productAttributeSyncModes' },
                        { key: 'assetSyncModeId', name: 'AssetSyncModeId', label: 'Asset sync mode', options: 'assetSyncModes', help: 'Replace managed is recommended: it reconciles only pictures, videos, and asset references owned by this plugin.' },
                        { key: 'missingProductBehaviorId', name: 'MissingProductBehaviorId', label: 'Missing product behavior', options: 'missingProductBehaviors', help: 'Applied only after a complete, successful full run. Delta, canceled, failed, and MaxProducts-limited runs never reconcile missing products.' }
                    ]
                };
            },
            computed: {
                isEdit: function () {
                    return this.id > 0;
                },
                isDirty: function () {
                    return snapshot(this.form) !== this.savedSnapshot;
                },
                comboLocales: function () {
                    return toComboOptions(this.options.locales);
                },
                comboFamilies: function () {
                    return toComboOptions(this.options.families);
                },
                comboCategories: function () {
                    return toComboOptions(this.options.categories);
                },
                runDisabledReason: function () {
                    if (!this.savedEnabled)
                        return 'Enable and save the profile before running it.';
                    if (this.isDirty)
                        return 'Save your changes first. A run uses the saved version of this profile.';
                    return '';
                },
                canRun: function () {
                    return this.isEdit && !this.busy && !this.runDisabledReason;
                },
                lockLooksAbandoned: function () {
                    return !!(this.lock && (this.lock.stale || this.lock.expired));
                },
                errorList: function () {
                    var errors = this.errors;
                    return Object.keys(errors).reduce(function (all, key) {
                        return all.concat(errors[key]);
                    }, []);
                },
                searchJsonError: function () {
                    var json = (this.form.additionalSearchJson || '').trim();

                    if (!json)
                        return '';

                    try {
                        var parsed = JSON.parse(json);
                        return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
                            ? ''
                            : 'Additional search JSON must be a JSON object.';
                    } catch (e) {
                        return 'Additional search JSON is not valid JSON: ' + e.message;
                    }
                },
                updatedModeHelp: function () {
                    switch (this.form.updatedFilterModeId) {
                        case this.modes.fixedDate:
                            return { title: 'Fixed date:', text: 'Each delta run imports products updated after the saved cutoff. Enter the date and time in the configured store time zone; it is converted to UTC when saved.' };
                        case this.modes.rollingDays:
                            return { title: 'Rolling days:', text: 'Each delta run recalculates the cutoff from the current UTC time. This intentionally reprocesses an overlapping recent window.' };
                        case this.modes.none:
                            return { title: 'No updated-date filter:', text: 'Each delta run reads every product in the configured scope, but it does not perform missing-product reconciliation.' };
                        default:
                            return { title: 'Since last successful run:', text: 'Uses the most recent complete run watermark with a two-minute overlap. If no qualifying run exists, the first delta reads the full configured scope.' };
                    }
                },
                runCounts: function () {
                    var counts = (this.runResult && this.runResult.counts) || {};
                    return [
                        { label: 'Read', value: counts.totalRead },
                        { label: 'Created', value: counts.created },
                        { label: 'Updated', value: counts.updated },
                        { label: 'Skipped', value: counts.skipped },
                        { label: 'Failed', value: counts.failed },
                        { label: 'Warnings', value: counts.warnings },
                        { label: 'Reconciled', value: counts.reconciled }
                    ].filter(function (count) { return count.value !== undefined && count.value !== null; });
                }
            },
            mounted: function () {
                var self = this;

                this.loadLock();

                window.addEventListener('beforeunload', function (event) {
                    if (self.isDirty && !self.leaving) {
                        event.preventDefault();
                        event.returnValue = '';
                    }
                });

                document.addEventListener('keydown', function (event) {
                    if ((event.ctrlKey || event.metaKey) && (event.key === 's' || event.key === 'S')) {
                        event.preventDefault();
                        if (!self.busy)
                            self.save();
                    }
                });
            },
            methods: {
                fieldError: function (name) {
                    var messages = this.errors[name];
                    return messages && messages.length ? messages[0] : '';
                },
                notify: function (text) {
                    var self = this;
                    var id = Date.now() + '-' + Math.random().toString(36).slice(2);

                    this.toasts.push({ id: id, text: text });
                    setTimeout(function () { self.dismissToast(id); }, 3000);
                },
                dismissToast: function (id) {
                    this.toasts = this.toasts.filter(function (toast) { return toast.id !== id; });
                },
                buildPostData: function () {
                    var form = this.form;
                    var data = { Id: this.id };

                    Object.keys(postNames).forEach(function (key) {
                        var value = form[key];

                        if (typeof value === 'boolean')
                            value = value ? 'true' : 'false';
                        else if (value === null || value === undefined)
                            value = '';

                        data[postNames[key]] = value;
                    });

                    return data;
                },
                save: function () {
                    var self = this;

                    if (this.searchJsonError) {
                        this.saveError = 'The profile was not saved. Fix the highlighted fields and try again.';
                        this.errors = {};
                        return;
                    }

                    this.busy = 'save';
                    this.saveError = '';

                    $.ajax({
                        type: 'POST',
                        url: appData.urls.save,
                        dataType: 'json',
                        traditional: true,
                        data: addAntiForgeryToken(this.buildPostData())
                    }).done(function (response) {
                        if (!response || !response.success) {
                            self.errors = (response && response.errors) || {};
                            self.saveError = (response && response.message) || 'The profile was not saved.';
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                            return;
                        }

                        self.errors = {};
                        self.id = response.id;
                        self.savedEnabled = response.enabled;
                        self.urls = Object.assign({}, self.urls, response.urls);
                        self.savedSnapshot = snapshot(self.form);

                        if (response.created && window.history && window.history.replaceState)
                            window.history.replaceState(null, '', response.urls.edit);

                        self.notify(response.message || 'Saved.');
                    }).fail(function (xhr) {
                        self.saveError = xhr && xhr.responseJSON && xhr.responseJSON.message
                            ? xhr.responseJSON.message
                            : 'The profile could not be saved (HTTP ' + (xhr ? xhr.status : '?') + ').';
                    }).always(function () {
                        self.busy = false;
                    });
                },
                openConfirm: function (options) {
                    this.confirm = Object.assign({ visible: true }, options);
                },
                acceptConfirm: function () {
                    var action = this.confirm.action;

                    this.confirm.visible = false;

                    if (typeof action === 'function')
                        action();
                },
                confirmRun: function (full) {
                    var self = this;

                    this.openConfirm(full
                        ? {
                            title: 'Run Full Akeneo Reconciliation',
                            message: 'Run a complete authoritative sync now? Updated-date filters are ignored and only 100% complete products are included. If every page succeeds, configured missing-product lifecycle rules will be applied.',
                            buttonText: 'Run Full Reconciliation',
                            buttonClass: 'btn-warning',
                            icon: 'fas fa-sync-alt',
                            action: function () { self.run(true); }
                        }
                        : {
                            title: 'Run Akeneo Sync Profile',
                            message: 'Run this Akeneo sync profile now? This will import products using the saved profile settings.',
                            buttonText: 'Run Profile',
                            buttonClass: 'btn-success',
                            icon: 'fas fa-play',
                            action: function () { self.run(false); }
                        });
                },
                run: function (full) {
                    var self = this;

                    this.busy = full ? 'fullRun' : 'run';
                    this.runResult = null;

                    $.ajax({
                        type: 'POST',
                        url: full ? this.urls.fullRun : this.urls.run,
                        dataType: 'json',
                        data: addAntiForgeryToken({})
                    }).done(function (response) {
                        self.runResult = {
                            cls: response.success
                                ? 'alert-success'
                                : response.canceled || response.completedWithErrors ? 'alert-warning' : 'alert-danger',
                            message: response.message || 'Akeneo sync profile run completed.',
                            counts: response.counts || null,
                            warnings: response.warnings || [],
                            errors: response.errors || []
                        };
                    }).fail(function (xhr) {
                        var response = (xhr && xhr.responseJSON) || {};

                        self.runResult = {
                            cls: 'alert-danger',
                            message: response.message || 'Akeneo product import failed.',
                            counts: null,
                            warnings: [],
                            errors: response.errors || []
                        };
                    }).always(function () {
                        self.busy = false;
                        // A run that was refused ("already running") or just
                        // finished changes the lock state.
                        self.loadLock();
                    });
                },
                loadLock: function () {
                    var self = this;

                    this.lockBusy = true;

                    $.ajax({
                        type: 'GET',
                        url: appData.urls.lockStatus,
                        dataType: 'json',
                        cache: false
                    }).done(function (status) {
                        self.lock = status;
                    }).always(function () {
                        self.lockBusy = false;
                    });
                },
                confirmReleaseLock: function () {
                    var self = this;

                    this.openConfirm({
                        title: 'Release the sync lock',
                        message: this.lockLooksAbandoned
                            ? 'Release the Akeneo catalog lock? The run holding it has not checked in recently and has most likely stopped; it will be marked as cancelled.'
                            : 'This run checked in recently and may still be working. Releasing the lock stops it at its next checkpoint (within about 5 minutes) and marks it as cancelled. Release anyway?',
                        buttonText: 'Release lock',
                        buttonClass: 'btn-danger',
                        icon: 'fas fa-unlock',
                        action: function () { self.releaseLock(); }
                    });
                },
                releaseLock: function () {
                    var self = this;

                    this.lockBusy = true;

                    $.ajax({
                        type: 'POST',
                        url: appData.urls.releaseLock,
                        dataType: 'json',
                        data: addAntiForgeryToken({})
                    }).done(function (response) {
                        self.lock = (response && response.status) || { held: false };
                        self.notify((response && response.message) || 'Sync lock released.');
                    }).fail(function (xhr) {
                        self.saveError = 'The sync lock could not be released (HTTP ' + (xhr ? xhr.status : '?') + ').';
                    }).always(function () {
                        self.lockBusy = false;
                    });
                },
                confirmDelete: function () {
                    var self = this;

                    this.openConfirm({
                        title: 'Delete Akeneo Sync Profile',
                        message: 'Are you sure you want to delete this sync profile? This action cannot be undone.',
                        buttonText: 'Delete',
                        buttonClass: 'btn-danger',
                        icon: 'far fa-trash-alt',
                        action: function () { self.deleteProfile(); }
                    });
                },
                deleteProfile: function () {
                    var self = this;

                    this.busy = 'delete';

                    $.ajax({
                        type: 'POST',
                        url: this.urls.delete,
                        dataType: 'json',
                        data: addAntiForgeryToken({})
                    }).done(function (response) {
                        self.leaving = true;
                        window.location.assign((response && response.redirectUrl) || self.urls.list);
                    }).fail(function (xhr) {
                        self.busy = false;
                        self.saveError = 'The profile could not be deleted (HTTP ' + (xhr ? xhr.status : '?') + ').';
                    });
                }
            }
        });

        app.component('akeneo-combobox', window.AkeneoCombobox);
        app.mount('#akeneo-sync-profile-app');
    })();
</script>
