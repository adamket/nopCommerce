@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoSyncProfileModel

@{
    Layout = "_AdminLayout";

    var isEdit = Model.Id > 0;
    ViewBag.PageTitle = isEdit ? "Edit Akeneo Sync Profile" : "Create Akeneo Sync Profile";
    var postAction = isEdit ? "Edit" : "Create";
    var updatedAfterRowStyle =
        Model.UpdatedFilterModeId == (int)AkeneoUpdatedFilterMode.FixedDate
            ? string.Empty
            : "display:none;";
    var updatedSinceDaysRowStyle =
        Model.UpdatedFilterModeId == (int)AkeneoUpdatedFilterMode.RollingDays
            ? string.Empty
            : "display:none;";

    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.SyncProfiles");
}

<form asp-action="@postAction" method="post" class="akeneo-connection">
    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div class="content-header clearfix">
        <h1 class="float-left">
            <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
            <span>
                @ViewBag.PageTitle
                &nbsp;&nbsp;
                <small>
                    <a asp-action="List"><i class="fas fa-arrow-circle-left"></i> back to sync profile list</a>
                </small>
            </span>
           
        </h1>

        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-save"></i>
                Save
            </button>

            @if (isEdit)
            {
                <button type="button"
                        id="run-akeneo-sync-profile"
                        class="btn btn-success"
                        data-run-url="@Url.Action("ImportProductsByProfile", "AkeneoSync", new { id = Model.Id })"
                        @(Model.Enabled ? null : "disabled")
                        title="Runs the saved version of this profile. Save changes first if you changed any settings.">
                    <i class="fas fa-play"></i>
                    Run Profile
                </button>

                <button type="button"
                        id="run-akeneo-full-sync-profile"
                        class="btn btn-warning"
                        data-run-url="@Url.Action("ImportProductsByProfile", "AkeneoSync", new { id = Model.Id, fullSync = true })"
                        @(Model.Enabled ? null : "disabled")
                        title="Runs a complete authoritative profile pass. Missing-product lifecycle rules are applied only if every page completes successfully.">
                    <i class="fas fa-sync-alt"></i>
                    Run Full Reconciliation
                </button>

                <button type="button"
                        id="delete-akeneo-sync-profile"
                        class="btn btn-danger"
                        data-delete-url="@Url.Action("Delete", "AkeneoSyncProfile", new { id = Model.Id })">
                    <i class="far fa-trash-alt"></i>
                    Delete
                </button>
            }
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (isEdit)
            {
                <div id="akeneo-run-profile-result"
                     class="alert mb-3"
                     style="display:none;"
                     role="alert">
                    <button type="button"
                            class="close"
                            aria-label="Close"
                            onclick="$('#akeneo-run-profile-result').hide();">
                        <span aria-hidden="true">&times;</span>
                    </button>

                    <div id="akeneo-run-profile-message"></div>

                    <div id="akeneo-run-profile-counts"
                         class="mt-2"
                         style="display:none;">
                    </div>

                    <div id="akeneo-run-profile-errors"
                         class="mt-2"
                         style="display:none;">
                    </div>
                </div>
            }

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-id-card"></i>
                        Profile
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="Name" class="control-label">Profile name</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Name" />
                            <span asp-validation-for="Name"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="Enabled" class="control-label">Enabled</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Enabled" />
                            <span asp-validation-for="Enabled"></span>
                        </div>
                    </div>
                    @if (isEdit && !Model.Enabled)
                    {
                        <div class="alert alert-warning mt-2">
                            This profile is disabled. Enable and save the profile before running it.
                        </div>
                    }
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-globe"></i>
                        Akeneo Scope
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="AkeneoChannel" class="control-label">Akeneo channel</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="AkeneoChannel" asp-items="Model.AvailableAkeneoChannels" />
                            <span asp-validation-for="AkeneoChannel"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="SelectedAkeneoLocaleCodes" class="control-label">Akeneo locales</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SelectedAkeneoLocaleCodes"
                                        asp-items="Model.AvailableAkeneoLocales"
                                        asp-multiple="true" />
                            <span asp-validation-for="SelectedAkeneoLocaleCodes"></span>
                          
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-layer-group"></i>
                        Batch Behavior
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="PageSize" class="control-label">Page size</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="PageSize" />
                            <span asp-validation-for="PageSize"></span>
                            <span class="form-text text-muted">Recommended: 100.</span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="MaxProducts" class="control-label">Max products</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="MaxProducts" />
                            <span asp-validation-for="MaxProducts"></span>
                            <span class="form-text text-muted">Optional. Useful for testing small batches.</span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="ContinueOnError" class="control-label">Continue on error</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ContinueOnError" />
                            <span asp-validation-for="ContinueOnError"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="SaveRawPayloadSnapshot" class="control-label">Save raw payload snapshot</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="SaveRawPayloadSnapshot" />
                            <span asp-validation-for="SaveRawPayloadSnapshot"></span>
                        </div>
                    </div>


                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-cogs"></i>
                        Synchronization Behavior
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="ProductWriteModeId" class="control-label">Product write mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="ProductWriteModeId" asp-items="Model.AvailableProductWriteModes" />
                            <span asp-validation-for="ProductWriteModeId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="UnmappedAttributeBehaviorId" class="control-label">Unmapped attribute behavior</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="UnmappedAttributeBehaviorId" asp-items="Model.AvailableUnmappedAttributeBehaviors" />
                            <span asp-validation-for="UnmappedAttributeBehaviorId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="CategorySyncModeId" class="control-label">Category sync mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="CategorySyncModeId" asp-items="Model.AvailableCategorySyncModes" />
                            <span asp-validation-for="CategorySyncModeId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="SpecificationAttributeSyncModeId" class="control-label">Specification sync mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SpecificationAttributeSyncModeId" asp-items="Model.AvailableSpecificationAttributeSyncModes" />
                            <span asp-validation-for="SpecificationAttributeSyncModeId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="ProductAttributeSyncModeId" class="control-label">Product attribute sync mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="ProductAttributeSyncModeId" asp-items="Model.AvailableProductAttributeSyncModes" />
                            <span asp-validation-for="ProductAttributeSyncModeId"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="AssetSyncModeId" class="control-label">Asset sync mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="AssetSyncModeId" asp-items="Model.AvailableAssetSyncModes" />
                            <span asp-validation-for="AssetSyncModeId"></span>
                            <span class="form-text text-muted">
                                Replace managed is recommended: it reconciles only pictures, videos, and asset references owned by this plugin.
                            </span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="MissingProductBehaviorId" class="control-label">Missing product behavior</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="MissingProductBehaviorId" asp-items="Model.AvailableMissingProductBehaviors" />
                            <span asp-validation-for="MissingProductBehaviorId"></span>
                            <span class="form-text text-muted">
                                Applied only after a complete, successful full run. Delta, canceled, failed, and MaxProducts-limited runs never reconcile missing products.
                            </span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="CreateMissingSpecificationAttributeOptions" class="control-label">Create missing specification attribute options</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="CreateMissingSpecificationAttributeOptions" />
                            <span asp-validation-for="CreateMissingSpecificationAttributeOptions"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="CreateMissingProductAttributeValues" class="control-label">Create missing product attribute values</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="CreateMissingProductAttributeValues" />
                            <span asp-validation-for="CreateMissingProductAttributeValues"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-filter"></i>
                        Akeneo Product Filters
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="SelectedAkeneoFamilyCodes" class="control-label">Akeneo families</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SelectedAkeneoFamilyCodes"
                                        asp-items="Model.AvailableAkeneoFamilies"
                                        asp-multiple="true" />
                            <span asp-validation-for="SelectedAkeneoFamilyCodes"></span>
                            <span class="form-text text-muted">
                                Optional. If selected, only products assigned to one or more of these Akeneo families will be imported.
                            </span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="SelectedAkeneoCategoryCodes" class="control-label">Akeneo categories</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="SelectedAkeneoCategoryCodes"
                                        asp-items="Model.AvailableAkeneoCategories"
                                        asp-multiple="true" />
                            <span asp-validation-for="SelectedAkeneoCategoryCodes"></span>
                            <span class="form-text text-muted">
                                Optional. If selected, the chosen category filter mode will be applied to these Akeneo categories.
                            </span>
                        </div>
                    </div>


                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="CategoryFilterModeId" class="control-label">Category filter mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="CategoryFilterModeId" asp-items="Model.AvailableCategoryFilterModes" />
                            <span asp-validation-for="CategoryFilterModeId"></span>
                        </div>
                    </div>

                    @{
                        var selectedProductGroupCodes = Model.SelectedAkeneoProductGroupCodes?
                        .Where(groupCode => !string.IsNullOrWhiteSpace(groupCode))
                        .Select(groupCode => groupCode.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList() ?? new List<string>();
                    }

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="SelectedAkeneoProductGroupCodes" class="control-label">Akeneo product groups</label>
                        </div>

                        <div class="col-md-9">
                            <div id="akeneo-product-group-token-editor"
                                 class="akeneo-token-editor"
                                 data-input-name="SelectedAkeneoProductGroupCodes">

                                <input type="text"
                                       id="akeneo-product-group-input"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="Type an Akeneo group code and press Enter" />

                                <div id="akeneo-product-group-token-list" class="akeneo-token-list">
                                    @foreach (var groupCode in Model.SelectedAkeneoProductGroupCodes ?? new List<string>())
                                    {
                                        if (string.IsNullOrWhiteSpace(groupCode))
                                        {
                                            continue;
                                        }

                                        var trimmedGroupCode = groupCode.Trim();

                                        <span class="akeneo-token-item" data-value="@trimmedGroupCode">
                                            <span class="akeneo-token-text">@trimmedGroupCode</span>
                                            <button type="button"
                                                    class="akeneo-token-remove"
                                                    aria-label="Remove @trimmedGroupCode">
                                                &times;
                                            </button>
                                            <input type="hidden"
                                                   name="SelectedAkeneoProductGroupCodes"
                                                   value="@trimmedGroupCode" />
                                        </span>
                                    }
                                </div>
                            </div>

                            <span asp-validation-for="SelectedAkeneoProductGroupCodes"></span>

                         @*    <span class="form-text text-muted">
                                Optional. Type an Akeneo product group code and press Enter, or leave the field, to add it.
                                If one or more group codes are entered, only products belonging to those groups will be imported.
                            </span> *@
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="ProductEnabledFilterId" class="control-label">Product enabled filter</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="ProductEnabledFilterId" asp-items="Model.AvailableProductEnabledFilters" />
                            <span asp-validation-for="ProductEnabledFilterId"></span>
                        </div>
                    </div>
                    
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="UpdatedFilterModeId" class="control-label">Updated filter mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="UpdatedFilterModeId" asp-items="Model.AvailableUpdatedFilterModes" />
                            <span asp-validation-for="UpdatedFilterModeId"></span>
                            <span class="form-text text-muted">
                                Delta runs use this policy to determine the Akeneo updated cutoff. Full runs ignore it.
                            </span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"></div>
                        <div class="col-md-9">
                            <div id="akeneo-updated-filter-mode-help"
                                 class="alert alert-info py-2 mb-3"
                                 role="status">
                            </div>
                        </div>
                    </div>

                    <div id="akeneo-updated-after-row"
                         class="form-group row"
                         style="@updatedAfterRowStyle">
                        <div class="col-md-3 text-right">
                            <label asp-for="UpdatedAfter" class="control-label">Updated after</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="UpdatedAfter" />
                            <span asp-validation-for="UpdatedAfter"></span>
                            <span class="form-text text-muted">
                                Enter the date and time in the store time zone: <strong>@Model.UpdatedAfterTimeZoneDisplayName</strong>.
                                The value is stored internally as UTC. Required for fixed-date mode.
                            </span>
                        </div>
                    </div>

                    <div id="akeneo-updated-since-days-row"
                         class="form-group row"
                         style="@updatedSinceDaysRowStyle">
                        <div class="col-md-3 text-right">
                            <label asp-for="UpdatedSinceLastNDays" class="control-label">Updated since last N days</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="UpdatedSinceLastNDays" />
                            <span asp-validation-for="UpdatedSinceLastNDays"></span>
                            <span class="form-text text-muted">
                                Required for rolling-days mode and must be greater than zero. Example: 7 reprocesses the most recent seven days on every delta run.
                            </span>
                        </div>
                    </div>

               
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="IncludeLinkedAssetUpdates" class="control-label">Include asset-only updates</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="IncludeLinkedAssetUpdates" />
                            <span asp-validation-for="IncludeLinkedAssetUpdates"></span>
                            <span class="form-text text-muted">
                                Uses Akeneo's linked-entity updated filter during delta runs so a product is revisited when a linked Asset Manager record changes. Requires an active updated cutoff, Akeneo SaaS Enterprise, and linked asset updates enabled in Akeneo.
                            </span>
                        </div>
                    </div>


                     <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="ProductParentFilterModeId" class="control-label">Product parent filter mode</label>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="ProductParentFilterModeId" asp-items="Model.AvailableProductParentFilterModes" />
                            <span asp-validation-for="ProductParentFilterModeId"></span>
                        </div>
                    </div> 
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-code"></i>
                        Advanced
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3 text-right">
                            <label asp-for="AdditionalSearchJson" class="control-label">Additional search JSON</label>
                        </div>
                        <div class="col-md-9">
                            <nop-textarea asp-for="AdditionalSearchJson" />
                            <span asp-validation-for="AdditionalSearchJson"></span>
                            <span class="form-text text-muted">
                                Optional Akeneo search JSON merged into the generated search filter.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
@if (isEdit)
{
    <div class="modal fade"
         id="akeneo-confirm-modal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="akeneo-confirm-modal-title"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="akeneo-confirm-modal-title" class="modal-title">
                        Confirm action
                    </h5>
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <p id="akeneo-confirm-modal-message" class="mb-0"></p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-default"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="akeneo-confirm-modal-confirm"
                            class="btn btn-primary">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
}


<script>
    $(function () {
        var modeSelect = $('#UpdatedFilterModeId');
        var fixedDateRow = $('#akeneo-updated-after-row');
        var rollingDaysRow = $('#akeneo-updated-since-days-row');
        var help = $('#akeneo-updated-filter-mode-help');

        var modes = {
            sinceLastSuccessfulRun: '@((int)AkeneoUpdatedFilterMode.SinceLastSuccessfulRun)',
            fixedDate: '@((int)AkeneoUpdatedFilterMode.FixedDate)',
            rollingDays: '@((int)AkeneoUpdatedFilterMode.RollingDays)',
            none: '@((int)AkeneoUpdatedFilterMode.None)'
        };

        function updateUpdatedFilterFields() {
            var selectedMode = modeSelect.val();

            fixedDateRow.toggle(selectedMode === modes.fixedDate);
            rollingDaysRow.toggle(selectedMode === modes.rollingDays);

            switch (selectedMode) {
                case modes.fixedDate:
                    help.html(
                        '<strong>Fixed date:</strong> Each delta run imports products updated after the saved cutoff. ' +
                        'Enter the date and time in the configured store time zone; it is converted to UTC when saved.'
                    );
                    break;

                case modes.rollingDays:
                    help.html(
                        '<strong>Rolling days:</strong> Each delta run recalculates the cutoff from the current UTC time. ' +
                        'This intentionally reprocesses an overlapping recent window.'
                    );
                    break;

                case modes.none:
                    help.html(
                        '<strong>No updated-date filter:</strong> Each delta run reads every product in the configured scope, ' +
                        'but it does not perform missing-product reconciliation.'
                    );
                    break;

                default:
                    help.html(
                        '<strong>Since last successful run:</strong> Uses the most recent complete run watermark with a two-minute overlap. ' +
                        'If no qualifying run exists, the first delta reads the full configured scope.'
                    );
                    break;
            }
        }

        modeSelect.on('change', updateUpdatedFilterFields);
        updateUpdatedFilterFields();
    });
</script>

<script>
        $(function () {
        var editor = $('#akeneo-product-group-token-editor');

        if (!editor.length) {
            return;
        }

        var input = $('#akeneo-product-group-input');
        var list = $('#akeneo-product-group-token-list');
        var inputName = editor.data('input-name');

        function normalizeValue(value) {
            return $.trim(value || '');
        }

        function encodeHtml(value) {
            return $('<div />').text(value || '').html();
        }

        function valueExists(value) {
            var normalized = value.toLowerCase();
            var exists = false;

            list.find('.akeneo-token-item').each(function () {
                var existingValue = normalizeValue($(this).data('value')).toLowerCase();

                if (existingValue === normalized) {
                    exists = true;
                    return false;
                }
            });

            return exists;
        }

        function addToken(value) {
            value = normalizeValue(value);

            if (!value || valueExists(value)) {
                input.val('');
                return;
            }

            var encodedValue = encodeHtml(value);

            var token = $(
                '<span class="akeneo-token-item" data-value="' + encodedValue + '">' +
                    '<span class="akeneo-token-text">' + encodedValue + '</span>' +
                    '<button type="button" class="akeneo-token-remove" aria-label="Remove ' + encodedValue + '">&times;</button>' +
                    '<input type="hidden" name="' + inputName + '" value="' + encodedValue + '" />' +
                '</span>'
            );

            list.append(token);
            input.val('');
        }

        input.on('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                addToken(input.val());
            }
        });

        input.on('blur', function () {
            addToken(input.val());
        });

        list.on('click', '.akeneo-token-remove', function () {
            $(this).closest('.akeneo-token-item').remove();
        });
    });
</script>


@if (isEdit)
{
    <script>
        $(function () {
            var runButton = $('#run-akeneo-sync-profile');
            var fullRunButton = $('#run-akeneo-full-sync-profile');
            var deleteButton = $('#delete-akeneo-sync-profile');

            var resultContainer = $('#akeneo-run-profile-result');
            var messageContainer = $('#akeneo-run-profile-message');
            var countsContainer = $('#akeneo-run-profile-counts');
            var errorsContainer = $('#akeneo-run-profile-errors');

            var confirmModal = $('#akeneo-confirm-modal');
            var confirmModalTitle = $('#akeneo-confirm-modal-title');
            var confirmModalMessage = $('#akeneo-confirm-modal-message');
            var confirmModalConfirmButton = $('#akeneo-confirm-modal-confirm');

            function encodeHtml(value) {
                return $('<div />').text(value || '').html();
            }

            function showConfirmModal(options) {
                confirmModalTitle.text(options.title || 'Confirm action');
                confirmModalMessage.text(options.message || 'Are you sure?');

                confirmModalConfirmButton
                    .removeClass('btn-primary btn-success btn-danger btn-warning')
                    .addClass(options.confirmButtonClass || 'btn-primary')
                    .html(options.confirmButtonText || 'Confirm')
                    .off('click')
                    .on('click', function () {
                        confirmModal.modal('hide');

                        if (typeof options.onConfirm === 'function') {
                            options.onConfirm();
                        }
                    });

                confirmModal.modal('show');
            }

            function setRunButtonLoading(button, isLoading) {
                if (isLoading) {
                    if (!button.data('original-html')) {
                        button.data('original-html', button.html());
                    }

                    runButton.prop('disabled', true);
                    fullRunButton.prop('disabled', true);
                    button.html('<span class="akeneo-button-spinner" aria-hidden="true"></span>Running...');
                } else {
                    button.html(button.data('original-html'));
                    runButton.prop('disabled', false);
                    fullRunButton.prop('disabled', false);
                }
            }

            function resetRunResult() {
                resultContainer
                    .removeClass('alert-success alert-warning alert-danger')
                    .hide();

                messageContainer.empty();

                countsContainer
                    .empty()
                    .hide();

                errorsContainer
                    .empty()
                    .hide();
            }

            function showRunResult(response) {
                resetRunResult();

                if (response.success) {
                    resultContainer.addClass('alert-success');
                } else if (response.canceled || response.completedWithErrors) {
                    resultContainer.addClass('alert-warning');
                } else {
                    resultContainer.addClass('alert-danger');
                }

                messageContainer.html(
                    '<strong>' + encodeHtml(response.message || 'Akeneo sync profile run completed.') + '</strong>'
                );

                if (response.counts) {
                    countsContainer
                        .html(
                            '<div class="row">' +
                                '<div class="col-md-2"><strong>Read:</strong> ' + encodeHtml(response.counts.totalRead) + '</div>' +
                                '<div class="col-md-2"><strong>Created:</strong> ' + encodeHtml(response.counts.created) + '</div>' +
                                '<div class="col-md-2"><strong>Updated:</strong> ' + encodeHtml(response.counts.updated) + '</div>' +
                                '<div class="col-md-2"><strong>Skipped:</strong> ' + encodeHtml(response.counts.skipped) + '</div>' +
                                '<div class="col-md-2"><strong>Failed:</strong> ' + encodeHtml(response.counts.failed) + '</div>' +
                                '<div class="col-md-2"><strong>Warnings:</strong> ' + encodeHtml(response.counts.warnings) + '</div>' +
                                '<div class="col-md-2"><strong>Reconciled:</strong> ' + encodeHtml(response.counts.reconciled) + '</div>' +
                            '</div>'
                        )
                        .show();
                }

                var issueHtml = '';

                if (response.warnings && response.warnings.length) {
                    issueHtml += '<strong>Warnings:</strong><ul>';

                    $.each(response.warnings, function (_, warning) {
                        issueHtml += '<li>' + encodeHtml(warning) + '</li>';
                    });

                    issueHtml += '</ul>';
                }

                if (response.errors && response.errors.length) {
                    issueHtml += '<strong>Errors:</strong><ul class="mb-0">';

                    $.each(response.errors, function (_, error) {
                        issueHtml += '<li>' + encodeHtml(error) + '</li>';
                    });

                    issueHtml += '</ul>';
                }

                if (issueHtml) {
                    errorsContainer
                        .html(issueHtml)
                        .show();
                }

                resultContainer.show();
            }

            function showRunError(xhr) {
                resetRunResult();

                var message = 'Akeneo product import failed.';

                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    message = xhr.responseText;
                }

                resultContainer.addClass('alert-danger');
                messageContainer.html('<strong>' + encodeHtml(message) + '</strong>');
                resultContainer.show();
            }

            function runProfile(button) {
                var runUrl = button.data('run-url');

                if (!runUrl) {
                    showRunError({
                        responseJSON: {
                            message: 'Run URL was not found.'
                        }
                    });
                    return;
                }

                resetRunResult();
                setRunButtonLoading(button, true);

                $.ajax({
                    type: 'POST',
                    url: runUrl,
                    data: addAntiForgeryToken({}),
                    success: function (response) {
                        showRunResult(response);
                    },
                    error: function (xhr) {
                        showRunError(xhr);
                    },
                    complete: function () {
                        setRunButtonLoading(button, false);
                    }
                });
            }

            function deleteProfile() {
                var deleteUrl = deleteButton.data('delete-url');

                if (!deleteUrl) {
                    return;
                }

                var deleteForm = $('<form>', {
                    method: 'post',
                    action: deleteUrl
                });

                deleteForm.append(
                    $('<input>', {
                        type: 'hidden',
                        name: '__RequestVerificationToken',
                        value: $('input[name="__RequestVerificationToken"]').val()
                    })
                );

                $('body').append(deleteForm);
                deleteForm.trigger('submit');
            }

            runButton.on('click', function () {
                showConfirmModal({
                    title: 'Run Akeneo Sync Profile',
                    message: 'Run this Akeneo sync profile now? This will import products using the saved profile settings.',
                    confirmButtonText: '<i class="fas fa-play"></i> Run Profile',
                    confirmButtonClass: 'btn-success',
                    onConfirm: function () { runProfile(runButton); }
                });
            });

            fullRunButton.on('click', function () {
                showConfirmModal({
                    title: 'Run Full Akeneo Reconciliation',
                    message: 'Run a complete authoritative sync now? Updated-date filters are ignored. If every page succeeds, configured missing-product lifecycle rules will be applied.',
                    confirmButtonText: '<i class="fas fa-sync-alt"></i> Run Full Reconciliation',
                    confirmButtonClass: 'btn-warning',
                    onConfirm: function () { runProfile(fullRunButton); }
                });
            });

            deleteButton.on('click', function () {
                showConfirmModal({
                    title: 'Delete Akeneo Sync Profile',
                    message: 'Are you sure you want to delete this sync profile? This action cannot be undone.',
                    confirmButtonText: '<i class="far fa-trash-alt"></i> Delete',
                    confirmButtonClass: 'btn-danger',
                    onConfirm: deleteProfile
                });
            });
        });
    </script>


}