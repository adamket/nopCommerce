                        m.errors = [];

                        this.resetDraftFromMapping(m);
                    },
                    resetStandardMappingAfterDelete: function (m) {
                        m.id = 0;
                        m.mappingKey = '';
                        m.name = '';
                        m.valueModeId = this.valueModes.singleAttribute;
                        m.valueTemplate = '';
                        m.isComputed = false;
                        m.akeneoFamilyCode = '';
                        m.isInherited = false;
                        m.nopTargetTypeId = String(this.targetTypes.ignore);
                        m.nopTargetKey = '';
                        m.nopTargetEntityId = '';
                        m.isRequired = false;
                        m.entityScopeId = entityScopes.all;
                        m.fallbackSources = [];
                        m.transformRuleJson = '';
                        m.clientAdded = false;
                        m.editing = false;
                        m.errors = [];

                        this.resetDraftFromMapping(m);
                    },
                    resetDraftFromMapping: function (m) {
                        var entityScopeId = normalizeEntityScopeId(
                            m.entityScopeId);

                        m.draft.name = m.name || '';
                        m.draft.valueTemplate = m.valueTemplate || '';
                        m.draft.selectedTemplateToken = '';
                        m.draft.nopTargetTypeId = m.nopTargetTypeId;
                        m.draft.nopTargetKey = m.nopTargetKey;
                        m.draft.nopTargetEntityId = m.nopTargetEntityId;
                        m.draft.referenceEntityAttributeCode =
                            m.referenceEntityAttributeCode || '';
                        m.draft.isRequired = !!m.isRequired;
                        m.draft.applyToProductModels = hasEntityScope(
                            entityScopeId,
                            entityScopes.productModel);
                        m.draft.applyToVariantProducts = hasEntityScope(
                            entityScopeId,
                            entityScopes.variantProduct);
                        m.draft.applyToStandaloneProducts = hasEntityScope(
                            entityScopeId,
                            entityScopes.standaloneProduct);
                        m.draft.fallbackSources = cloneFallbackSources(
                            m.fallbackSources);
                        m.draft.transformRuleJson =
                            m.transformRuleJson || '';
                        m.draft.showTransform = !!(
                            m.transformRuleJson &&
                            m.transformRuleJson.trim());
                    },
                        referenceContainerKeyForMapping: function (m) {
        return [
            m.group || 'ungrouped',
            m.code || '',
            m.referenceEntityCode || ''
        ]
            .join('::')
            .toLowerCase();
    },

    isReferenceExpanded: function (key) {
        // Reference field lists are collapsed on initial page load.
        return this.referenceExpanded[key] === true;
    },

    toggleReferenceContainer: function (entry) {
        if (!entry || !entry.items.length)
            return;

        this.referenceExpanded[entry.key] =
            !this.isReferenceExpanded(entry.key);
    },

    activeReferenceFieldCode: function (m) {
        if (m.editing && m.draft) {
            return m.draft.referenceEntityAttributeCode || '';
        }

        return m.referenceEntityAttributeCode || '';
    },

    referenceFieldText: function (m) {
        var selectedCode = this.activeReferenceFieldCode(m);

        if (!selectedCode) {
            return 'Select a reference entity field';
        }

        var selected = m.availableReferenceEntityAttributes.find(
            function (option) {
                return String(option.value).toLowerCase() ===
                    String(selectedCode).toLowerCase();
            });

        return selected
            ? selected.text
            : selectedCode;
    },

    referenceMappingCount: function (entry) {
        return entry.items.filter(function (mapping) {
            return (Number(mapping.id) > 0 || mapping.isInherited) &&
                !!this.activeReferenceFieldCode(mapping);
        }, this).length;
    },
                    save: function (m) {
                        var self = this;
                        var d = m.draft;

                        m.errors = [];

                        var entityScopeId =
                            this.entityScopeIdFromDraft(d);

                        if (!entityScopeId) {
                            m.errors = [
                                'Select at least one destination under Apply mapping to.'
                            ];
                            return;
                        }

                        m.saving = true;

                        $.ajax({
                            type: 'POST',
                            url: appData.saveUrl,
                            data: addAntiForgeryToken({
                                Id: m.isInherited ? 0 : m.id,
                                MappingKey: m.mappingKey || '',
                                Name: d.name || '',
                                ValueModeId: m.valueModeId,
                                ValueTemplate: d.valueTemplate || '',
                                AkeneoFamilyCode: self.selectedFamilyCode || '',
                                AkeneoAttributeCode: m.code || '',
                                AkeneoAttributeTypeId: m.attributeTypeId,
                                AkeneoReferenceEntityCode: m.referenceEntityCode || '',
                                AkeneoReferenceEntityAttributeCode: d.referenceEntityAttributeCode || '',
                                NopTargetTypeId: d.nopTargetTypeId,
                                NopTargetKey: d.nopTargetKey || '',
                                NopTargetEntityId: d.nopTargetEntityId || '',
                                IsRequired: d.isRequired,
                                EntityScopeId: entityScopeId,
                                FallbackSourcesJson: JSON.stringify(
                                    (d.fallbackSources || []).map(function (source, index) {
                                        return {
                                            AkeneoAttributeCode: source.akeneoAttributeCode,
                                            AkeneoAttributeTypeId: source.akeneoAttributeTypeId,
                                            AkeneoReferenceEntityCode: source.akeneoReferenceEntityCode || '',
                                            AkeneoReferenceEntityAttributeCode: source.akeneoReferenceEntityAttributeCode || '',
                                            DisplayOrder: index
                                        };
                                    })),
                                TransformRuleJson: d.transformRuleJson || ''
                            }),
                            success: function (res) {
                                if (!res || !res.success) {
                                    m.errors = (res && res.errors) ? res.errors : ['Unable to save mapping.'];
                                    return;
                                }

                                m.id = res.id;
                                m.mappingKey = res.mappingKey || m.mappingKey;
                                m.name = d.name || '';
                                m.valueTemplate = d.valueTemplate || '';
                                m.label = m.isComputed
                                    ? m.name
                                    : m.label;
                                m.clientAdded = false;
                                m.akeneoFamilyCode = self.selectedFamilyCode || '';
                                m.isInherited = false;
                                m.nopTargetTypeId = d.nopTargetTypeId;
                                m.nopTargetKey = d.nopTargetKey;
                                m.nopTargetEntityId = d.nopTargetEntityId;
                                m.referenceEntityAttributeCode = d.referenceEntityAttributeCode;
                                m.isRequired = d.isRequired;
                                m.entityScopeId = entityScopeId;
                                m.fallbackSources =
                                    cloneFallbackSources(d.fallbackSources);
                                m.transformRuleJson = d.transformRuleJson;

                                m.editing = false;
                                self.notify('Mapping saved - ' + self.mappingDisplayName(m));
                            },
                            error: function () {
                                m.errors = ['Unable to save mapping due to a server error.'];
                            },
                            complete: function () {
                                m.saving = false;
                            }
                        });
                    }
                }
            }).mount('#akeneo-mapping-app');
        })();
</script>
