@using Apt.Nop.Plugin.Misc.AkeneoConnection.Types
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Factories
@using Apt.Nop.Plugin.Misc.AkeneoConnection.Domain
@model Apt.Nop.Plugin.Misc.AkeneoConnection.Models.AkeneoAttributeMappingListModel
<!script src="@Url.Content("~/Plugins/Apt.Misc.AkeneoConnection/Content/Libraries/Vue/vue.global.js")?build=20260712-1"></!script>
@{
    Layout = "_AdminLayout";
    NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Scripts/akeneo-connection.admin.js");
    //  NopHtml.AddScriptParts(ResourceLocation.Footer, $"{AkeneoConnectionConstants.PathToPlugin}/Content/Libraries/Vue/vue.global.js");
    NopHtml.AddCssFileParts($"{AkeneoConnectionConstants.PathToPlugin}/Content/Stylesheets/akeneo-connection.admin.css");
    NopHtml.SetActiveMenuItemSystemName("AkeneoIntegration.AttributeMappings");

    ViewBag.PageTitle = "Akeneo Connection - Attribute Mappings";

    var appModel = new
    {
        listUrl = Url.Action("AttributeMappings", "AkeneoMapping"),
        saveUrl = Url.Action("SaveAttributeMappingRow", "AkeneoMapping"),
        deleteMappingUrl = Url.Action("DeleteAttributeMappingRow", "AkeneoMapping"),
        selectedFamilyCode = Model.AkeneoFamilyCode ?? string.Empty,
        availableFamilies = Model.AvailableAkeneoFamilies
            .Where(f => !string.IsNullOrWhiteSpace(f.Value))
            .Select(f => new
            {
                value = f.Value,
                text = f.Text
            }).ToList(),
        targetTypes = new
        {
            ignore = (int)NopTargetType.Ignore,
            productField = (int)NopTargetType.ProductField,
            seoField = (int)NopTargetType.SeoField,
            customProperty = (int)NopTargetType.CustomProperty,
            specificationAttribute = (int)NopTargetType.SpecificationAttribute,
            productAttribute = (int)NopTargetType.ProductAttribute
        },
        valueModes = new
        {
            singleAttribute = (int)AkeneoAttributeMappingValueMode.SingleAttribute,
            template = (int)AkeneoAttributeMappingValueMode.Template
        },
        entityScopes = new
        {
            productModel = (int)AkeneoAttributeMappingEntityScope.ProductModel,
            variantProduct = (int)AkeneoAttributeMappingEntityScope.VariantProduct,
            standaloneProduct = (int)AkeneoAttributeMappingEntityScope.StandaloneProduct,
            all = (int)AkeneoAttributeMappingEntityScope.All
        },
        computedTargetTypes = new[]
        {
            new { value = ((int)NopTargetType.Ignore).ToString(), text = "Ignore" },
            new { value = ((int)NopTargetType.ProductField).ToString(), text = "Product Field" },
            new { value = ((int)NopTargetType.SpecificationAttribute).ToString(), text = "Specification Attribute" },
            new { value = ((int)NopTargetType.ProductAttribute).ToString(), text = "Product Attribute" },
            new { value = ((int)NopTargetType.SeoField).ToString(), text = "SEO Field" },
            new { value = ((int)NopTargetType.CustomProperty).ToString(), text = "Custom Property" }
        },
        availableSpecificationAttributes = Model.AvailableSpecificationAttributes
            .Select(option => new { value = option.Value, text = option.Text })
            .ToList(),
        availableProductAttributes = Model.AvailableProductAttributes
            .Select(option => new { value = option.Value, text = option.Text })
            .ToList(),
        availableFallbackSources = Model.AvailableFallbackSources.Select(source => new
        {
            key = source.Key,
            text = source.Text,
            akeneoAttributeCode = source.AkeneoAttributeCode,
            akeneoAttributeTypeId = source.AkeneoAttributeTypeId,
            akeneoReferenceEntityCode = source.AkeneoReferenceEntityCode ?? string.Empty,
            akeneoReferenceEntityAttributeCode = source.AkeneoReferenceEntityAttributeCode ?? string.Empty
        }).ToList(),
        referenceEntityAttributes = Model.ReferenceEntityAttributes
            .Select((attribute, idx) => new
            {
                index = idx,
                key = string.Join("::", new[]
                {
                    string.IsNullOrWhiteSpace(attribute.GroupCode)
                        ? "ungrouped"
                        : attribute.GroupCode,
                    attribute.Code ?? string.Empty,
                    attribute.ReferenceEntityCode ?? string.Empty
                }).ToLowerInvariant(),
                code = attribute.Code ?? string.Empty,
                label = attribute.Label ?? attribute.Code ?? string.Empty,
                type = attribute.Type ?? string.Empty,
                group = string.IsNullOrWhiteSpace(attribute.GroupCode)
                    ? "ungrouped"
                    : attribute.GroupCode,
                groupLabel = string.IsNullOrWhiteSpace(attribute.GroupLabel)
                    ? "Ungrouped"
                    : attribute.GroupLabel,
                attributeTypeId = attribute.AttributeTypeId,
                isLocalizable = attribute.IsLocalizable,
                isScopable = attribute.IsScopable,
                isReferenceEntityAttribute = attribute.IsReferenceEntityAttribute,
                referenceEntityCode = attribute.ReferenceEntityCode ?? string.Empty,
                defaultNopTargetTypeId = attribute.DefaultNopTargetTypeId.ToString(),
                defaultNopTargetKey = attribute.DefaultNopTargetKey ?? string.Empty,
                availableTargetTypes = attribute.AvailableTargetTypes
                    .Select(option => new { value = option.Value, text = option.Text }),
                availableSpecificationAttributes = attribute.AvailableSpecificationAttributes
                    .Select(option => new { value = option.Value, text = option.Text }),
                availableProductAttributes = attribute.AvailableProductAttributes
                    .Select(option => new { value = option.Value, text = option.Text }),
                availableReferenceEntityAttributes = attribute.AvailableReferenceEntityAttributes
                    .Select(option => new { value = option.Value, text = option.Text })
            })
            .ToList(),
        mappings = Model.Mappings.Select((m, idx) => new
        {
            index = idx,
            id = m.Id,
            mappingKey = m.MappingKey ?? string.Empty,
            name = m.Name ?? string.Empty,
            valueModeId = m.ValueModeId,
            valueTemplate = m.ValueTemplate ?? string.Empty,
            isComputed = m.IsComputed,
            akeneoFamilyCode = m.AkeneoFamilyCode ?? string.Empty,
            isInherited = m.IsInherited,
            code = m.AkeneoAttributeCode,
            label = m.AkeneoAttributeLabel,
            type = m.AkeneoAttributeType,
            group = string.IsNullOrWhiteSpace(m.AkeneoAttributeGroup) ? "ungrouped" : m.AkeneoAttributeGroup,
            groupLabel = string.IsNullOrWhiteSpace(m.AkeneoAttributeGroupLabel) ? "Ungrouped" : m.AkeneoAttributeGroupLabel,
            attributeTypeId = m.AkeneoAttributeTypeId,
            isLocalizable = m.IsLocalizable,
            isScopable = m.IsScopable,
            isReferenceEntityAttribute = m.IsReferenceEntityAttribute,
            referenceEntityCode = m.AkeneoReferenceEntityCode ?? string.Empty,
            referenceEntityAttributeCode = m.AkeneoReferenceEntityAttributeCode ?? string.Empty,
            nopTargetTypeId = m.NopTargetTypeId.ToString(),
            nopTargetKey = m.NopTargetKey ?? string.Empty,
            defaultNopTargetTypeId = m.DefaultNopTargetTypeId.ToString(),
            defaultNopTargetKey = m.DefaultNopTargetKey ?? string.Empty,
            nopTargetEntityId = m.NopTargetEntityId?.ToString() ?? string.Empty,
            isRequired = m.IsRequired,
            entityScopeId = m.EntityScopeId,
            fallbackSources = m.FallbackSources.Select(source => new
            {
                akeneoAttributeCode = source.AkeneoAttributeCode,
                akeneoAttributeTypeId = source.AkeneoAttributeTypeId,
                akeneoReferenceEntityCode = source.AkeneoReferenceEntityCode ?? string.Empty,
                akeneoReferenceEntityAttributeCode = source.AkeneoReferenceEntityAttributeCode ?? string.Empty,
                displayOrder = source.DisplayOrder
            }).ToList(),
            transformRuleJson = m.TransformRuleJson ?? string.Empty,
            availableTargetTypes = m.AvailableTargetTypes.Select(o => new { value = o.Value, text = o.Text }),
            availableSpecificationAttributes = m.AvailableSpecificationAttributes.Select(o => new { value = o.Value, text = o.Text }),
            availableProductAttributes = m.AvailableProductAttributes.Select(o => new { value = o.Value, text = o.Text }),
            availableReferenceEntityAttributes = m.AvailableReferenceEntityAttributes.Select(o => new { value = o.Value, text = o.Text })
        }).ToList()
    };
}

<div class="akeneo-connection">
    @Html.AntiForgeryToken()

    <div class="content-header clearfix">
        <div class="float-left">
            <div class="akeneo-eyebrow">Akeneo &rarr; nopCommerce</div>
            <h1 class="m-0">Attribute Mapping</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div id="akeneo-mapping-app" class="card card-default" v-cloak>
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-project-diagram"></i>
                        Attribute Mappings
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="akeneo-toolbar">
                        <div class="akeneo-toolbar-panel akeneo-toolbar-panel--scope">
                            <div class="akeneo-toolbar-panel-label">
                                <i class="fas fa-layer-group"></i>
                                <span>Mapping scope</span>
                            </div>
                            <div class="akeneo-toolbar-panel-body">
                                <select id="akeneo-family-scope"
                                        class="form-control"
                                        v-model="selectedFamilyCode"
                                        v-on:change="changeFamilyScope">
                                    <option value="">Global defaults</option>
                                    <option v-for="family in availableFamilies"
                                            v-bind:key="family.value"
                                            v-bind:value="family.value">
                                        {{ family.text }}
                                    </option>
                                </select>
                                <div class="akeneo-toolbar-panel-hint">
                                    <template v-if="selectedFamilyCode">
                                        Editing overrides for <strong>{{ selectedFamilyLabel }}</strong>. Rows marked
                                        <strong>Inherited</strong> still use the global mapping.
                                    </template>
                                    <template v-else>
                                        Global mappings are used by every family unless a family defines an override.
                                    </template>
                                </div>
                            </div>
                        </div>

                        <div class="akeneo-toolbar-panel akeneo-toolbar-panel--actions">
                            <div class="akeneo-toolbar-panel-label">
                                <i class="fas fa-bolt"></i>
                                <span>Actions</span>
                            </div>
                            <div class="akeneo-toolbar-panel-body">
                                <button type="button"
                                        class="btn btn-primary"
                                        v-on:click="addComputedMapping">
                                    <i class="fas fa-plus"></i>
                                    Add computed mapping
                                </button>
                                <div class="akeneo-toolbar-panel-hint">
                                    Build one nopCommerce value from multiple Akeneo attributes.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-4" v-if="!groups.length">
                        <div class="alert alert-info mb-0">
                            {{ selectedFamilyCode
                            ? 'No Akeneo attributes were found for the selected family.'
                            : 'No Akeneo attributes were found. Check the Sync Context connection, then reload this page.' }}
                        </div>
                    </div>

                    <div class="akeneo-list" v-else>
                        <template v-for="group in groups"
                                  v-bind:key="group.key">

                            <div class="akeneo-group-row">
                                <button type="button"
                                        class="btn btn-link p-0 akeneo-attribute-group-toggle"
                                        v-bind:aria-expanded="isExpanded(group.key)
                        ? 'true'
                        : 'false'"
                                        v-on:click="toggleGroup(group.key)">

                                    <i class="fas fa-chevron-right chevron"></i>
                                    <span>{{ group.label }}</span>
                                </button>

                                <span class="akeneo-group-count ml-2">
                                    {{ group.entries.length }}
                                </span>

                                <span class="akeneo-group-code ml-2"
                                      v-if="group.code && group.code !== '__computed'">
                                    {{ group.code }}
                                </span>
                            </div>

                            <transition name="akeneo-group-items">
                                <div class="akeneo-group-items"
                                     v-if="isExpanded(group.key)">

                                    <template v-for="(entry, entryIndex) in group.entries"
                                              v-bind:key="entry.key">

                                        <!-- Normal Akeneo attribute -->
                                        <template v-if="!entry.isReferenceEntity">
                                            <template v-for="(m, itemIndex) in entry.items"
                                                      v-bind:key="m.clientKey">

                                                @await Html.PartialAsync($"{AkeneoConnectionConstants.PathToPlugin}/Views/AttributeMapping/_AttributeMappingRow.cshtml")
                                            </template>
                                        </template>

                                        <!-- Reference entity mapping container -->
                                        <div v-else
                                             class="akeneo-reference-container"
                                             v-bind:style="rowStaggerStyle(entryIndex)">

                                            <div class="akeneo-reference-container-header">
                                                <button type="button"
                                                        class="akeneo-reference-container-toggle"
                                                        v-bind:disabled="!entry.items.length"
                                                        v-bind:aria-expanded="entry.items.length && isReferenceExpanded(entry.key)
                                        ? 'true'
                                        : 'false'"
                                                        v-on:click="toggleReferenceContainer(entry)">

                                                    <i v-if="entry.items.length"
                                                       class="fas fa-chevron-right chevron"></i>

                                                    <span class="akeneo-reference-container-title">
                                                        <span class="akeneo-code">
                                                            {{ entry.definition.code }}
                                                        </span>

                                                        <span class="akeneo-label">
                                                            {{ entry.definition.label }}
                                                        </span>
                                                    </span>
                                                </button>

                                                <div class="akeneo-reference-container-meta">
                                                    <span class="akeneo-type-chip">
                                                        {{ entry.definition.type }}
                                                    </span>

                                                    <span class="akeneo-reference-entity-chip">
                                                        <i class="fas fa-database"></i>
                                                        {{ entry.definition.referenceEntityCode }}
                                                    </span>

                                                    <span class="akeneo-reference-mapping-count">
                                                        {{ referenceMappingCount(entry) }}
                                                        {{
                                                        referenceMappingCount(entry) === 1
                                                        ? 'field mapping'
                                                        : 'field mappings'
                                                        }}
                                                    </span>

                                                    <div class="akeneo-flags"
                                                         aria-label="Attribute localization and scope">

                                                        <span class="akeneo-flag"
                                                              v-bind:class="{
                                              on: entry.definition.isLocalizable
                                          }">
                                                            L
                                                        </span>

                                                        <span class="akeneo-flag"
                                                              v-bind:class="{
                                              on: entry.definition.isScopable
                                          }">
                                                            S
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="akeneo-reference-container-actions">
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary"
                                                            v-if="canAddReferenceMapping(entry)"
                                                            v-on:click.stop="addReferenceMapping(entry)">

                                                        <i class="fas fa-plus"></i>
                                                        Add field mapping
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="akeneo-reference-field-list"
                                                 v-show="entry.items.length && isReferenceExpanded(entry.key)">

                                                <div class="akeneo-reference-field-list-heading">
                                                    <div>
                                                        <div class="akeneo-reference-field-list-title">
                                                            Reference entity attribute mappings
                                                        </div>

                                                        <div class="akeneo-reference-field-list-description">
                                                            Each reference entity field can map independently
                                                            to a nopCommerce product field, SEO field,
                                                            product attribute, or specification attribute.
                                                        </div>
                                                    </div>
                                                </div>

                                                <template v-for="(m, itemIndex) in entry.items"
                                                          v-bind:key="m.clientKey">

                                                    @await Html.PartialAsync($"{AkeneoConnectionConstants.PathToPlugin}/Views/AttributeMapping/_AttributeMappingRow.cshtml")
                                                </template>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </transition>
                        </template>
                    </div>
                </div>

                <div v-if="deleteConfirmation.visible"
                     class="modal fade show"
                     style="display: block;"
                     tabindex="-1"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="akeneo-delete-mapping-modal-title">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 id="akeneo-delete-mapping-modal-title"
                                    class="modal-title">
                                    {{ deleteConfirmationTitle() }}
                                </h5>
                                <button type="button"
                                        class="close"
                                        aria-label="Close"
                                        v-bind:disabled="deleteConfirmation.busy"
                                        v-on:click="closeDeleteConfirmation">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                <p v-bind:class="deleteConfirmation.mapping &&
                                    deleteConfirmation.mapping.errors.length
                                        ? 'mb-3'
                                        : 'mb-0'">
                                    {{ deleteConfirmationMessage() }}
                                </p>

                                <div class="alert alert-danger mb-0"
                                     v-if="deleteConfirmation.mapping &&
                                         deleteConfirmation.mapping.errors.length">
                                    <ul class="mb-0">
                                        <li v-for="error in deleteConfirmation.mapping.errors"
                                            v-bind:key="error">
                                            {{ error }}
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-default"
                                        v-bind:disabled="deleteConfirmation.busy"
                                        v-on:click="closeDeleteConfirmation">
                                    Cancel
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        v-bind:disabled="deleteConfirmation.busy"
                                        v-on:click="confirmDeleteMapping">
                                    <span v-if="deleteConfirmation.busy" class="akeneo-button-spinner" aria-hidden="true"></span>
                                    <i v-else class="fas" v-bind:class="selectedFamilyCode ? 'fa-undo' : 'fa-trash'"></i>
                                    {{ deleteConfirmation.busy
                                        ? 'Removing...'
                                        : deleteConfirmation.mapping &&
                                          deleteConfirmation.mapping.clientAdded
                                        ? 'Remove mapping'
                                        : selectedFamilyCode
                                        ? 'Remove override'
                                        : 'Delete mapping' }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div v-if="deleteConfirmation.visible"
                     class="modal-backdrop fade show"
                     v-on:click="closeDeleteConfirmation"></div>

                <div v-if="templateHelpVisible"
                     class="modal fade show"
                     style="display: block;"
                     tabindex="-1"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="akeneo-template-help-modal-title">
                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 id="akeneo-template-help-modal-title" class="modal-title">
                                    <i class="fas fa-question-circle"></i>
                                    Value template help
                                </h5>
                                <button type="button"
                                        class="close"
                                        aria-label="Close"
                                        v-on:click="closeTemplateHelp">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                <p class="mb-0">
                                    Attribute tokens use localized display values by default.
                                    Use <code>{attribute:code}</code> for the raw Akeneo value,
                                    <code>{attr:attribute}</code> to disambiguate an attribute
                                    from a built-in token, and
                                    <code>{root_type == bare_root ? "this" : "that"}</code>
                                    for conditional text. Conditions compare the raw Akeneo code
                                    by default and support <code>==</code> and <code>!=</code>.
                                    Conditional results are template fragments, so
                                    <code>{pack_quantity != 1 ? " {pack_quantity} pack" : ""}</code>
                                    can include the resolved value only when needed. Put the
                                    complete fragment inside the branch instead of using a
                                    <code>+</code> concatenation operator.
                                    Use doubled braces
                                    <span v-pre><code>{{</code> or <code>}}</code></span> for literal braces.
                                    Every referenced value must resolve or this mapping is treated as missing.
                                </p>
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-default"
                                        v-on:click="closeTemplateHelp">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div v-if="templateHelpVisible"
                     class="modal-backdrop fade show"
                     v-on:click="closeTemplateHelp"></div>

                <div class="akeneo-toast-container" aria-live="polite" aria-atomic="true">
                    <transition-group name="akeneo-toast">
                        <div v-for="t in toasts" :key="t.id" class="akeneo-toast" v-on:click="dismissToast(t.id)">
                            <i class="fas fa-check-circle"></i>
                            <span>{{ t.text }}</span>
                        </div>
                    </transition-group>
                </div>
            </div>

            @if (Model.Warnings?.Any() == true)
            {
                <div class="alert alert-warning mt-3">
                    <ul class="mb-0">
                        @foreach (var warning in Model.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

<script id="akeneo-app-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(appModel))</script>
<script id="akeneo-target-key-map" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NopTargetKeyMap))</script>


<script asp-location="Footer">
        (function () {
            var appData = JSON.parse(document.getElementById('akeneo-app-data').textContent);
            var targetKeyMap = JSON.parse(document.getElementById('akeneo-target-key-map').textContent);

            var nextClientKey = appData.mappings.length;
            var entityScopes = appData.entityScopes;
            var valueModes = appData.valueModes;

            function normalizeEntityScopeId(value) {
                var parsed = Number(value) || 0;
                var normalized = parsed & entityScopes.all;

                return normalized || entityScopes.all;
            }

            function hasEntityScope(value, scope) {
                return (normalizeEntityScopeId(value) & scope) === scope;
            }

            function sourceKey(attributeCode, referenceFieldCode) {
                var code = (attributeCode || '').trim();
                var field = (referenceFieldCode || '').trim();
                return field ? code + '::' + field : code;
            }

            function createComputedMappingKey() {
                if (window.crypto && typeof window.crypto.randomUUID === 'function')
                    return window.crypto.randomUUID().replace(/-/g, '');

                return 'computed-' + Date.now().toString(36) + '-' +
                    Math.random().toString(36).slice(2);
            }

            function cloneFallbackSources(sources) {
                return (sources || []).map(function (source, index) {
                    return {
                        sourceKey: source.sourceKey || sourceKey(
                            source.akeneoAttributeCode,
                            source.akeneoReferenceEntityAttributeCode),
                        akeneoAttributeCode: source.akeneoAttributeCode || '',
                        akeneoAttributeTypeId: Number(source.akeneoAttributeTypeId) || 0,
                        akeneoReferenceEntityCode: source.akeneoReferenceEntityCode || '',
                        akeneoReferenceEntityAttributeCode: source.akeneoReferenceEntityAttributeCode || '',
                        displayOrder: index
                    };
                });
            }

            function hydrateMapping(m, clientAdded) {
                var entityScopeId = normalizeEntityScopeId(m.entityScopeId);

                return Object.assign({}, m, {
                    valueModeId: Number(m.valueModeId) || valueModes.singleAttribute,
                    isComputed: !!m.isComputed ||
                        Number(m.valueModeId) === valueModes.template,
                    entityScopeId: entityScopeId,
                    fallbackSources: cloneFallbackSources(m.fallbackSources),
                    clientKey: m.clientKey || ('mapping-' + (++nextClientKey)),
                    clientAdded: !!clientAdded,
                    editing: !!clientAdded,
                    saving: false,
                    deleting: false,
                    errors: [],
                    draft: {
                        name: m.name || '',
                        valueTemplate: m.valueTemplate || '',
                        selectedTemplateToken: '',
                        nopTargetTypeId: m.nopTargetTypeId,
                        nopTargetKey: m.nopTargetKey,
                        nopTargetEntityId: m.nopTargetEntityId,
                        referenceEntityAttributeCode: m.referenceEntityAttributeCode,
                        isRequired: m.isRequired,
                        applyToProductModels: hasEntityScope(
                            entityScopeId,
                            entityScopes.productModel),
                        applyToVariantProducts: hasEntityScope(
                            entityScopeId,
                            entityScopes.variantProduct),
                        applyToStandaloneProducts: hasEntityScope(
                            entityScopeId,
                            entityScopes.standaloneProduct),
                        fallbackSources: cloneFallbackSources(m.fallbackSources),
                        transformRuleJson: m.transformRuleJson,
                        showTransform: !!(m.transformRuleJson && m.transformRuleJson.trim())
                    }
                });
            }

            var mappings = appData.mappings.map(function (m) {
                return hydrateMapping(m, false);
            });

            var referenceEntityAttributes =
                appData.referenceEntityAttributes || [];

            Vue.createApp({
                data: function () {
                    return {
                        mappings: mappings,
                        referenceEntityAttributes: referenceEntityAttributes,
                        selectedFamilyCode: appData.selectedFamilyCode || '',
                        availableFamilies: appData.availableFamilies || [],
                        targetTypes: appData.targetTypes,
                        valueModes: valueModes,
                        targetKeyMap: targetKeyMap,
                        computedTargetTypes: appData.computedTargetTypes || [],
                        availableSpecificationAttributes: appData.availableSpecificationAttributes || [],
                        availableProductAttributes: appData.availableProductAttributes || [],
                        availableFallbackSources: appData.availableFallbackSources || [],
                        expanded: {},
                        referenceExpanded: {},
                        toasts: [],
                        templateHelpVisible: false,
                        deleteConfirmation: {
                            visible: false,
                            mapping: null,
                            busy: false
                        }
                    };
                },
                computed: {
                    selectedFamilyLabel: function () {
                        if (!this.selectedFamilyCode)
                            return 'Global defaults';

