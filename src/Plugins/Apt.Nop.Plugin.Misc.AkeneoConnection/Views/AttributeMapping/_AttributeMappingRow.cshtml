<div class="akeneo-row-shell"
     v-bind:data-mapping-key="m.clientKey"
     v-bind:class="{
         'akeneo-reference-field-shell': m.isReferenceEntityAttribute,
         'akeneo-computed-mapping-shell': m.isComputed
     }"
     v-bind:style="rowStaggerStyle(entryIndex + itemIndex)">

    <div class="akeneo-row"
         v-bind:class="[
             statusFor(m).cls,
             { 'akeneo-reference-field-row': m.isReferenceEntityAttribute }
         ]">

        <div class="akeneo-col akeneo-col-attr">
            <template v-if="m.isComputed">
                <div class="akeneo-code">
                    {{ m.name || 'Computed mapping' }}
                </div>
                <div class="akeneo-label">Computed value template</div>
            </template>

            <template v-else-if="m.isReferenceEntityAttribute">
                <div class="akeneo-reference-field-name">
                    {{ referenceFieldText(m) }}
                </div>

                <div class="akeneo-code">
                    {{ activeReferenceFieldCode(m) || 'No field selected' }}
                </div>
            </template>

            <template v-else>
                <div class="akeneo-code">{{ m.code }}</div>
                <div class="akeneo-label">{{ m.label }}</div>
            </template>
        </div>

        <div class="akeneo-col akeneo-col-type">
            <template v-if="m.isComputed">
                <span class="akeneo-type-chip">
                    Template
                </span>
                <div class="akeneo-reference-field-entity">
                    Multiple Akeneo values
                </div>
            </template>

            <template v-else-if="m.isReferenceEntityAttribute">
                <span class="akeneo-type-chip">
                    Reference entity field
                </span>

                <div class="akeneo-reference-field-entity">
                    {{ m.referenceEntityCode }}
                </div>
            </template>

            <template v-else>
                <span class="akeneo-type-chip">{{ m.type }}</span>

                <div class="akeneo-flags"
                     aria-label="Attribute localization and scope">

                    <span class="akeneo-flag"
                          v-bind:class="{ on: m.isLocalizable }"
                          v-bind:aria-label="m.isLocalizable
                              ? 'Localizable'
                              : 'Non localizable'"
                          v-bind:data-ak-tooltip="m.isLocalizable
                              ? 'Localizable: Akeneo can store a different value per locale.'
                              : 'Non localizable: this attribute uses the same value for every locale.'"
                          tabindex="0">
                        L
                    </span>

                    <span class="akeneo-flag"
                          v-bind:class="{ on: m.isScopable }"
                          v-bind:aria-label="m.isScopable
                              ? 'Scopable'
                              : 'Non scopable'"
                          v-bind:data-ak-tooltip="m.isScopable
                              ? 'Scopable: Akeneo can store a different value per channel.'
                              : 'Non scopable: this attribute uses the same value for every channel.'"
                          tabindex="0">
                        S
                    </span>
                </div>
            </template>
        </div>

        <div class="akeneo-col akeneo-col-maps">
            <div>
                <span class="akeneo-summary-target-type">
                    {{ targetTypeText(m) }}
                </span>
            </div>

            <div class="akeneo-summary-target-detail akeneo-summary-target-key">
                {{ detail(m) }}
            </div>

            <div class="akeneo-summary-target-detail"
                 v-if="isSpecType(m.nopTargetTypeId)">
                Missing values: {{ specificationHandlingText(m) }}
            </div>

            <div class="akeneo-summary-target-detail"
                 v-if="templateSummary(m)">
                {{ templateSummary(m) }}
            </div>

            <div class="akeneo-summary-target-detail" v-if="m.isComputed && m.applyWhen">
                Apply only when: {{ m.applyWhen }}
            </div>

            <div class="akeneo-summary-target-detail"
                 v-if="fallbackSummary(m)">
                {{ fallbackSummary(m) }}
            </div>
        </div>

        <div class="akeneo-col akeneo-col-status">
            <span class="akeneo-status">
                {{ statusFor(m).text }}
            </span>

            <div class="mt-1">
                <span class="badge"
                      v-bind:class="scopeFor(m).badgeClass">
                    {{ scopeFor(m).text }}
                </span>
            </div>

            <div class="mt-1">
                <span class="badge badge-light"
                      v-bind:title="appliesToText(m)">
                    {{ appliesToText(m) }}
                </span>
            </div>
        </div>

        <div class="akeneo-col akeneo-col-actions">
            <small class="text-muted d-block" v-if="m.isMissingSource && m.isInherited">
                Select Global defaults to delete this inherited mapping.
            </small>
            <span class="akeneo-summary-required">
                <span class="badge"
                      v-bind:class="m.isRequired
                          ? 'badge-warning'
                          : 'badge-secondary'">
                    {{ m.isRequired ? 'Required' : 'Optional' }}
                </span>
            </span>

            <div class="akeneo-row-buttons mt-2">
                <button type="button"
                        class="btn btn-sm btn-primary akeneo-edit-row"
                        v-on:click="edit(m)"
                        v-show="!m.editing && !m.isMissingSource">

                    <i class="fas fa-pencil-alt"></i>

                    {{
                    selectedFamilyCode &&
                    (m.isInherited || Number(m.id) === 0)
                    ? 'Edit'
                    : Number(m.id) === 0
                    ? 'Create mapping'
                    : 'Edit'
                    }}
                </button>

                <button type="button"
                        class="btn btn-sm btn-danger"
                        v-if="canDeleteMapping(m)"
                        v-show="!m.editing"
                        v-on:click="requestDeleteMapping(m)"
                        v-bind:disabled="m.deleting">

                    <i class="fas"
                       v-bind:class="selectedFamilyCode
                           ? 'fa-undo'
                           : 'fa-trash'">
                    </i>

                    {{
                    m.deleting
                    ? 'Removing...'
                    : m.clientAdded
                    ? 'Remove'
                    : selectedFamilyCode
                    ? 'Remove override'
                    : 'Delete mapping'
                    }}
                </button>
            </div>
        </div>
    </div>

    <transition name="akeneo-detail-slide">
        <div v-if="m.editing"
             class="akeneo-mapping-detail"
             v-bind:class="{
                 'akeneo-reference-field-detail': m.isReferenceEntityAttribute
             }">

            <div class="form-row">
                <div class="form-group col-md-4"
                     v-if="m.isComputed">
                    <label class="font-weight-bold mb-1">
                        Mapping name
                    </label>
                    <input type="text"
                           class="form-control"
                           v-model.trim="m.draft.name"
                           maxlength="255"
                           placeholder="Variant generated name" />
                    <small class="form-text text-muted">
                        Administrative label used to identify this computed mapping.
                    </small>
                </div>

                <div class="form-group col-md-4"
                     v-if="m.isReferenceEntityAttribute">

                    <label class="font-weight-bold mb-1">
                        Reference Entity Field
                    </label>

                    <akeneo-search-select class="akeneo-edit-reference-entity-field" item-name="Reference entity field"
                            v-model="m.draft.referenceEntityAttributeCode"
                            v-bind:options="dropdownOptions(referenceFieldOptions(m))"></akeneo-search-select>

                    <small class="form-text text-muted">
                        Read this field from each linked
                        {{ m.referenceEntityCode }} record.
                    </small>
                </div>

                <div class="form-group col-md-4">
                    <label class="font-weight-bold mb-1">
                        Target Type
                    </label>

                    <akeneo-search-select class="akeneo-edit-target-type" item-name="Target type"
                            v-bind:model-value="targetSelection(m.draft)"
                            v-bind:options="dropdownOptions(m.availableTargetTypes)"
                            v-on:change="selectTarget(m, $event)"></akeneo-search-select>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isCustomHandlerType(m.draft.nopTargetTypeId)">
                    <span v-if="m.draft.nopTargetKey === 'tier-price-table'">
                        Maps min_qty and tier_price to the entire product tier-price table.
                        Replaces existing tier prices only when different. Prices apply to all customers and stores.
                    </span>
                    <span v-else-if="m.draft.nopTargetKey === 'hardiness-zone-range'">
                        Reads hardiness_zone_low and hardiness_zone_high from the linked record and assigns every
                        whole zone in between as an existing option of the specification attribute below
                        (an option named "Hardiness Zone 3" is zone 3). Options are never created; a missing zone is skipped with a warning.
                        Use "Record code" as the reference entity field.
                    </span>
                    <span v-else>The selected handler receives this attribute's value.</span>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isSpecHandler(m.draft)">

                    <label class="font-weight-bold mb-1">
                        Specification Attribute
                    </label>

                    <akeneo-search-select class="akeneo-edit-specification-attribute" item-name="Specification attribute"
                            v-model="m.draft.nopTargetEntityId"
                            v-bind:options="dropdownOptions(m.availableSpecificationAttributes)"></akeneo-search-select>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isKeyType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Target Key
                    </label>

                    <akeneo-search-select class="akeneo-edit-target-key" item-name="Target key"
                            v-model="m.draft.nopTargetKey"
                            v-bind:options="dropdownOptions(keyOptions(m.draft.nopTargetTypeId), 'None')"></akeneo-search-select>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isSpecType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Specification Attribute
                    </label>

                    <akeneo-search-select class="akeneo-edit-specification-attribute" item-name="Specification attribute"
                            v-model="m.draft.nopTargetEntityId"
                            v-bind:options="dropdownOptions(m.availableSpecificationAttributes)"></akeneo-search-select>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isSpecType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Missing Value Handling
                    </label>

                    <akeneo-search-select class="akeneo-edit-specification-missing-value-handling" item-name="Missing value handling"
                            v-model="m.draft.specificationMissingValueHandlingId"
                            v-bind:options="dropdownOptions(specificationMissingValueHandlingOptions)"></akeneo-search-select>

                    <small class="form-text text-muted">
                        Applied only when no matching nopCommerce specification
                        option exists. Existing options are always reused.
                    </small>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isProductType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Product Attribute
                    </label>

                    <akeneo-search-select class="akeneo-edit-product-attribute" item-name="Product attribute"
                            v-model="m.draft.nopTargetEntityId"
                            v-bind:options="dropdownOptions(m.availableProductAttributes)"></akeneo-search-select>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isTierPriceType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Customer Role
                    </label>

                    <akeneo-search-select class="akeneo-edit-tier-price-role" item-name="Customer role"
                            v-model="m.draft.nopTargetEntityId"
                            v-bind:options="dropdownOptions(availableCustomerRoles, 'Select a customer role')"></akeneo-search-select>
                </div>

                <div class="form-group col-md-4 akeneo-detail-block"
                     v-if="isTierPriceType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Minimum Quantity
                    </label>

                    <input type="number"
                           min="1"
                           step="1"
                           class="form-control akeneo-edit-tier-price-quantity"
                           v-model="m.draft.nopTargetKey"
                           placeholder="1" />

                    <small class="form-text text-muted">
                        Applies to orders of at least this many. 1 covers every purchase.
                        All stores, no start or end date.
                    </small>
                </div>

                <div class="form-group col-md-8 akeneo-detail-block akeneo-detail-none"
                     v-if="isIgnoreType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1"
                           aria-hidden="true">
                        &nbsp;
                    </label>

                    <span class="akeneo-none-hint">
                        <i class="fas fa-ban"></i>
                        This attribute is ignored. Nothing will be imported.
                    </span>
                </div>

                <div class="form-group col-md-8 akeneo-detail-block akeneo-detail-none"
                     v-else-if="isNoneType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1"
                           aria-hidden="true">
                        &nbsp;
                    </label>

                    <span class="akeneo-none-hint">
                        <i class="fas fa-info-circle"></i>
                        This type maps on its own. No additional target is required.
                    </span>
                </div>


                <div class="form-group col-md-12" v-if="m.isComputed && !isIgnoreType(m.draft.nopTargetTypeId)">
                    <label class="akeneo-switch"
                           v-bind:for="'computed-condition-enabled-' + m.clientKey">
                        <input type="checkbox"
                               v-bind:id="'computed-condition-enabled-' + m.clientKey"
                               v-model="m.draft.applyWhenEnabled"
                               v-bind:aria-controls="'computed-condition-panel-' + m.clientKey"
                               v-bind:aria-expanded="m.draft.applyWhenEnabled ? 'true' : 'false'" />
                        <span class="akeneo-switch-track" aria-hidden="true">
                            <span class="akeneo-switch-thumb"></span>
                        </span>
                        <span class="akeneo-switch-text">Apply only when</span>
                    </label>
                    <div class="mt-2" v-if="m.draft.applyWhenEnabled"
                         v-bind:id="'computed-condition-panel-' + m.clientKey">
                        <textarea class="form-control" v-bind:id="'computed-condition-' + m.clientKey"
                                  aria-label="Apply only when condition"
                                  v-model="m.draft.applyWhen" rows="2" maxlength="4000"
                                  placeholder="sync_status == published OR sync_status == unpublished"></textarea>
                        <small class="form-text text-muted">Blank applies normally. A false condition preserves the destination and skips the template, transformations, and required checks. Missing or unreadable condition values block the item. Use raw option codes with ==, !=, AND, OR, and parentheses.</small>
                    </div>
                </div>

                <div class="form-group col-md-12 akeneo-template-editor"
                     v-if="m.isComputed && !isIgnoreType(m.draft.nopTargetTypeId)">
                    <label class="font-weight-bold mb-1"
                           v-bind:for="'computed-template-' + m.clientKey">
                        Value template
                        <button type="button"
                                class="btn btn-link p-0 ml-1 akeneo-template-help-toggle"
                                aria-label="Value template help"
                                title="Value template help"
                                v-on:click="showTemplateHelp">
                            <i class="fas fa-question-circle"></i>
                        </button>
                    </label>

                    <textarea class="form-control akeneo-template-input"
                              v-bind:id="'computed-template-' + m.clientKey"
                              v-model="m.draft.valueTemplate"
                              rows="3"
                              maxlength="4000"
                              placeholder="{sku} - {root_type} {pack_size}"></textarea>

                    <div class="akeneo-template-token-toolbar mt-2">
                        <akeneo-search-select item-name="Template token"
                            v-model="m.draft.selectedTemplateToken"
                            v-bind:options="dropdownOptions(templateTokenOptions(), 'Select a token')"></akeneo-search-select>

                        <button type="button"
                                class="btn btn-sm btn-primary ml-2"
                                v-bind:disabled="!m.draft.selectedTemplateToken"
                                v-on:click="insertTemplateToken(m)">
                            <i class="fas fa-plus"></i>
                            Insert token
                        </button>
                    </div>
                </div>

                <div class="form-group col-md-12"
                     v-if="!m.isComputed && !isIgnoreType(m.draft.nopTargetTypeId) && !isCustomHandlerType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Value source priority
                    </label>

                    <div class="akeneo-fallback-primary mb-2">
                        <span class="badge badge-primary mr-2">Primary</span>
                        <strong>{{ m.code }}</strong>
                        <span v-if="m.isReferenceEntityAttribute">
                            .{{ m.draft.referenceEntityAttributeCode }}
                        </span>
                    </div>

                    <div class="akeneo-fallback-source-row mb-2"
                         v-for="(fallback, fallbackIndex) in m.draft.fallbackSources"
                         v-bind:key="m.clientKey + '-fallback-' + fallbackIndex">

                        <span class="badge badge-secondary mr-2">
                            Fallback {{ fallbackIndex + 1 }}
                        </span>

                        <akeneo-search-select class="akeneo-fallback-source-select" item-name="Fallback source"
                            v-model="fallback.sourceKey"
                            v-bind:options="dropdownOptions(fallbackOptions(m, fallbackIndex), 'Select an Akeneo attribute')"
                            v-on:change="onFallbackSourceChanged(fallback)"></akeneo-search-select>

                        <button type="button"
                                class="btn btn-sm btn-default ml-2"
                                title="Move fallback earlier"
                                v-bind:disabled="fallbackIndex === 0"
                                v-on:click="moveFallbackSource(m, fallbackIndex, -1)">
                            <i class="fas fa-arrow-up pr-0"></i>
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-default ml-1"
                                title="Move fallback later"
                                v-bind:disabled="fallbackIndex === m.draft.fallbackSources.length - 1"
                                v-on:click="moveFallbackSource(m, fallbackIndex, 1)">
                            <i class="fas fa-arrow-down pr-0"></i>
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-danger ml-1"
                                title="Remove fallback"
                                v-on:click="removeFallbackSource(m, fallbackIndex)">
                            <i class="fas fa-times pr-0"></i>
                        </button>
                    </div>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            v-on:click="addFallbackSource(m)">
                        <i class="fas fa-plus"></i>
                        Add fallback source
                    </button>

                    <small class="form-text text-muted">
                        The primary source is used when it has a non-empty value.
                        Fallback sources are tried from top to bottom. For example,
                        map variant_name to Product Name and add product_name as its
                        fallback for variant and standalone products.
                    </small>
                </div>

                <div class="form-group col-md-4"
                     v-if="!isIgnoreType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Require value during import
                    </label>

                    <div>
                        <label class="akeneo-switch">
                            <input type="checkbox"
                                   v-model="m.draft.isRequired" />

                            <span class="akeneo-switch-track">
                                <span class="akeneo-switch-thumb"></span>
                            </span>

                            <span class="akeneo-switch-text">
                                {{ m.draft.isRequired ? 'Required' : 'Optional' }}
                            </span>
                        </label>
                    </div>
                </div>

                <div class="form-group col-md-12"
                     v-if="!isIgnoreType(m.draft.nopTargetTypeId)">

                    <label class="font-weight-bold mb-1">
                        Apply mapping to
                    </label>

                    <div class="d-flex flex-wrap align-items-center akeneo-scope-switches">
                        <label class="akeneo-switch mr-4 mb-2">
                            <input type="checkbox"
                                   v-bind:id="'scope-product-model-' + m.clientKey"
                                   v-model="m.draft.applyToProductModels" />
                            <span class="akeneo-switch-track">
                                <span class="akeneo-switch-thumb"></span>
                            </span>
                            <span class="akeneo-switch-text">
                                Parent product models
                            </span>
                        </label>

                        <label class="akeneo-switch mr-4 mb-2">
                            <input type="checkbox"
                                   v-bind:id="'scope-variant-product-' + m.clientKey"
                                   v-model="m.draft.applyToVariantProducts" />
                            <span class="akeneo-switch-track">
                                <span class="akeneo-switch-thumb"></span>
                            </span>
                            <span class="akeneo-switch-text">
                                Variant products
                            </span>
                        </label>

                        <label class="akeneo-switch mr-4 mb-2">
                            <input type="checkbox"
                                   v-bind:id="'scope-standalone-product-' + m.clientKey"
                                   v-model="m.draft.applyToStandaloneProducts" />
                            <span class="akeneo-switch-track">
                                <span class="akeneo-switch-thumb"></span>
                            </span>
                            <span class="akeneo-switch-text">
                                Standalone products
                            </span>
                        </label>

                        <label class="akeneo-switch mr-4 mb-2"
                               title="Parents a family sub-model rule creates from a matched sub-model.">
                            <input type="checkbox"
                                   v-bind:id="'scope-sub-model-parent-' + m.clientKey"
                                   v-model="m.draft.applyToSubModelParents" />
                            <span class="akeneo-switch-track">
                                <span class="akeneo-switch-thumb"></span>
                            </span>
                            <span class="akeneo-switch-text">
                                Sub-model parents
                            </span>
                        </label>
                    </div>

                    <small class="form-text text-muted">
                        This controls which nopCommerce product records receive
                        the mapping. Inherited Akeneo values can still be used for
                        variant axes and associated-value naming without mapping
                        them onto the child product.
                    </small>
                </div>
            </div>

            <div class="alert alert-danger akeneo-row-errors"
                 v-if="m.errors.length"
                 role="alert">

                <i class="fas fa-exclamation-circle akeneo-row-errors-icon"
                   aria-hidden="true">
                </i>

                <div class="akeneo-row-errors-body">
                    <div class="akeneo-row-errors-title">
                        {{
                        m.errors.length > 1
                        ? 'Please fix these issues:'
                        : 'Please fix this issue:'
                        }}
                    </div>

                    <ul class="mb-0">
                        <li v-for="(err, errorIndex) in m.errors"
                            v-bind:key="errorIndex">
                            {{ err }}
                        </li>
                    </ul>
                </div>
            </div>

            <div>
                <button type="button"
                        class="btn btn-sm btn-primary akeneo-save-row"
                        v-on:click="save(m)"
                        v-bind:disabled="m.saving">

                    <i class="fas fa-save"></i>
                    Save
                </button>

                <button type="button"
                        class="btn btn-sm btn-default akeneo-cancel-row ml-1"
                        v-on:click="cancel(m)"
                        v-bind:disabled="m.saving">
                    Cancel
                </button>

                <span class="akeneo-row-saving ml-2"
                      v-show="m.saving">
                    Saving...
                </span>
            </div>
        </div>
    </transition>
</div>