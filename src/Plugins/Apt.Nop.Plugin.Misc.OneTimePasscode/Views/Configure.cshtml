@using Apt.Nop.Plugin.Misc.OneTimePasscode.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Nop.Web.Areas.Admin.Components
@model OneTimePasscodeModel
@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<form asp-controller="OneTimePasscode" asp-action="Configure" method="post" class="form-horizontal">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>@T("Plugins.Misc.OneTimePasscode.Instructions", "Configure Twilio credentials used to send one-time passcodes.")</p>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TwilioAccountSid" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TwilioAccountSid" />
                        <span asp-validation-for="TwilioAccountSid" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TwilioAuthToken" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TwilioAuthToken" type="password" />
                        <span asp-validation-for="TwilioAuthToken" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TwilioFromNumber" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TwilioFromNumber" />
                        <span asp-validation-for="TwilioFromNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>