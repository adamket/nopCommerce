@using Apt.Nop.Plugin.Misc.OneTimePasscode.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Nop.Web.Areas.Admin.Components
@model OtpConfigurationModel
@{
    Layout = "_AdminLayout";
    NopHtml.AddScriptParts(ResourceLocation.Footer, OtpConstants.PathToPlugin + "/Content/Libraries/coloris/coloris.js");
    NopHtml.AddCssFileParts(OtpConstants.PathToPlugin + "/Content/Libraries/coloris/coloris.css");
}


<form asp-controller="Configuration" asp-action="Configure" method="post" class="form-horizontal">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Otp plugin configuration
            <small>
                <i class="fas fa-arrow-circle-left"></i>

                @*  <a asp-action="List">@T("Admin.Catalog.Products.BackToList")</a> *@
            </small>
        </h1>
        <div class="float-right">

            <button type="submit" class="btn bg-primary">
                <i class="far fa-floppy-disk"></i>
                Save
            </button>

            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ProductDetailsButtons, additionalData = Model })
        </div>
    </div>

    @await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))


    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>@T("Plugins.Misc.OneTimePasscode.Instructions")</p>

                @* Twilio fields omitted *@

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="OtpValidationIntervalSeconds_OverrideForStore" asp-input="OtpValidationIntervalSeconds" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="OtpValidationIntervalSeconds" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="OtpValidationIntervalSeconds" />
                        <span asp-validation-for="OtpValidationIntervalSeconds" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="OtpRequestIntervalSeconds_OverrideForStore" asp-input="OtpRequestIntervalSeconds" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="OtpRequestIntervalSeconds" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="OtpRequestIntervalSeconds" />
                        <span asp-validation-for="OtpRequestIntervalSeconds" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="OtpExpiresAfterMinutes_OverrideForStore" asp-input="OtpExpiresAfterMinutes" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="OtpExpiresAfterMinutes" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="OtpExpiresAfterMinutes" />
                        <span asp-validation-for="OtpExpiresAfterMinutes" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="CodeDigitCount_OverrideForStore" asp-input="CodeDigitCount" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="CodeDigitCount" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="CodeDigitCount" asp-items="Model.AvailableCodeDigitCounts" />
                        <span asp-validation-for="CodeDigitCount" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="PreventUserEnumeration_OverrideForStore" asp-input="PreventUserEnumeration" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="PreventUserEnumeration" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="PreventUserEnumeration" />
                        <span asp-validation-for="PreventUserEnumeration" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ShowDefaultOtpLoginButton_OverrideForStore" asp-input="ShowDefaultOtpLoginButton" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ShowDefaultOtpLoginButton" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ShowDefaultOtpLoginButton" />
                        <span asp-validation-for="ShowDefaultOtpLoginButton" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="CssTypeId_OverrideForStore" asp-input="CssTypeId" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="CssTypeId" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="CssTypeId" asp-items="Model.AvailableCssTypes" />
                        <span asp-validation-for="CssTypeId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row mt-3 otp-ui-settings-row" data-otp-ui-settings-row>
                    <div class="col-md-3">
                        <div class="label-wrapper"><label class="col-form-label" for="">UI</label></div>

                    </div>
                    <div class="col-md-9">
                        <div class="otp-style-grid">
                            @foreach (var group in Model.ButtonStyleGroups)
                            {
                                <div class="otp-style-card">
                                    <div class="otp-style-card__header">
                                        <h4 class="otp-style-card__title">@T(group.TitleResourceKey)</h4>

                                        @*   @if (!string.IsNullOrWhiteSpace(group.DescriptionResourceKey))
                                {
                                    <p class="otp-style-card__subtitle">@T(group.DescriptionResourceKey)</p>
                                } *@
                                    </div>

                                    <div class="otp-style-card__body">
                                        @foreach (var field in group.Fields)
                                        {
                                            <div class="otp-color-setting">
                                                <div class="otp-color-setting__top">
                                                    <label class="otp-color-setting__label" for="@field.PropertyName">
                                                        @T(field.LabelResourceKey)
                                                    </label>

                                                    <nop-override-store-checkbox asp-input="@field.PropertyName"
                                                                                 asp-for="@field.OverridePropertyName"
                                                                                 asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                                </div>

                                                <div class="color-col">
                                                    <div class="otp-color-control">
                                                        <span class="otp-color-preview color-preview"
                                                              style="background:@field.Value"></span>

                                                        <input id="@field.PropertyName"
                                                               name="@field.PropertyName"
                                                               value="@field.Value"
                                                               class="form-control coloris"
                                                               data-coloris />
                                                    </div>

                                                    <span class="text-danger field-validation-valid"
                                                          data-valmsg-for="@field.PropertyName"
                                                          data-valmsg-replace="true"></span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Button styling configuration -->

            </div>
        </div>

    </div>
</form>

<script asp-location="Footer">
    document.addEventListener("DOMContentLoaded", function () {
        Coloris({
            alpha: false,
            el: '.coloris',
            theme: 'default',
            themeMode: 'light',
            format: 'hex',
            formatToggle: false,
            swatches: [
                '#0d6efd',
                '#6f42c1',
                '#d63384',
                '#dc3545',
                '#fd7e14',
                '#ffc107',
                '#198754',
                '#20c997',
                '#4ab2f1',
                '#6c757d',
                '#212529',
                '#ffffff'
            ],
            onChange: function (color, input) {
                updateColorPreview(input, color);
            }
        });


        bindUiOptionsToggle();

        const HEX_COLOR_REGEX = /^#([0-9a-fA-F]{6})$/;

        document.addEventListener('input', function (e) {
            if (!e.target.matches('.coloris')) {
                return;
            }

            const color = e.target.value;

            if (!HEX_COLOR_REGEX.test(color)) {
                return;
            }

            updateColorPreview(e.target, color);
        });

        document.addEventListener('click', function (e) {
            const preview = e.target.closest('.color-preview');

            if (!preview) {
                return;
            }

            const group = preview.closest('.otp-color-setting');
            const input = group?.querySelector('.coloris');

            if (!input) {
                return;
            }

            input.focus();
            input.click();
        });

        function updateColorPreview(input, color) {
            const preview = input.closest('.otp-color-setting')
                ?.querySelector('.color-preview');

            if (preview) {
                preview.style.background = color;
            }
        }

        function bindUiOptionsToggle(){
               const cssTypeInput = document.getElementById('CssTypeId');
                const uiSettingsRow = document.querySelector('[data-otp-ui-settings-row]');

                const CSS_TYPE_FROM_SETTINGS = '@((int)CssType.FromSettings)';

                  function toggleUiSettingsRow() {
        if (!cssTypeInput || !uiSettingsRow) return;

        const shouldShow = cssTypeInput.value === CSS_TYPE_FROM_SETTINGS;

        if (shouldShow) {
            uiSettingsRow.hidden = false;

            void uiSettingsRow.offsetHeight;

            uiSettingsRow.classList.add('is-animating');
            uiSettingsRow.classList.add('is-visible');
        } else {
            uiSettingsRow.classList.remove('is-animating');
            uiSettingsRow.classList.remove('is-visible');
            uiSettingsRow.hidden = true;
        }
    }

                // initial + change
                toggleUiSettingsRow();
                $('#CssTypeId').on('change', toggleUiSettingsRow);
       }

     });





</script>

<style>
    .color-col button {
        display: none;
    }

    .otp-style-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .otp-style-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .04);
        overflow: hidden;
    }

    .otp-style-card__header {
        padding: 14px 16px;
        border-bottom: 1px solid #edf0f2;
        background: #f8f9fa;
    }

    .otp-style-card__title {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        color: #343a40;
    }

    .otp-style-card__subtitle {
        margin: 3px 0 0;
        font-size: 12px;
        color: #6c757d;
    }

    .otp-style-card__body {
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .otp-color-setting {
        padding: 12px 12px;
        border-bottom: 1px solid #f0f1f2;
    }

        .otp-color-setting:first-child {
            padding-top: 0;
        }

        .otp-color-setting:last-child {
            padding-bottom: 0;
            border-bottom: 0;
        }

    .otp-color-setting__top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 7px;
    }

    .otp-color-setting__label {
        margin: 0;
        font-size: 13px;
        font-weight: 600;
        color: #495057;
    }

    .otp-color-control {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .otp-color-preview {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        border-radius: 7px;
        border: 1px solid #ced4da;
        cursor: pointer;
    }

    .otp-color-control .coloris {
        max-width: 180px;
        font-family: Consolas, Monaco, monospace;
    }

    .otp-ui-settings-row {
        opacity: 0;
        transform: translateY(10px);
    }

        .otp-ui-settings-row.is-animating {
            transition: opacity 180ms ease, transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
        }

        .otp-ui-settings-row.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .otp-ui-settings-row[hidden] {
            display: none !important;
        }

    @@media (max-width: 991px) {
        .otp-style-grid {
            grid-template-columns: 1fr;
        }
    }
</style>