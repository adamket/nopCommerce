<div class="mt-body-title">
    @T("apt.plugins.misc.otp.modal.email.prompt")
</div>

<div class="mt-body-container">
    <div class="otp-email-entry-row">
        <div class="otp-validation-wrap">
            <div class="otp-error-flag" otp-error-flag role="alert" aria-live="polite">
            </div>
            <input otp-email type="email" class="otp-email-field" data-enter-clicks="send-otp" id="otp-email" placeholder="example@@email.com" />

        </div>
        <button class="button-1" otp-send id="send-otp">@T("apt.plugins.misc.otp.modal.email.submit.text")</button>
    </div>
</div>
<div class="mt-body-footer">
    <button class="btn-muted" otp-send data-otp-bypass="true">@T("apt.plugins.misc.otp.modal.forego-code-generation.text")</button>
</div>