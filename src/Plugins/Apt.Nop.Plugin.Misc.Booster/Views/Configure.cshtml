@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Nop.Web.Areas.Admin.Components
@model Apt.Nop.Plugin.Misc.Booster.Models.ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<form asp-controller="Booster" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">

                <p class="alert alert-info">@T("Plugins.Misc.Booster.Instructions")</p>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="Enabled_OverrideForStore" asp-input="Enabled" asp-store-scope="@Model.ActiveStoreScopeConfiguration"/>
                        <nop-label asp-for="Enabled"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Enabled"/>
                        <span asp-validation-for="Enabled"></span>
                    </div>
                </div>


                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="CategoryPageCacheLengthMinutes_OverrideForStore" asp-input="CategoryPageCacheLengthMinutes" asp-store-scope="@Model.ActiveStoreScopeConfiguration"/>
                        <nop-label asp-for="CategoryPageCacheLengthMinutes"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="CategoryPageCacheLengthMinutes"/>
                        <span asp-validation-for="CategoryPageCacheLengthMinutes"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ProductDetailsPageCacheLengthMinutes_OverrideForStore" asp-input="ProductDetailsPageCacheLengthMinutes" asp-store-scope="@Model.ActiveStoreScopeConfiguration"/>
                        <nop-label asp-for="ProductDetailsPageCacheLengthMinutes"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ProductDetailsPageCacheLengthMinutes"/>
                        <span asp-validation-for="ProductDetailsPageCacheLengthMinutes"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ManufacturerPageCacheLengthMinutes_OverrideForStore" asp-input="ManufacturerPageCacheLengthMinutes" asp-store-scope="@Model.ActiveStoreScopeConfiguration"/>
                        <nop-label asp-for="ManufacturerPageCacheLengthMinutes"/>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ManufacturerPageCacheLengthMinutes"/>
                        <span asp-validation-for="ManufacturerPageCacheLengthMinutes"></span>
                    </div>
                </div>

                <!-- Customer roles multi-select (uses the site's standard ACL pattern) -->
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="PageModifyingCustomerRoleIds_OverrideForStore" asp-input="PageModifyingCustomerRoleIds" asp-store-scope="@Model.ActiveStoreScopeConfiguration"/>
                        <nop-label asp-for="PageModifyingCustomerRoleIds"/>
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="PageModifyingCustomerRoleIds" asp-items="Model.AvailableCustomerRoles" asp-multiple="true"/>
                        @*  <span class="form-text text-muted">Select one or more customer roles whose presence on a page should mark that page as modifying (affect cache).</span> *@


                        <script>
                            $(function () {
                                var rolesIdsInput = $('#@Html.IdFor(model => model.PageModifyingCustomerRoleIds)').select2({
                                    closeOnSelect: false,
                                    @if (!Model.AvailableCustomerRoles?.Any() ?? true)
                                    {
                                        <text>
                                            disabled: true,
                                            placeholder: '@T("Admin.Configuration.ACL.NoCustomerRolesAvailable")',
                                        </text>
                                    }
                                });
                            });
                        </script>
                    </div>
                </div>


                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>