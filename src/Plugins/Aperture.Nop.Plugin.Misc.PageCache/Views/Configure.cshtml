@model Aperture.Nop.Plugin.Misc.PageCache.PageCacheSettings

@using (Html.BeginForm("Configure", "PageCache", new { area = "Admin" }, FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group row">
        <label class="col-sm-3 col-form-label">Category page cache length (minutes)</label>
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.CategoryPageCacheLengthMinutes, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-3 col-form-label">Product details page cache length (minutes)</label>
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.ProductDetailsPageCacheLengthMinutes, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-9 offset-sm-3">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
}
