@using Apt.Nop.Plugin.Misc.TopicsPlus.Models
@using Nop.Web.Framework.Models.DataTables

@model TopicRevisionSearchModel

<style>
    .topic-revision-preview-button {
        transition: opacity 0.15s ease;
    }

        .topic-revision-preview-button.loading {
            opacity: 0.7;
        }
</style>

<form asp-controller="TopicRevision" asp-action="List" method="post">
    <input asp-for="SearchTopicId" type="hidden" />

    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.TopicsPlus.TopicRevision.List")
        </h1>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">
                            <divid="topic-revisions-grid"></divid>
                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                                Name = "topic-revisions-grid",
                                                        UrlRead = new DataUrl("List", "TopicRevision", null),
                                                        Length = Model.PageSize,
                                                        LengthMenu = Model.AvailablePageSizes,
                                                        Filters = new List<FilterParameter>
                                                        {
                                                        new FilterParameter(nameof(Model.SearchTopicId))
                                                        },
                                                        ColumnCollection = new List<ColumnProperty>
                                                        {
                                                        // new ColumnProperty(nameof(TopicRevisionModel.Id))
                                                        // {
                                                        // Title = T("Admin.Common.Id").Text,
                                                        // Width = "80"
                                                        // },
                                                        // new ColumnProperty(nameof(TopicRevisionModel.TopicId))
                                                        // {
                                                        // Title = T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.TopicId").Text,
                                                        // Width = "100"
                                                        // },
                                                        // new ColumnProperty(nameof(TopicRevisionModel.SystemName))
                                                        // {
                                                        // Title = T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.SystemName").Text
                                                        // },
                                                        new ColumnProperty(nameof(TopicRevisionModel.Title))
                                                        {
                                                        Title = "Title"//T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.Title").Text
                                                        },
                                                        // new ColumnProperty(nameof(TopicRevisionModel.Published))
                                                        // {
                                                        // Title =""// T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.Published").Text,
                                                        // Width = "100",
                                                        // ClassName = NopColumnClassDefaults.CenterAll,
                                                        // Render = new RenderBoolean()
                                                        // },
                                                        new ColumnProperty(nameof(TopicRevisionModel.CustomerName))
                                                        {
                                                            Title = "Updated by",//T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.CreatedOnUtc").Text,
                                                            Width = "200"
                                                        },
                                                        new ColumnProperty(nameof(TopicRevisionModel.IsRevert))
                                                        {
                                                        Title = "Is revert",//T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.IsRevert").Text,
                                                        Width = "50",
                                                        ClassName = NopColumnClassDefaults.CenterAll,
                                                        Render = new RenderBoolean()
                                                        },
                                                        new ColumnProperty(nameof(TopicRevisionModel.CreatedOn))
                                                        {
                                                        Title = "Created on",//T("Plugins.Misc.TopicsPlus.TopicRevision.Fields.CreatedOnUtc").Text,
                                                        Width = "100"
                                                        },
                                                        new ColumnProperty(nameof(TopicRevisionModel.Id))
                                                        {
                                                        Title = "",
                                                        Width = "75",
                                                        ClassName = NopColumnClassDefaults.Button,
                                                        Render = new RenderCustom("renderRevisionPreviewButton")
                                                        }
                                                        }
                                                        })
                        </div>
                        <script>
                               function renderRevisionPreviewButton(data, type, row, meta) {
                                return `
                                    <button type="button"
                                            class="btn btn-primary topic-revision-preview-button"
                                            onclick="openTopicRevisionPreview(${row.Id}, this)">
                                        View
                                    </button>
                                     <button type="button"
                                            class="btn btn-default topic-revision-revert-button"
                                            onclick="revertToTopicRevision(${row.Id}, this)">
                                        Revert
                                    </button>

                                    `;
                            }

                            let currentPreviewToken = 0;
                            let activePreviewButton = null;


                            function revertToTopicRevision(revisionId, button){

                            }


                            function openTopicRevisionPreview(revisionId, button) {
                                const iframe = document.getElementById('topic-revision-preview-frame');

                                const token = ++currentPreviewToken;

                                // reset previous button
                                if (activePreviewButton) {
                                    setButtonLoading(activePreviewButton, false);
                                }

                                activePreviewButton = button;
                                setButtonLoading(button, true);

                                iframe.onload = function () {
                                    if (token !== currentPreviewToken) {
                                        return; // stale load, ignore
                                    }

                                    setButtonLoading(activePreviewButton, false);
                                    activePreviewButton = null;

                                    $('#topic-revision-preview-modal').modal('show');
                                };

                                iframe.src = `/apt/topics-plus/preview/${revisionId}`;
                            }
                             function setButtonLoading(button, isLoading) {
                                if (!button) return;

                                if (isLoading) {
                                    if (button.dataset.loading === 'true') return;

                                    button.dataset.loading = 'true';
                                    button.dataset.originalHtml = button.innerHTML;

                                    const width = button.offsetWidth;
                                    button.style.width = width + 'px';

                                    button.disabled = true;
                                    button.classList.add('loading');

                                    button.innerHTML = `
                                        <span style="display:inline-flex;align-items:center;justify-content:center;width:100%;">
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        </span>
                                    `;
                                } else {
                                    if (button.dataset.loading !== 'true') return;

                                    button.innerHTML = button.dataset.originalHtml || 'Preview';
                                    button.style.width = '';
                                    button.disabled = false;
                                    button.classList.remove('loading');

                                    delete button.dataset.originalHtml;
                                    delete button.dataset.loading;
                                }
                            }
                         
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

<div class="modal fade" id="topic-revision-preview-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document" style="max-width: 1200px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Topic revision preview</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&#215;</span>
                </button>
            </div>

            <div class="modal-body p-0">
                <iframe id="topic-revision-preview-frame"
                        style="width: 100%; height: 75vh; border: 0;"></iframe>
            </div>
        </div>
    </div>
</div>